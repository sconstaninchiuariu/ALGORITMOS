// This Pine Script(tm) code is subject to the terms of the Mozilla Public License 2.0
// SMC EURUSD v3 | Sweep > 1M MSS > 3-candle FVG Entry
// HTF Bias: Daily / 4H / 1H FVG | Levels: PDH/PDL, PWH/PWL, Asia (HTF POIs only)
// Kill Zones: London 03:00-05:00 UTC | NY 08:00-10:30 UTC
// Risk: Tiered non-compounded (0.7% to 2.0%) | SL = sweep wick | TP = SL x RR

//@version=6
strategy(
    title             = "SMC EURUSD v3",
    shorttitle        = "SMC-v3",
    overlay           = true,
    default_qty_type  = strategy.fixed,
    default_qty_value = 1,
    initial_capital   = 100000,
    currency          = currency.USD,
    commission_type   = strategy.commission.cash_per_contract,
    commission_value  = 0.00005,
    slippage          = 2,
    pyramiding        = 0,
    max_bars_back     = 500)

// =============================================================
// INPUTS
// =============================================================

var string GKZ = "Kill Zones (UTC)"
kz_lon_open   = input.int(3,  "London Open (h)",  0, 23, group = GKZ)
kz_lon_close  = input.int(5,  "London Close (h)", 0, 23, group = GKZ)
kz_ny_open    = input.int(8,  "NY Open (h)",      0, 23, group = GKZ)
kz_ny_close_h = input.int(10, "NY Close (h)",     0, 23, group = GKZ)
kz_ny_close_m = input.int(30, "NY Close (min)",   0, 59, group = GKZ, tooltip = "30 = 10:30 UTC cutoff")

var string GLIQ = "Liquidity Levels (HTF POIs)"
use_pdhl  = input.bool(true,    "PDH / PDL (Previous Day)",  group = GLIQ)
use_pwhl  = input.bool(true,    "PWH / PWL (Previous Week)", group = GLIQ)
use_asia  = input.bool(true,    "Asia Range H/L",            group = GLIQ)
sw_len    = input.int(10,       "Swing Lookback (MSS ref)",  2, 50, group = GLIQ, tooltip = "Used only for MSS reference level, not as sweep trigger")
sweep_buf = input.float(0.0002, "Sweep Buffer",  0.00005, 0.001, 0.00001, group = GLIQ, tooltip = "Min wick distance beyond level to confirm sweep")

var string GMSS = "MSS Settings"
mss_max_bars = input.int(80, "Max Bars for MSS", 5, 300, group = GMSS, tooltip = "Reset if MSS not confirmed within N bars after sweep")

var string GFVG = "FVG / Imbalance"
fvg_min_gap   = input.float(0.0002, "Min FVG Gap",  0.00005, 0.002, 0.00001, group = GFVG)
fvg_max_bars  = input.int(60,       "FVG Max Age",  5, 300,          group = GFVG, tooltip = "Cancel setup if price misses FVG within N bars")
req_close_fvg = input.bool(true,    "Entry candle must CLOSE inside FVG", group = GFVG)

var string GHTF = "HTF Context Filter"
use_htf     = input.bool(true,    "Require HTF FVG alignment (1H / 4H / Daily)", group = GHTF)
htf_tf1     = input.timeframe("60",  "HTF 1 (1H)",    group = GHTF)
htf_tf2     = input.timeframe("240", "HTF 2 (4H)",    group = GHTF)
htf_tf3     = input.timeframe("D",   "HTF 3 (Daily)", group = GHTF)
htf_fvg_min = input.float(0.0003, "Min HTF FVG Size", 0.00010, 0.010, 0.00010, group = GHTF, tooltip = "3 pips min for 1H FVGs")

var string GRSK = "Risk Management"
rr_ratio    = input.float(2.0,    "RR Ratio",         1.0, 10.0, 0.1,    group = GRSK)
max_sl      = input.float(0.0050, "Max SL Distance",  0.0005, 0.0200, 0.0001, group = GRSK)
min_sl      = input.float(0.0003, "Min SL Distance",  0.0001, 0.0020, 0.0001, group = GRSK)
max_day_tr  = input.int(2,        "Max Trades / Day", 1, 5,              group = GRSK)
fixed_cap   = input.float(100000, "Fixed Capital (non-compounded)",       group = GRSK)

var string GTR = "Tiered Risk (% of Fixed Capital)"
r1 = input.float(0.7, "Attempt 1 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r2 = input.float(0.8, "Attempt 2 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r3 = input.float(1.2, "Attempt 3 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r4 = input.float(1.5, "Attempt 4 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r5 = input.float(1.8, "Attempt 5 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r6 = input.float(2.0, "Attempt 6 (%)", 0.1, 5.0, 0.1, group = GTR) / 100

var string GVIS = "Visuals"
show_levels  = input.bool(true,  "Show PDH/PDL, PWH/PWL, Asia Lines", group = GVIS)
show_sw_mark = input.bool(false, "Show Swing Pivot Markers",           group = GVIS)
show_mss_lbl = input.bool(false, "Show MSS Labels on Chart",          group = GVIS)
show_kz_bg   = input.bool(true,  "Show Kill Zone Background",          group = GVIS)
show_sweep   = input.bool(true,  "Show Sweep Markers",                 group = GVIS)

// =============================================================
// HTF BIAS  (no-repainting: lookahead_off + closed bars only)
// =============================================================

[h1_h2, h1_l2, h1_h0, h1_l0] = request.security(syminfo.tickerid, htf_tf1, [high[2], low[2], high[0], low[0]], lookahead = barmerge.lookahead_off)
[h2_h2, h2_l2, h2_h0, h2_l0] = request.security(syminfo.tickerid, htf_tf2, [high[2], low[2], high[0], low[0]], lookahead = barmerge.lookahead_off)
[h3_h2, h3_l2, h3_h0, h3_l0] = request.security(syminfo.tickerid, htf_tf3, [high[2], low[2], high[0], low[0]], lookahead = barmerge.lookahead_off)

htf_bear_1h    = h1_l2 > h1_h0 and (h1_l2 - h1_h0) >= htf_fvg_min
htf_bear_4h    = h2_l2 > h2_h0 and (h2_l2 - h2_h0) >= htf_fvg_min
htf_bear_d     = h3_l2 > h3_h0 and (h3_l2 - h3_h0) >= htf_fvg_min
htf_bear       = htf_bear_1h or htf_bear_4h or htf_bear_d

htf_bull_1h    = h1_h2 < h1_l0 and (h1_l0 - h1_h2) >= htf_fvg_min
htf_bull_4h    = h2_h2 < h2_l0 and (h2_l0 - h2_h2) >= htf_fvg_min
htf_bull_d     = h3_h2 < h3_l0 and (h3_l0 - h3_h2) >= htf_fvg_min
htf_bull       = htf_bull_1h or htf_bull_4h or htf_bull_d

// =============================================================
// SESSION / KILL ZONE
// =============================================================

h_utc = hour(time, "UTC")
m_utc = minute(time, "UTC")

ny_closed  = h_utc > kz_ny_close_h or (h_utc == kz_ny_close_h and m_utc >= kz_ny_close_m)
in_london  = h_utc >= kz_lon_open and h_utc < kz_lon_close
in_ny      = h_utc >= kz_ny_open and not ny_closed
in_kz      = in_london or in_ny

// =============================================================
// DAILY TRADE COUNTER
// =============================================================

var int trades_today = 0
var int last_day_id  = 0

day_id = year(time) * 10000 + month(time) * 100 + dayofmonth(time)
if day_id != last_day_id
    trades_today := 0
    last_day_id  := day_id

can_trade = trades_today < max_day_tr and strategy.position_size == 0

// =============================================================
// PREVIOUS DAY HIGH / LOW
// =============================================================

is_new_day = ta.change(time("D")) != 0

var float cur_dh = na
var float cur_dl = na
var float pdh    = na
var float pdl    = na

if is_new_day
    pdh    := cur_dh
    pdl    := cur_dl
    cur_dh := high
    cur_dl := low
else
    cur_dh := na(cur_dh) ? high : math.max(cur_dh, high)
    cur_dl := na(cur_dl) ? low  : math.min(cur_dl, low)

// =============================================================
// PREVIOUS WEEK HIGH / LOW
// =============================================================

is_new_week = ta.change(time("W")) != 0

var float cur_wh = na
var float cur_wl = na
var float pwh    = na
var float pwl    = na

if is_new_week
    pwh    := cur_wh
    pwl    := cur_wl
    cur_wh := high
    cur_wl := low
else
    cur_wh := na(cur_wh) ? high : math.max(cur_wh, high)
    cur_wl := na(cur_wl) ? low  : math.min(cur_wl, low)

// =============================================================
// ASIA RANGE  (22:00 - 07:00 UTC)
// =============================================================

in_asia = h_utc >= 22 or h_utc < 7

var float asia_live_h = na
var float asia_live_l = na
var float asia_h      = na
var float asia_l      = na

if in_asia
    asia_live_h := na(asia_live_h) ? high : math.max(asia_live_h, high)
    asia_live_l := na(asia_live_l) ? low  : math.min(asia_live_l, low)
else if in_asia[1]
    asia_h      := asia_live_h
    asia_l      := asia_live_l
    asia_live_h := na
    asia_live_l := na

// =============================================================
// SWING HIGHS / LOWS  (MSS reference only — not sweep triggers)
// =============================================================

raw_swh = ta.pivothigh(high, sw_len, sw_len)
raw_swl = ta.pivotlow(low,  sw_len, sw_len)

var float last_swh = na
var float last_swl = na

if not na(raw_swh)
    last_swh := raw_swh
if not na(raw_swl)
    last_swl := raw_swl

// =============================================================
// TIERED RISK ENGINE
// =============================================================

var int attempt = 1

f_risk(int a) =>
    a == 1 ? r1 : a == 2 ? r2 : a == 3 ? r3 : a == 4 ? r4 : a == 5 ? r5 : r6

was_in_trade = strategy.position_size[1] != 0 and strategy.position_size == 0
if was_in_trade
    n = strategy.closedtrades - 1
    if n >= 0
        last_profit = strategy.closedtrades.profit(n)
        attempt    := last_profit > 0 ? 1 : math.min(attempt + 1, 6)

f_qty(float sl_dist) =>
    sl_dist > 0.0 ? (fixed_cap * f_risk(attempt)) / sl_dist : 0.0

// =============================================================
// CANDLE BODY
// =============================================================

is_bull = close > open
is_bear = close < open
body_hi = math.max(open, close)
body_lo = math.min(open, close)

// =============================================================
// STATE MACHINE
// 0 = IDLE
// 1 = BEAR_SWEPT  (HTF POI high swept, waiting for bearish MSS)
// 2 = BULL_SWEPT  (HTF POI low swept, waiting for bullish MSS)
// 3 = BEAR_FVG    (MSS confirmed, FVG set, waiting for retest)
// 4 = BULL_FVG    (MSS confirmed, FVG set, waiting for retest)
// =============================================================

var int   state        = 0
var int   state_bar    = 0
var float sweep_hi     = na
var float sweep_lo     = na
var float mss_ref_bear = na
var float mss_ref_bull = na
var float fvg_top      = na
var float fvg_bot      = na
var int   fvg_bar      = 0
var bool  mss_bear_ok  = false
var bool  mss_bull_ok  = false
var float pre_swl      = na
var float pre_swh      = na

// FVG box objects — entry FVG + HTF FVGs per timeframe
var box fvg_entry_box = na
var box htf_b1h_box   = na
var box htf_u1h_box   = na
var box htf_b4h_box   = na
var box htf_u4h_box   = na
var box htf_bd_box    = na
var box htf_ud_box    = na

// Previous HTF FVG states for edge detection
var bool prev_bear_1h = false
var bool prev_bull_1h = false
var bool prev_bear_4h = false
var bool prev_bull_4h = false
var bool prev_bear_d  = false
var bool prev_bull_d  = false

if state == 0
    if not na(raw_swl)
        pre_swl := raw_swl
    if not na(raw_swh)
        pre_swh := raw_swh

// Sweep functions
f_high_sweep(float lvl) =>
    not na(lvl) and high > (lvl + sweep_buf) and body_hi < lvl and is_bear

f_low_sweep(float lvl) =>
    not na(lvl) and low < (lvl - sweep_buf) and body_lo > lvl and is_bull

// HTF POI sweep events only (PDH/PDL, PWH/PWL, Asia)
// Swing highs/lows are NOT used as sweep triggers to avoid lower-TF noise
hs_pdh  = use_pdhl and f_high_sweep(pdh)
hs_pwh  = use_pwhl and f_high_sweep(pwh)
hs_asia = use_asia and f_high_sweep(asia_h)

ls_pdl  = use_pdhl and f_low_sweep(pdl)
ls_pwl  = use_pwhl and f_low_sweep(pwl)
ls_asia = use_asia and f_low_sweep(asia_l)

htf_ok_bear = not use_htf or htf_bear
htf_ok_bull = not use_htf or htf_bull

// Sweeps require HTF POI manipulation
any_hs = (hs_pdh or hs_pwh or hs_asia) and htf_ok_bear and can_trade
any_ls = (ls_pdl or ls_pwl or ls_asia)  and htf_ok_bull and can_trade

// IDLE -> SWEPT
if state == 0 and any_hs
    state        := 1
    sweep_hi     := high
    mss_ref_bear := na(pre_swl) ? low : pre_swl
    state_bar    := bar_index

if state == 0 and any_ls
    state        := 2
    sweep_lo     := low
    mss_ref_bull := na(pre_swh) ? high : pre_swh
    state_bar    := bar_index

// Timeout waiting for MSS
if (state == 1 or state == 2) and (bar_index - state_bar) > mss_max_bars
    state := 0

// MSS detection
bear_mss = state == 1 and not na(mss_ref_bear) and body_lo < mss_ref_bear and is_bear
bull_mss = state == 2 and not na(mss_ref_bull) and body_hi > mss_ref_bull and is_bull

if bear_mss
    mss_bear_ok := true
    state       := 3
    state_bar   := bar_index

if bull_mss
    mss_bull_ok := true
    state       := 4
    state_bar   := bar_index

// FVG detection (bar N+1 after MSS on bar N)
// Bear FVG: low[2] (pre-MSS bar) > high[0] (post-MSS bar) = gap above
// Bull FVG: high[2] (pre-MSS bar) < low[0] (post-MSS bar) = gap below
if mss_bear_ok[1]
    bear_gap = low[2] - high
    if bear_gap >= fvg_min_gap
        fvg_top := low[2]
        fvg_bot := high
        fvg_bar := bar_index
        box.delete(fvg_entry_box)
        fvg_entry_box := box.new(bar_index - 2, fvg_top, bar_index + 1, fvg_bot,
             border_color = color.new(color.red, 10),
             bgcolor      = color.new(color.red, 80),
             text         = "FVG",
             text_color   = color.new(color.red, 20),
             text_size    = size.tiny,
             text_halign  = text.align_left,
             text_valign  = text.align_top)
    else
        state := 0
    mss_bear_ok := false

if mss_bull_ok[1]
    bull_gap = low - high[2]
    if bull_gap >= fvg_min_gap
        fvg_top := low
        fvg_bot := high[2]
        fvg_bar := bar_index
        box.delete(fvg_entry_box)
        fvg_entry_box := box.new(bar_index - 2, fvg_top, bar_index + 1, fvg_bot,
             border_color = color.new(color.teal, 10),
             bgcolor      = color.new(color.teal, 80),
             text         = "FVG",
             text_color   = color.new(color.teal, 20),
             text_size    = size.tiny,
             text_halign  = text.align_left,
             text_valign  = text.align_top)
    else
        state := 0
    mss_bull_ok := false

// Extend entry FVG box right edge while waiting for retest
if (state == 3 or state == 4) and not na(fvg_entry_box)
    box.set_right(fvg_entry_box, bar_index + 5)

// FVG age timeout — seal box as expired (gray)
if (state == 3 or state == 4) and (bar_index - fvg_bar) > fvg_max_bars
    if not na(fvg_entry_box)
        box.set_right(fvg_entry_box, bar_index)
        box.set_bgcolor(fvg_entry_box, color.new(color.gray, 90))
        box.set_border_color(fvg_entry_box, color.new(color.gray, 60))
        box.set_text_color(fvg_entry_box, color.new(color.gray, 60))
    state := 0

// =============================================================
// ENTRY CONDITIONS
// =============================================================

in_bear_fvg = state == 3 and not na(fvg_top) and not na(fvg_bot)
in_bull_fvg = state == 4 and not na(fvg_top) and not na(fvg_bot)

touched_bear = in_bear_fvg and high >= fvg_bot and low <= fvg_top
touched_bull = in_bull_fvg and low  <= fvg_top and high >= fvg_bot

close_ok_bear = req_close_fvg ? (close >= fvg_bot and close <= fvg_top and is_bear) : is_bear
close_ok_bull = req_close_fvg ? (close >= fvg_bot and close <= fvg_top and is_bull) : is_bull

short_signal = touched_bear and close_ok_bear and in_kz and can_trade
long_signal  = touched_bull and close_ok_bull  and in_kz and can_trade

// =============================================================
// ORDER EXECUTION
// =============================================================

if short_signal
    sl_price = sweep_hi + sweep_buf
    tp_price = close - (sl_price - close) * rr_ratio
    sl_dist  = sl_price - close
    if sl_dist >= min_sl and sl_dist <= max_sl
        qty = f_qty(sl_dist)
        if qty > 0
            strategy.entry("Short", strategy.short, qty = qty, comment = "SMC Short")
            strategy.exit("SX", from_entry = "Short", stop = sl_price, limit = tp_price)
            trades_today += 1
            state := 0
            if not na(fvg_entry_box)
                box.set_right(fvg_entry_box, bar_index)

if long_signal
    sl_price = sweep_lo - sweep_buf
    tp_price = close + (close - sl_price) * rr_ratio
    sl_dist  = close - sl_price
    if sl_dist >= min_sl and sl_dist <= max_sl
        qty = f_qty(sl_dist)
        if qty > 0
            strategy.entry("Long", strategy.long, qty = qty, comment = "SMC Long")
            strategy.exit("LX", from_entry = "Long", stop = sl_price, limit = tp_price)
            trades_today += 1
            state := 0
            if not na(fvg_entry_box)
                box.set_right(fvg_entry_box, bar_index)

// =============================================================
// VISUALS
// =============================================================

bgcolor(show_kz_bg and in_london ? color.new(color.blue,   95) : na, title = "London KZ")
bgcolor(show_kz_bg and in_ny     ? color.new(color.yellow, 95) : na, title = "NY KZ")

// HTF POI level lines — flat horizontal lines, redrawn each new period
// Uses line.new() + extend.right so no historical staircase, just one clean line per day/week/session
var line l_pdh    = na
var line l_pdl    = na
var line l_pwh    = na
var line l_pwl    = na
var line l_asia_h = na
var line l_asia_l = na

if show_levels and use_pdhl and is_new_day
    line.delete(l_pdh)
    line.delete(l_pdl)
    if not na(pdh)
        l_pdh := line.new(bar_index, pdh, bar_index + 1, pdh, extend = extend.right, color = color.new(color.red,    30), style = line.style_dashed, width = 1)
    if not na(pdl)
        l_pdl := line.new(bar_index, pdl, bar_index + 1, pdl, extend = extend.right, color = color.new(color.teal,   30), style = line.style_dashed, width = 1)

if show_levels and use_pwhl and is_new_week
    line.delete(l_pwh)
    line.delete(l_pwl)
    if not na(pwh)
        l_pwh := line.new(bar_index, pwh, bar_index + 1, pwh, extend = extend.right, color = color.new(color.maroon, 40), style = line.style_solid,  width = 1)
    if not na(pwl)
        l_pwl := line.new(bar_index, pwl, bar_index + 1, pwl, extend = extend.right, color = color.new(color.navy,   40), style = line.style_solid,  width = 1)

asia_closed = not in_asia and in_asia[1]
if show_levels and use_asia and asia_closed
    line.delete(l_asia_h)
    line.delete(l_asia_l)
    if not na(asia_h)
        l_asia_h := line.new(bar_index, asia_h, bar_index + 1, asia_h, extend = extend.right, color = color.new(color.purple, 30), style = line.style_dotted, width = 1)
    if not na(asia_l)
        l_asia_l := line.new(bar_index, asia_l, bar_index + 1, asia_l, extend = extend.right, color = color.new(color.purple, 30), style = line.style_dotted, width = 1)

// Swing pivot markers (off by default)
plotshape(show_sw_mark and not na(raw_swh), title = "Swing H", style = shape.triangledown, location = location.abovebar, color = color.new(color.red,  60), size = size.tiny)
plotshape(show_sw_mark and not na(raw_swl), title = "Swing L", style = shape.triangleup,   location = location.belowbar, color = color.new(color.teal, 60), size = size.tiny)

// Sweep markers on HTF POI sweeps
plotshape(show_sweep and any_hs, title = "Sweep HIGH", style = shape.circle, location = location.abovebar, color = color.new(color.red,  0), size = size.tiny)
plotshape(show_sweep and any_ls, title = "Sweep LOW",  style = shape.circle, location = location.belowbar, color = color.new(color.teal, 0), size = size.tiny)

// MSS labels (off by default to keep chart clean)
if show_mss_lbl and bear_mss
    label.new(bar_index, low - syminfo.mintick * 20, "MSS DN", style = label.style_label_up,   color = color.red,  textcolor = color.white, size = size.small)
if show_mss_lbl and bull_mss
    label.new(bar_index, high + syminfo.mintick * 20, "MSS UP", style = label.style_label_down, color = color.teal, textcolor = color.white, size = size.small)

// HTF FVG boxes — detect new/gone edges and draw/invalidate boxes per timeframe
// Bear FVG: gap = low[2] > high[0] on that TF  →  top = l2, bot = h0
// Bull FVG: gap = high[2] < low[0] on that TF  →  top = l0, bot = h2

new_bear_1h  = htf_bear_1h  and not prev_bear_1h
gone_bear_1h = not htf_bear_1h and prev_bear_1h
new_bull_1h  = htf_bull_1h  and not prev_bull_1h
gone_bull_1h = not htf_bull_1h and prev_bull_1h

new_bear_4h  = htf_bear_4h  and not prev_bear_4h
gone_bear_4h = not htf_bear_4h and prev_bear_4h
new_bull_4h  = htf_bull_4h  and not prev_bull_4h
gone_bull_4h = not htf_bull_4h and prev_bull_4h

new_bear_d   = htf_bear_d   and not prev_bear_d
gone_bear_d  = not htf_bear_d  and prev_bear_d
new_bull_d   = htf_bull_d   and not prev_bull_d
gone_bull_d  = not htf_bull_d  and prev_bull_d

prev_bear_1h := htf_bear_1h
prev_bull_1h := htf_bull_1h
prev_bear_4h := htf_bear_4h
prev_bull_4h := htf_bull_4h
prev_bear_d  := htf_bear_d
prev_bull_d  := htf_bull_d

if show_levels
    // 1H FVGs
    if new_bear_1h
        box.delete(htf_b1h_box)
        htf_b1h_box := box.new(bar_index, h1_l2, bar_index + 1, h1_h0, border_color = color.new(color.red, 30), bgcolor = color.new(color.red, 87), text = "1H", text_color = color.new(color.red, 20), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top)
    if gone_bear_1h and not na(htf_b1h_box)
        box.set_right(htf_b1h_box, bar_index)
        box.set_bgcolor(htf_b1h_box, color.new(color.gray, 92))
        box.set_border_color(htf_b1h_box, color.new(color.gray, 70))
        box.set_text_color(htf_b1h_box, color.new(color.gray, 60))
    if htf_bear_1h and not na(htf_b1h_box)
        box.set_right(htf_b1h_box, bar_index + 5)

    if new_bull_1h
        box.delete(htf_u1h_box)
        htf_u1h_box := box.new(bar_index, h1_l0, bar_index + 1, h1_h2, border_color = color.new(color.teal, 30), bgcolor = color.new(color.teal, 87), text = "1H", text_color = color.new(color.teal, 20), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_bottom)
    if gone_bull_1h and not na(htf_u1h_box)
        box.set_right(htf_u1h_box, bar_index)
        box.set_bgcolor(htf_u1h_box, color.new(color.gray, 92))
        box.set_border_color(htf_u1h_box, color.new(color.gray, 70))
        box.set_text_color(htf_u1h_box, color.new(color.gray, 60))
    if htf_bull_1h and not na(htf_u1h_box)
        box.set_right(htf_u1h_box, bar_index + 5)

    // 4H FVGs
    if new_bear_4h
        box.delete(htf_b4h_box)
        htf_b4h_box := box.new(bar_index, h2_l2, bar_index + 1, h2_h0, border_color = color.new(color.red, 20), bgcolor = color.new(color.red, 84), text = "4H", text_color = color.new(color.red, 10), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top)
    if gone_bear_4h and not na(htf_b4h_box)
        box.set_right(htf_b4h_box, bar_index)
        box.set_bgcolor(htf_b4h_box, color.new(color.gray, 92))
        box.set_border_color(htf_b4h_box, color.new(color.gray, 70))
        box.set_text_color(htf_b4h_box, color.new(color.gray, 60))
    if htf_bear_4h and not na(htf_b4h_box)
        box.set_right(htf_b4h_box, bar_index + 5)

    if new_bull_4h
        box.delete(htf_u4h_box)
        htf_u4h_box := box.new(bar_index, h2_l0, bar_index + 1, h2_h2, border_color = color.new(color.teal, 20), bgcolor = color.new(color.teal, 84), text = "4H", text_color = color.new(color.teal, 10), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_bottom)
    if gone_bull_4h and not na(htf_u4h_box)
        box.set_right(htf_u4h_box, bar_index)
        box.set_bgcolor(htf_u4h_box, color.new(color.gray, 92))
        box.set_border_color(htf_u4h_box, color.new(color.gray, 70))
        box.set_text_color(htf_u4h_box, color.new(color.gray, 60))
    if htf_bull_4h and not na(htf_u4h_box)
        box.set_right(htf_u4h_box, bar_index + 5)

    // Daily FVGs
    if new_bear_d
        box.delete(htf_bd_box)
        htf_bd_box := box.new(bar_index, h3_l2, bar_index + 1, h3_h0, border_color = color.new(color.red, 10), bgcolor = color.new(color.red, 80), text = "D", text_color = color.new(color.red, 0), text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)
    if gone_bear_d and not na(htf_bd_box)
        box.set_right(htf_bd_box, bar_index)
        box.set_bgcolor(htf_bd_box, color.new(color.gray, 92))
        box.set_border_color(htf_bd_box, color.new(color.gray, 70))
        box.set_text_color(htf_bd_box, color.new(color.gray, 60))
    if htf_bear_d and not na(htf_bd_box)
        box.set_right(htf_bd_box, bar_index + 5)

    if new_bull_d
        box.delete(htf_ud_box)
        htf_ud_box := box.new(bar_index, h3_l0, bar_index + 1, h3_h2, border_color = color.new(color.teal, 10), bgcolor = color.new(color.teal, 80), text = "D", text_color = color.new(color.teal, 0), text_size = size.small, text_halign = text.align_right, text_valign = text.align_bottom)
    if gone_bull_d and not na(htf_ud_box)
        box.set_right(htf_ud_box, bar_index)
        box.set_bgcolor(htf_ud_box, color.new(color.gray, 92))
        box.set_border_color(htf_ud_box, color.new(color.gray, 70))
        box.set_text_color(htf_ud_box, color.new(color.gray, 60))
    if htf_bull_d and not na(htf_ud_box)
        box.set_right(htf_ud_box, bar_index + 5)

// Entry signals
plotshape(short_signal, title = "Short Entry", style = shape.labeldown, location = location.abovebar, color = color.red,  textcolor = color.white, text = "SHORT", size = size.small)
plotshape(long_signal,  title = "Long Entry",  style = shape.labelup,   location = location.belowbar, color = color.teal, textcolor = color.white, text = "LONG",  size = size.small)

// =============================================================
// INFO TABLE  (barstate.islast only)
// =============================================================

var table tbl = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 75), border_width = 1, border_color = color.gray)

if barstate.islast
    table.cell(tbl, 0, 0, "SMC v3 EURUSD", text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.small)
    table.cell(tbl, 1, 0, "",               text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.small)

    st_str = switch state
        0 => "IDLE"
        1 => "SWEPT DN"
        2 => "SWEPT UP"
        3 => "FVG SHORT"
        => "FVG LONG"

    st_col = switch
        state == 0               => color.gray
        state == 1 or state == 2 => color.orange
        state == 3               => color.red
        =>                          color.teal

    table.cell(tbl, 0, 1, "State",   text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 1, st_str,    text_color = st_col,     text_size = size.tiny)

    rsk_pct  = str.tostring(f_risk(attempt) * 100, "#.##")
    rsk_str  = str.tostring(attempt) + "/6 (" + rsk_pct + "%)"
    rsk_col  = switch
        attempt == 1 => color.lime
        attempt <= 3 => color.yellow
        =>              color.red

    table.cell(tbl, 0, 2, "Attempt", text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 2, rsk_str,   text_color = rsk_col,    text_size = size.tiny)

    td_str = str.tostring(trades_today) + "/" + str.tostring(max_day_tr)
    td_col = trades_today >= max_day_tr ? color.red : color.lime
    table.cell(tbl, 0, 3, "Trades Today", text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 3, td_str,         text_color = td_col,     text_size = size.tiny)

    kz_str = switch
        in_london => "London"
        in_ny     => "New York"
        =>            "OFF"
    kz_col = in_kz ? color.lime : color.red
    table.cell(tbl, 0, 4, "Kill Zone", text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 4, kz_str,      text_color = kz_col,     text_size = size.tiny)

    bias_str = switch
        htf_bear and not htf_bull => "BEAR"
        htf_bull and not htf_bear => "BULL"
        =>                           "NEUTRAL"
    bias_col = switch
        htf_bear and not htf_bull => color.red
        htf_bull and not htf_bear => color.teal
        =>                           color.gray
    table.cell(tbl, 0, 5, "HTF Bias", text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 5, bias_str,   text_color = bias_col,   text_size = size.tiny)

    pdhl_val = not na(pdh) ? str.tostring(pdh, "#.#####") + " / " + str.tostring(pdl, "#.#####") : "--"
    table.cell(tbl, 0, 6, "PDH/PDL", text_color = color.gray,   text_size = size.tiny)
    table.cell(tbl, 1, 6, pdhl_val,  text_color = color.orange,  text_size = size.tiny)

    pwhl_val = not na(pwh) ? str.tostring(pwh, "#.#####") + " / " + str.tostring(pwl, "#.#####") : "--"
    table.cell(tbl, 0, 7, "PWH/PWL", text_color = color.gray,   text_size = size.tiny)
    table.cell(tbl, 1, 7, pwhl_val,  text_color = color.maroon,  text_size = size.tiny)

    fvg_active = (state == 3 or state == 4) and not na(fvg_top)
    fvg_val    = fvg_active ? str.tostring(fvg_top, "#.#####") + " / " + str.tostring(fvg_bot, "#.#####") : "--"
    table.cell(tbl, 0, 8, "FVG Zone", text_color = color.gray,   text_size = size.tiny)
    table.cell(tbl, 1, 8, fvg_val,    text_color = color.yellow,  text_size = size.tiny)

// =============================================================
// ALERTS
// =============================================================

alertcondition(any_hs,       title = "Sweep HIGH",         message = "Liquidity sweep HIGH - watch for bearish MSS")
alertcondition(any_ls,       title = "Sweep LOW",          message = "Liquidity sweep LOW - watch for bullish MSS")
alertcondition(bear_mss,     title = "MSS Bear Confirmed", message = "Bearish MSS confirmed - FVG search active")
alertcondition(bull_mss,     title = "MSS Bull Confirmed", message = "Bullish MSS confirmed - FVG search active")
alertcondition(short_signal, title = "SHORT Entry",        message = "SMC SHORT | FVG retest + bearish close | Entry: {{close}}")
alertcondition(long_signal,  title = "LONG Entry",         message = "SMC LONG | FVG retest + bullish close | Entry: {{close}}")
