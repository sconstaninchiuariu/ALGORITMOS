// This Pine Script(tm) code is subject to the terms of the Mozilla Public License 2.0
// SMC EURUSD v4 | Sweep HTF POI > 1M MSS > FVG + Engulfing Entry
// HTF Bias: Daily/4H/1H FVG | POIs: PDH/PDL, PWH/PWL, Asia, EQH/EQL
// Kill Zones: London 03:00-05:00 UTC | NY 08:00-10:30 UTC
// Risk: Tiered non-compounded 0.7%-2.0% | SL=sweep wick | TP=SLxRR

//@version=6
strategy(
    title             = "SMC EURUSD v4",
    shorttitle        = "SMC-v4",
    overlay           = true,
    default_qty_type  = strategy.fixed,
    default_qty_value = 1,
    initial_capital   = 100000,
    currency          = currency.USD,
    commission_type   = strategy.commission.cash_per_contract,
    commission_value  = 0.00005,
    slippage          = 2,
    pyramiding        = 0,
    max_bars_back     = 500)

// =============================================================
// INPUTS
// =============================================================

var string GKZ = "Kill Zones (UTC)"
kz_lon_open   = input.int(3,  "London Open (h)",  0, 23, group = GKZ)
kz_lon_close  = input.int(5,  "London Close (h)", 0, 23, group = GKZ)
kz_ny_open    = input.int(8,  "NY Open (h)",      0, 23, group = GKZ)
kz_ny_close_h = input.int(10, "NY Close (h)",     0, 23, group = GKZ)
kz_ny_close_m = input.int(30, "NY Close (min)",   0, 59, group = GKZ)

var string GLIQ = "Liquidity Levels (HTF POIs)"
use_pdhl  = input.bool(true,    "PDH / PDL (Previous Day)",  group = GLIQ)
use_pwhl  = input.bool(true,    "PWH / PWL (Previous Week)", group = GLIQ)
use_asia  = input.bool(true,    "Asia Range H/L",            group = GLIQ)
sw_len    = input.int(10,       "Swing Lookback (MSS ref)",  2, 50, group = GLIQ)
sweep_buf = input.float(0.0002, "Sweep Buffer", 0.00005, 0.001, 0.00001, group = GLIQ)

var string GMSS = "MSS Settings"
mss_max_bars = input.int(80, "Max Bars for MSS", 5, 300, group = GMSS)

var string GFVG = "FVG / Imbalance"
fvg_min_gap   = input.float(0.0002, "Min FVG Gap",  0.00005, 0.002, 0.00001, group = GFVG)
fvg_max_bars  = input.int(60,       "FVG Max Age",  5, 300,          group = GFVG)
req_close_fvg = input.bool(true,    "Entry candle must CLOSE inside FVG", group = GFVG)
req_engulf    = input.bool(true,    "Entry candle must be ENGULFING (body covers prev body)", group = GFVG)

var string GHTF = "HTF Context Filter"
use_htf     = input.bool(true,   "Require HTF FVG alignment (1H/4H/Daily)", group = GHTF)
htf_tf1     = input.timeframe("60",  "HTF 1 (1H)",    group = GHTF)
htf_tf2     = input.timeframe("240", "HTF 2 (4H)",    group = GHTF)
htf_tf3     = input.timeframe("D",   "HTF 3 (Daily)", group = GHTF)
htf_fvg_min = input.float(0.0003, "Min HTF FVG Size", 0.00010, 0.010, 0.00010, group = GHTF)

var string GRSK = "Risk Management"
rr_ratio   = input.float(2.0,    "RR Ratio",         1.0, 10.0, 0.1,    group = GRSK)
max_sl     = input.float(0.0050, "Max SL Distance",  0.0005, 0.0200, 0.0001, group = GRSK)
min_sl     = input.float(0.0003, "Min SL Distance",  0.0001, 0.0020, 0.0001, group = GRSK)
max_day_tr = input.int(2,        "Max Trades / Day", 1, 5,              group = GRSK)
fixed_cap  = input.float(100000, "Fixed Capital (non-compounded)",       group = GRSK)

var string GTR = "Tiered Risk (% of Fixed Capital)"
r1 = input.float(0.7, "Attempt 1 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r2 = input.float(0.8, "Attempt 2 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r3 = input.float(1.2, "Attempt 3 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r4 = input.float(1.5, "Attempt 4 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r5 = input.float(1.8, "Attempt 5 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r6 = input.float(2.0, "Attempt 6 (%)", 0.1, 5.0, 0.1, group = GTR) / 100

var string GEQL = "Equal Highs / Lows (Liquidity Pools)"
use_eql      = input.bool(true,    "Detect and show EQH / EQL",        group = GEQL)
eql_tol      = input.float(0.0003, "Tolerance (price)",  0.00005, 0.002, 0.00001, group = GEQL)
eql_lookback = input.int(5,        "History depth (# pivots)", 2, 20,   group = GEQL)

var string GVIS = "Visuals"
show_levels  = input.bool(true,    "Show POI Lines (PDH/PDL, PWH/PWL, Asia, EQH/EQL)", group = GVIS)
show_kz_bg   = input.bool(true,    "Show Kill Zone Background",                         group = GVIS)
show_sweep   = input.bool(true,    "Show Sweep Markers",                                group = GVIS)
max_poi_dist = input.float(0.0150, "Max POI Distance (hide far zones)",  0.0020, 0.1000, 0.0010, group = GVIS)
show_fvg_vis = input.bool(true,    "Show FVG Imbalance Boxes (all unmitigated)",              group = GVIS)

// =============================================================
// HTF BIAS  (no-repainting)
// =============================================================

[h1_h2, h1_l2, h1_h0, h1_l0] = request.security(syminfo.tickerid, htf_tf1, [high[2], low[2], high[0], low[0]], lookahead = barmerge.lookahead_off)
[h2_h2, h2_l2, h2_h0, h2_l0] = request.security(syminfo.tickerid, htf_tf2, [high[2], low[2], high[0], low[0]], lookahead = barmerge.lookahead_off)
[h3_h2, h3_l2, h3_h0, h3_l0] = request.security(syminfo.tickerid, htf_tf3, [high[2], low[2], high[0], low[0]], lookahead = barmerge.lookahead_off)

htf_bear_1h = h1_l2 > h1_h0 and (h1_l2 - h1_h0) >= htf_fvg_min
htf_bear_4h = h2_l2 > h2_h0 and (h2_l2 - h2_h0) >= htf_fvg_min
htf_bear_d  = h3_l2 > h3_h0 and (h3_l2 - h3_h0) >= htf_fvg_min
htf_bear    = htf_bear_1h or htf_bear_4h or htf_bear_d

htf_bull_1h = h1_h2 < h1_l0 and (h1_l0 - h1_h2) >= htf_fvg_min
htf_bull_4h = h2_h2 < h2_l0 and (h2_l0 - h2_h2) >= htf_fvg_min
htf_bull_d  = h3_h2 < h3_l0 and (h3_l0 - h3_h2) >= htf_fvg_min
htf_bull    = htf_bull_1h or htf_bull_4h or htf_bull_d

// =============================================================
// SESSION / KILL ZONE
// =============================================================

h_utc = hour(time, "UTC")
m_utc = minute(time, "UTC")

ny_closed = h_utc > kz_ny_close_h or (h_utc == kz_ny_close_h and m_utc >= kz_ny_close_m)
in_london = h_utc >= kz_lon_open and h_utc < kz_lon_close
in_ny     = h_utc >= kz_ny_open and not ny_closed
in_kz     = in_london or in_ny

// EQH/EQL detection only makes sense on 15M+ charts (too noisy below)
eql_tf_ok = timeframe.in_seconds() >= 900

// =============================================================
// DAILY TRADE COUNTER
// =============================================================

var int trades_today = 0
var int last_day_id  = 0

day_id = year(time) * 10000 + month(time) * 100 + dayofmonth(time)
if day_id != last_day_id
    trades_today := 0
    last_day_id  := day_id

can_trade = trades_today < max_day_tr and strategy.position_size == 0

// =============================================================
// PREVIOUS DAY HIGH / LOW
// =============================================================

is_new_day = ta.change(time("D")) != 0

var float cur_dh = na
var float cur_dl = na
var float pdh    = na
var float pdl    = na

if is_new_day
    pdh    := cur_dh
    pdl    := cur_dl
    cur_dh := high
    cur_dl := low
else
    cur_dh := na(cur_dh) ? high : math.max(cur_dh, high)
    cur_dl := na(cur_dl) ? low  : math.min(cur_dl, low)

// =============================================================
// PREVIOUS WEEK HIGH / LOW
// =============================================================

is_new_week = ta.change(time("W")) != 0

var float cur_wh = na
var float cur_wl = na
var float pwh    = na
var float pwl    = na

if is_new_week
    pwh    := cur_wh
    pwl    := cur_wl
    cur_wh := high
    cur_wl := low
else
    cur_wh := na(cur_wh) ? high : math.max(cur_wh, high)
    cur_wl := na(cur_wl) ? low  : math.min(cur_wl, low)

// =============================================================
// ASIA RANGE  (22:00 - 07:00 UTC)
// =============================================================

in_asia = h_utc >= 22 or h_utc < 7

var float asia_live_h = na
var float asia_live_l = na
var float asia_h      = na
var float asia_l      = na

if in_asia
    asia_live_h := na(asia_live_h) ? high : math.max(asia_live_h, high)
    asia_live_l := na(asia_live_l) ? low  : math.min(asia_live_l, low)
else if in_asia[1]
    asia_h      := asia_live_h
    asia_l      := asia_live_l
    asia_live_h := na
    asia_live_l := na

// =============================================================
// SWING HIGHS / LOWS  (MSS reference — not sweep triggers)
// =============================================================

raw_swh = ta.pivothigh(high, sw_len, sw_len)
raw_swl = ta.pivotlow(low,  sw_len, sw_len)

var float last_swh = na
var float last_swl = na

if not na(raw_swh)
    last_swh := raw_swh
if not na(raw_swl)
    last_swl := raw_swl

// =============================================================
// EQUAL HIGHS / LOWS  (liquid highs/lows — multi-tested pivots)
// =============================================================

var float[] swh_hist = array.new_float(0)
var float[] swl_hist = array.new_float(0)
var float   last_eqh = na
var float   last_eql = na

eqh_new = false
eql_new = false

if use_eql and eql_tf_ok and not na(raw_swh)
    sz = array.size(swh_hist)
    if sz > 0
        for i = 0 to sz - 1
            if math.abs(raw_swh - array.get(swh_hist, i)) <= eql_tol
                eqh_new  := true
                last_eqh := raw_swh
                break
    if array.size(swh_hist) >= eql_lookback
        array.shift(swh_hist)
    array.push(swh_hist, raw_swh)

if use_eql and eql_tf_ok and not na(raw_swl)
    sz = array.size(swl_hist)
    if sz > 0
        for i = 0 to sz - 1
            if math.abs(raw_swl - array.get(swl_hist, i)) <= eql_tol
                eql_new  := true
                last_eql := raw_swl
                break
    if array.size(swl_hist) >= eql_lookback
        array.shift(swl_hist)
    array.push(swl_hist, raw_swl)

// =============================================================
// TIERED RISK ENGINE
// =============================================================

var int attempt = 1

f_risk(int a) =>
    a == 1 ? r1 : a == 2 ? r2 : a == 3 ? r3 : a == 4 ? r4 : a == 5 ? r5 : r6

was_in_trade = strategy.position_size[1] != 0 and strategy.position_size == 0
if was_in_trade
    n = strategy.closedtrades - 1
    if n >= 0
        last_profit = strategy.closedtrades.profit(n)
        attempt    := last_profit > 0 ? 1 : math.min(attempt + 1, 6)

f_qty(float sl_dist) =>
    sl_dist > 0.0 ? (fixed_cap * f_risk(attempt)) / sl_dist : 0.0

// =============================================================
// CANDLE BODY + ENGULFING
// =============================================================

is_bull = close > open
is_bear = close < open
body_hi = math.max(open, close)
body_lo = math.min(open, close)

prev_body_hi = math.max(open[1], close[1])
prev_body_lo = math.min(open[1], close[1])

bear_engulf = is_bear and body_hi > prev_body_hi and body_lo < prev_body_lo
bull_engulf = is_bull and body_hi > prev_body_hi and body_lo < prev_body_lo

// =============================================================
// STATE MACHINE
// 0 = IDLE
// 1 = BEAR_SWEPT  (HTF POI swept, waiting bearish MSS)
// 2 = BULL_SWEPT  (HTF POI swept, waiting bullish MSS)
// 3 = BEAR_FVG    (FVG set, waiting retest)
// 4 = BULL_FVG    (FVG set, waiting retest)
// =============================================================

var int   state        = 0
var int   state_bar    = 0
var float sweep_hi     = na
var float sweep_lo     = na
var float mss_ref_bear = na
var float mss_ref_bull = na
var float fvg_top      = na
var float fvg_bot      = na
var int   fvg_bar      = 0
var bool  mss_bear_ok  = false
var bool  mss_bull_ok  = false
var float pre_swl      = na
var float pre_swh      = na

var box fvg_entry_box = na
var box htf_b1h_box   = na
var box htf_u1h_box   = na
var box htf_b4h_box   = na
var box htf_u4h_box   = na
var box htf_bd_box    = na
var box htf_ud_box    = na

var bool prev_bear_1h = false
var bool prev_bull_1h = false
var bool prev_bear_4h = false
var bool prev_bull_4h = false
var bool prev_bear_d  = false
var bool prev_bull_d  = false

if state == 0
    if not na(raw_swl)
        pre_swl := raw_swl
    if not na(raw_swh)
        pre_swh := raw_swh

// Sweep functions
f_high_sweep(float lvl) =>
    not na(lvl) and high > (lvl + sweep_buf) and body_hi < lvl and is_bear

f_low_sweep(float lvl) =>
    not na(lvl) and low < (lvl - sweep_buf) and body_lo > lvl and is_bull

// HTF POI sweeps: PDH/PDL, PWH/PWL, Asia, EQH/EQL
hs_pdh  = use_pdhl and f_high_sweep(pdh)
hs_pwh  = use_pwhl and f_high_sweep(pwh)
hs_asia = use_asia and f_high_sweep(asia_h)
hs_eqh  = use_eql  and f_high_sweep(last_eqh)

ls_pdl  = use_pdhl and f_low_sweep(pdl)
ls_pwl  = use_pwhl and f_low_sweep(pwl)
ls_asia = use_asia and f_low_sweep(asia_l)
ls_eql  = use_eql  and f_low_sweep(last_eql)

htf_ok_bear = not use_htf or htf_bear
htf_ok_bull = not use_htf or htf_bull

// Sweep only triggers inside kill zone — entire cycle (sweep>MSS>FVG>entry) starts here
any_hs = (hs_pdh or hs_pwh or hs_asia or hs_eqh) and htf_ok_bear and can_trade and in_kz
any_ls = (ls_pdl or ls_pwl or ls_asia or ls_eql)  and htf_ok_bull and can_trade and in_kz

// IDLE -> SWEPT
if state == 0 and any_hs
    state        := 1
    sweep_hi     := high
    mss_ref_bear := na(pre_swl) ? low : pre_swl
    state_bar    := bar_index

if state == 0 and any_ls
    state        := 2
    sweep_lo     := low
    mss_ref_bull := na(pre_swh) ? high : pre_swh
    state_bar    := bar_index

// MSS timeout
if (state == 1 or state == 2) and (bar_index - state_bar) > mss_max_bars
    state := 0

// MSS detection
bear_mss = state == 1 and not na(mss_ref_bear) and body_lo < mss_ref_bear and is_bear
bull_mss = state == 2 and not na(mss_ref_bull) and body_hi > mss_ref_bull and is_bull

if bear_mss
    mss_bear_ok := true
    state       := 3
    state_bar   := bar_index

if bull_mss
    mss_bull_ok := true
    state       := 4
    state_bar   := bar_index

// FVG detection (bar N+1 after MSS)
if mss_bear_ok[1]
    bear_gap = low[2] - high
    if bear_gap >= fvg_min_gap
        fvg_top := low[2]
        fvg_bot := high
        fvg_bar := bar_index
        box.delete(fvg_entry_box)
        fvg_entry_box := box.new(bar_index - 2, fvg_top, bar_index + 1, fvg_bot,
             border_color = color.new(color.red, 10),
             bgcolor      = color.new(color.red, 80),
             text         = "FVG",
             text_color   = color.new(color.red, 20),
             text_size    = size.tiny,
             text_halign  = text.align_left,
             text_valign  = text.align_top)
    else
        state := 0
    mss_bear_ok := false

if mss_bull_ok[1]
    bull_gap = low - high[2]
    if bull_gap >= fvg_min_gap
        fvg_top := low
        fvg_bot := high[2]
        fvg_bar := bar_index
        box.delete(fvg_entry_box)
        fvg_entry_box := box.new(bar_index - 2, fvg_top, bar_index + 1, fvg_bot,
             border_color = color.new(color.teal, 10),
             bgcolor      = color.new(color.teal, 80),
             text         = "FVG",
             text_color   = color.new(color.teal, 20),
             text_size    = size.tiny,
             text_halign  = text.align_left,
             text_valign  = text.align_top)
    else
        state := 0
    mss_bull_ok := false

// Extend FVG box right edge while active
if (state == 3 or state == 4) and not na(fvg_entry_box)
    box.set_right(fvg_entry_box, bar_index + 5)

// FVG timeout — delete box (disappears from chart)
if (state == 3 or state == 4) and (bar_index - fvg_bar) > fvg_max_bars
    box.delete(fvg_entry_box)
    state := 0

// =============================================================
// ENTRY CONDITIONS
// =============================================================

in_bear_fvg = state == 3 and not na(fvg_top) and not na(fvg_bot)
in_bull_fvg = state == 4 and not na(fvg_top) and not na(fvg_bot)

touched_bear = in_bear_fvg and high >= fvg_bot and low <= fvg_top
touched_bull = in_bull_fvg and low  <= fvg_top and high >= fvg_bot

close_ok_bear  = req_close_fvg ? (close >= fvg_bot and close <= fvg_top and is_bear) : is_bear
close_ok_bull  = req_close_fvg ? (close >= fvg_bot and close <= fvg_top and is_bull) : is_bull
engulf_ok_bear = not req_engulf or bear_engulf
engulf_ok_bull = not req_engulf or bull_engulf

short_signal = touched_bear and close_ok_bear and engulf_ok_bear and in_kz and can_trade
long_signal  = touched_bull and close_ok_bull  and engulf_ok_bull and in_kz and can_trade

// =============================================================
// ORDER EXECUTION
// =============================================================

if short_signal
    sl_price = sweep_hi + sweep_buf
    tp_price = close - (sl_price - close) * rr_ratio
    sl_dist  = sl_price - close
    if sl_dist >= min_sl and sl_dist <= max_sl
        qty = f_qty(sl_dist)
        if qty > 0
            strategy.entry("Short", strategy.short, qty = qty, comment = "SMC Short")
            strategy.exit("SX", from_entry = "Short", stop = sl_price, limit = tp_price)
            trades_today += 1
            state := 0
            if not na(fvg_entry_box)
                box.set_right(fvg_entry_box, bar_index)

if long_signal
    sl_price = sweep_lo - sweep_buf
    tp_price = close + (close - sl_price) * rr_ratio
    sl_dist  = close - sl_price
    if sl_dist >= min_sl and sl_dist <= max_sl
        qty = f_qty(sl_dist)
        if qty > 0
            strategy.entry("Long", strategy.long, qty = qty, comment = "SMC Long")
            strategy.exit("LX", from_entry = "Long", stop = sl_price, limit = tp_price)
            trades_today += 1
            state := 0
            if not na(fvg_entry_box)
                box.set_right(fvg_entry_box, bar_index)

// =============================================================
// VISUALS
// =============================================================

bgcolor(show_kz_bg and in_london ? color.new(color.blue,   95) : na, title = "London KZ")
bgcolor(show_kz_bg and in_ny     ? color.new(color.yellow, 95) : na, title = "NY KZ")

// HTF POI flat horizontal lines — recreated each period
var line l_pdh    = na
var line l_pdl    = na
var line l_pwh    = na
var line l_pwl    = na
var line l_asia_h = na
var line l_asia_l = na
var line l_eqh    = na
var line l_eql    = na
var label lb_pdh    = na
var label lb_pdl    = na
var label lb_pwh    = na
var label lb_pwl    = na
var label lb_asia_h = na
var label lb_asia_l = na
var label lb_eqh    = na
var label lb_eql    = na
var box[] bear_fvg_arr = array.new<box>(0)
var box[] bull_fvg_arr = array.new<box>(0)

if show_levels and use_pdhl and is_new_day
    line.delete(l_pdh)
    line.delete(l_pdl)
    label.delete(lb_pdh)
    label.delete(lb_pdl)
    if not na(pdh)
        l_pdh  := line.new(bar_index, pdh, bar_index + 1, pdh, extend = extend.right, color = color.new(color.red,  30), style = line.style_dashed, width = 1)
        lb_pdh := label.new(bar_index, pdh, "PDH", style = label.style_none, textcolor = color.new(color.red,  20), size = size.tiny)
    if not na(pdl)
        l_pdl  := line.new(bar_index, pdl, bar_index + 1, pdl, extend = extend.right, color = color.new(color.teal, 30), style = line.style_dashed, width = 1)
        lb_pdl := label.new(bar_index, pdl, "PDL", style = label.style_none, textcolor = color.new(color.teal, 20), size = size.tiny)

if show_levels and use_pwhl and is_new_week
    line.delete(l_pwh)
    line.delete(l_pwl)
    label.delete(lb_pwh)
    label.delete(lb_pwl)
    if not na(pwh)
        l_pwh  := line.new(bar_index, pwh, bar_index + 1, pwh, extend = extend.right, color = color.new(color.maroon, 40), style = line.style_solid, width = 1)
        lb_pwh := label.new(bar_index, pwh, "PWH", style = label.style_none, textcolor = color.new(color.maroon, 20), size = size.tiny)
    if not na(pwl)
        l_pwl  := line.new(bar_index, pwl, bar_index + 1, pwl, extend = extend.right, color = color.new(color.navy,   40), style = line.style_solid, width = 1)
        lb_pwl := label.new(bar_index, pwl, "PWL", style = label.style_none, textcolor = color.new(color.navy,   20), size = size.tiny)

asia_closed = not in_asia and in_asia[1]
if show_levels and use_asia and asia_closed
    line.delete(l_asia_h)
    line.delete(l_asia_l)
    label.delete(lb_asia_h)
    label.delete(lb_asia_l)
    if not na(asia_h)
        l_asia_h  := line.new(bar_index, asia_h, bar_index + 1, asia_h, extend = extend.right, color = color.new(color.purple, 30), style = line.style_dotted, width = 1)
        lb_asia_h := label.new(bar_index, asia_h, "Asia H", style = label.style_none, textcolor = color.new(color.purple, 20), size = size.tiny)
    if not na(asia_l)
        l_asia_l  := line.new(bar_index, asia_l, bar_index + 1, asia_l, extend = extend.right, color = color.new(color.purple, 30), style = line.style_dotted, width = 1)
        lb_asia_l := label.new(bar_index, asia_l, "Asia L", style = label.style_none, textcolor = color.new(color.purple, 20), size = size.tiny)

// Equal Highs / Lows — orange dashed line with small text label (15M+ only)
if use_eql and eql_tf_ok and show_levels and eqh_new and not na(last_eqh)
    line.delete(l_eqh)
    label.delete(lb_eqh)
    l_eqh  := line.new(bar_index - sw_len, last_eqh, bar_index, last_eqh, extend = extend.right, color = color.new(color.orange, 10), style = line.style_dashed, width = 2)
    lb_eqh := label.new(bar_index, last_eqh, "EQH", style = label.style_none, textcolor = color.new(color.orange, 10), size = size.tiny)

if use_eql and eql_tf_ok and show_levels and eql_new and not na(last_eql)
    line.delete(l_eql)
    label.delete(lb_eql)
    l_eql  := line.new(bar_index - sw_len, last_eql, bar_index, last_eql, extend = extend.right, color = color.new(color.orange, 10), style = line.style_dashed, width = 2)
    lb_eql := label.new(bar_index, last_eql, "EQL", style = label.style_none, textcolor = color.new(color.orange, 10), size = size.tiny)

// Remove POI lines when price has touched them or they are too far from current price
if show_levels
    if not na(l_pdh) and (high >= pdh or math.abs(close - pdh) > max_poi_dist)
        line.delete(l_pdh)
        label.delete(lb_pdh)
        l_pdh  := na
        lb_pdh := na
    if not na(l_pdl) and (low <= pdl or math.abs(close - pdl) > max_poi_dist)
        line.delete(l_pdl)
        label.delete(lb_pdl)
        l_pdl  := na
        lb_pdl := na
    if not na(l_pwh) and (high >= pwh or math.abs(close - pwh) > max_poi_dist)
        line.delete(l_pwh)
        label.delete(lb_pwh)
        l_pwh  := na
        lb_pwh := na
    if not na(l_pwl) and (low <= pwl or math.abs(close - pwl) > max_poi_dist)
        line.delete(l_pwl)
        label.delete(lb_pwl)
        l_pwl  := na
        lb_pwl := na
    if not na(l_asia_h) and (high >= asia_h or math.abs(close - asia_h) > max_poi_dist)
        line.delete(l_asia_h)
        label.delete(lb_asia_h)
        l_asia_h  := na
        lb_asia_h := na
    if not na(l_asia_l) and (low <= asia_l or math.abs(close - asia_l) > max_poi_dist)
        line.delete(l_asia_l)
        label.delete(lb_asia_l)
        l_asia_l  := na
        lb_asia_l := na
    if not na(l_eqh) and not na(last_eqh) and (high >= last_eqh or math.abs(close - last_eqh) > max_poi_dist)
        line.delete(l_eqh)
        label.delete(lb_eqh)
        l_eqh  := na
        lb_eqh := na
    if not na(l_eql) and not na(last_eql) and (low <= last_eql or math.abs(close - last_eql) > max_poi_dist)
        line.delete(l_eql)
        label.delete(lb_eql)
        l_eql  := na
        lb_eql := na

// Sweep markers (dot at the sweep candle — in KZ only)
plotshape(show_sweep and any_hs, title = "Sweep HIGH", style = shape.circle, location = location.abovebar, color = color.new(color.red,  0), size = size.tiny)
plotshape(show_sweep and any_ls, title = "Sweep LOW",  style = shape.circle, location = location.belowbar, color = color.new(color.teal, 0), size = size.tiny)

// HTF FVG boxes — create on new edge, DELETE on invalidation (disappear)
new_bear_1h  = htf_bear_1h and not prev_bear_1h
gone_bear_1h = not htf_bear_1h and prev_bear_1h
new_bull_1h  = htf_bull_1h and not prev_bull_1h
gone_bull_1h = not htf_bull_1h and prev_bull_1h
new_bear_4h  = htf_bear_4h and not prev_bear_4h
gone_bear_4h = not htf_bear_4h and prev_bear_4h
new_bull_4h  = htf_bull_4h and not prev_bull_4h
gone_bull_4h = not htf_bull_4h and prev_bull_4h
new_bear_d   = htf_bear_d  and not prev_bear_d
gone_bear_d  = not htf_bear_d  and prev_bear_d
new_bull_d   = htf_bull_d  and not prev_bull_d
gone_bull_d  = not htf_bull_d  and prev_bull_d

prev_bear_1h := htf_bear_1h
prev_bull_1h := htf_bull_1h
prev_bear_4h := htf_bear_4h
prev_bull_4h := htf_bull_4h
prev_bear_d  := htf_bear_d
prev_bull_d  := htf_bull_d

if show_levels
    if new_bear_1h
        box.delete(htf_b1h_box)
        htf_b1h_box := box.new(bar_index, h1_l2, bar_index + 1, h1_h0, border_color = color.new(color.red, 30), bgcolor = color.new(color.red, 87), text = "1H", text_color = color.new(color.red, 20), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top)
    if gone_bear_1h
        box.delete(htf_b1h_box)
        htf_b1h_box := na
    if htf_bear_1h and not na(htf_b1h_box)
        b_bot = box.get_bottom(htf_b1h_box)
        b_mid = (box.get_top(htf_b1h_box) + b_bot) / 2
        if high >= b_bot or math.abs(close - b_mid) > max_poi_dist
            box.delete(htf_b1h_box)
            htf_b1h_box := na
        else
            box.set_right(htf_b1h_box, bar_index + 5)

    if new_bull_1h
        box.delete(htf_u1h_box)
        htf_u1h_box := box.new(bar_index, h1_l0, bar_index + 1, h1_h2, border_color = color.new(color.teal, 30), bgcolor = color.new(color.teal, 87), text = "1H", text_color = color.new(color.teal, 20), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_bottom)
    if gone_bull_1h
        box.delete(htf_u1h_box)
        htf_u1h_box := na
    if htf_bull_1h and not na(htf_u1h_box)
        b_top = box.get_top(htf_u1h_box)
        b_mid = (b_top + box.get_bottom(htf_u1h_box)) / 2
        if low <= b_top or math.abs(close - b_mid) > max_poi_dist
            box.delete(htf_u1h_box)
            htf_u1h_box := na
        else
            box.set_right(htf_u1h_box, bar_index + 5)

    if new_bear_4h
        box.delete(htf_b4h_box)
        htf_b4h_box := box.new(bar_index, h2_l2, bar_index + 1, h2_h0, border_color = color.new(color.red, 20), bgcolor = color.new(color.red, 84), text = "4H", text_color = color.new(color.red, 10), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top)
    if gone_bear_4h
        box.delete(htf_b4h_box)
        htf_b4h_box := na
    if htf_bear_4h and not na(htf_b4h_box)
        b_bot = box.get_bottom(htf_b4h_box)
        b_mid = (box.get_top(htf_b4h_box) + b_bot) / 2
        if high >= b_bot or math.abs(close - b_mid) > max_poi_dist
            box.delete(htf_b4h_box)
            htf_b4h_box := na
        else
            box.set_right(htf_b4h_box, bar_index + 5)

    if new_bull_4h
        box.delete(htf_u4h_box)
        htf_u4h_box := box.new(bar_index, h2_l0, bar_index + 1, h2_h2, border_color = color.new(color.teal, 20), bgcolor = color.new(color.teal, 84), text = "4H", text_color = color.new(color.teal, 10), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_bottom)
    if gone_bull_4h
        box.delete(htf_u4h_box)
        htf_u4h_box := na
    if htf_bull_4h and not na(htf_u4h_box)
        b_top = box.get_top(htf_u4h_box)
        b_mid = (b_top + box.get_bottom(htf_u4h_box)) / 2
        if low <= b_top or math.abs(close - b_mid) > max_poi_dist
            box.delete(htf_u4h_box)
            htf_u4h_box := na
        else
            box.set_right(htf_u4h_box, bar_index + 5)

    if new_bear_d
        box.delete(htf_bd_box)
        htf_bd_box := box.new(bar_index, h3_l2, bar_index + 1, h3_h0, border_color = color.new(color.red, 10), bgcolor = color.new(color.red, 80), text = "D", text_color = color.new(color.red, 0), text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)
    if gone_bear_d
        box.delete(htf_bd_box)
        htf_bd_box := na
    if htf_bear_d and not na(htf_bd_box)
        b_bot = box.get_bottom(htf_bd_box)
        b_mid = (box.get_top(htf_bd_box) + b_bot) / 2
        if high >= b_bot or math.abs(close - b_mid) > max_poi_dist
            box.delete(htf_bd_box)
            htf_bd_box := na
        else
            box.set_right(htf_bd_box, bar_index + 5)

    if new_bull_d
        box.delete(htf_ud_box)
        htf_ud_box := box.new(bar_index, h3_l0, bar_index + 1, h3_h2, border_color = color.new(color.teal, 10), bgcolor = color.new(color.teal, 80), text = "D", text_color = color.new(color.teal, 0), text_size = size.small, text_halign = text.align_right, text_valign = text.align_bottom)
    if gone_bull_d
        box.delete(htf_ud_box)
        htf_ud_box := na
    if htf_bull_d and not na(htf_ud_box)
        b_top = box.get_top(htf_ud_box)
        b_mid = (b_top + box.get_bottom(htf_ud_box)) / 2
        if low <= b_top or math.abs(close - b_mid) > max_poi_dist
            box.delete(htf_ud_box)
            htf_ud_box := na
        else
            box.set_right(htf_ud_box, bar_index + 5)

// =============================================================
// FVG IMBALANCE VISUALIZATION
// All unmitigated 3-candle imbalances on the current chart.
// Bear FVG (supply): low[2] > high[0]  — red box; price deletes on entry
// Bull FVG (demand): high[2] < low[0]  — teal box; price deletes on entry
// Multiple stacked FVGs in a downtrend → topmost is used for entry
// (the state machine picks the first FVG after MSS, which is highest in a
// falling sequence). The visual boxes show all remaining unmitigated ones.
// =============================================================

if show_fvg_vis
    // --- detect bear FVG on this bar ---
    bear_vis_gap = low[2] - high
    if bear_vis_gap >= fvg_min_gap
        nb = box.new(bar_index - 2, low[2], bar_index + 1, high,
             border_color = color.new(color.red,  65),
             bgcolor      = color.new(color.red,  90),
             text         = "IMB",
             text_color   = color.new(color.red,  40),
             text_size    = size.tiny,
             text_halign  = text.align_center,
             text_valign  = text.align_center)
        array.push(bear_fvg_arr, nb)
        if array.size(bear_fvg_arr) > 20
            box.delete(array.shift(bear_fvg_arr))

    // --- detect bull FVG on this bar ---
    bull_vis_gap = low - high[2]
    if bull_vis_gap >= fvg_min_gap
        nb = box.new(bar_index - 2, low, bar_index + 1, high[2],
             border_color = color.new(color.teal, 65),
             bgcolor      = color.new(color.teal, 90),
             text         = "IMB",
             text_color   = color.new(color.teal, 40),
             text_size    = size.tiny,
             text_halign  = text.align_center,
             text_valign  = text.align_center)
        array.push(bull_fvg_arr, nb)
        if array.size(bull_fvg_arr) > 20
            box.delete(array.shift(bull_fvg_arr))

    // --- extend bear FVG boxes; delete when price enters ---
    n_bear = array.size(bear_fvg_arr)
    if n_bear > 0
        for j = 0 to n_bear - 1
            i = n_bear - 1 - j
            b = array.get(bear_fvg_arr, i)
            if high >= box.get_bottom(b)
                box.delete(b)
                array.remove(bear_fvg_arr, i)
            else
                box.set_right(b, bar_index + 5)

    // --- extend bull FVG boxes; delete when price enters ---
    n_bull = array.size(bull_fvg_arr)
    if n_bull > 0
        for j = 0 to n_bull - 1
            i = n_bull - 1 - j
            b = array.get(bull_fvg_arr, i)
            if low <= box.get_top(b)
                box.delete(b)
                array.remove(bull_fvg_arr, i)
            else
                box.set_right(b, bar_index + 5)

// Entry signals
plotshape(short_signal, title = "Short Entry", style = shape.labeldown, location = location.abovebar, color = color.red,  textcolor = color.white, text = "SHORT", size = size.small)
plotshape(long_signal,  title = "Long Entry",  style = shape.labelup,   location = location.belowbar, color = color.teal, textcolor = color.white, text = "LONG",  size = size.small)

// =============================================================
// INFO TABLE  (top right)
// =============================================================

var table tbl = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 75), border_width = 1, border_color = color.gray)

if barstate.islast
    table.cell(tbl, 0, 0, "SMC v4 EURUSD", text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.small)
    table.cell(tbl, 1, 0, "",               text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.small)

    st_str = switch state
        0 => "IDLE"
        1 => "SWEPT DN"
        2 => "SWEPT UP"
        3 => "FVG SHORT"
        => "FVG LONG"

    st_col = switch
        state == 0               => color.gray
        state == 1 or state == 2 => color.orange
        state == 3               => color.red
        =>                          color.teal

    table.cell(tbl, 0, 1, "State",   text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 1, st_str,    text_color = st_col,     text_size = size.tiny)

    rsk_pct = str.tostring(f_risk(attempt) * 100, "#.##")
    rsk_str = str.tostring(attempt) + "/6 (" + rsk_pct + "%)"
    rsk_col = switch
        attempt == 1 => color.lime
        attempt <= 3 => color.yellow
        =>              color.red

    table.cell(tbl, 0, 2, "Attempt", text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 2, rsk_str,   text_color = rsk_col,    text_size = size.tiny)

    td_str = str.tostring(trades_today) + "/" + str.tostring(max_day_tr)
    td_col = trades_today >= max_day_tr ? color.red : color.lime
    table.cell(tbl, 0, 3, "Trades Today", text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 3, td_str,         text_color = td_col,     text_size = size.tiny)

    kz_str = switch
        in_london => "London"
        in_ny     => "New York"
        =>            "OFF"
    kz_col = in_kz ? color.lime : color.red
    table.cell(tbl, 0, 4, "Kill Zone", text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 4, kz_str,      text_color = kz_col,     text_size = size.tiny)

    bias_str = switch
        htf_bear and not htf_bull => "BEAR"
        htf_bull and not htf_bear => "BULL"
        =>                           "NEUTRAL"
    bias_col = switch
        htf_bear and not htf_bull => color.red
        htf_bull and not htf_bear => color.teal
        =>                           color.gray
    table.cell(tbl, 0, 5, "HTF Bias", text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 5, bias_str,   text_color = bias_col,   text_size = size.tiny)

    pdhl_val = not na(pdh) ? str.tostring(pdh, "#.#####") + "/" + str.tostring(pdl, "#.#####") : "--"
    table.cell(tbl, 0, 6, "PDH/PDL", text_color = color.gray,  text_size = size.tiny)
    table.cell(tbl, 1, 6, pdhl_val,  text_color = color.orange, text_size = size.tiny)

    pwhl_val = not na(pwh) ? str.tostring(pwh, "#.#####") + "/" + str.tostring(pwl, "#.#####") : "--"
    table.cell(tbl, 0, 7, "PWH/PWL", text_color = color.gray,  text_size = size.tiny)
    table.cell(tbl, 1, 7, pwhl_val,  text_color = color.maroon, text_size = size.tiny)

    fvg_active = (state == 3 or state == 4) and not na(fvg_top)
    fvg_val    = fvg_active ? str.tostring(fvg_top, "#.#####") + "/" + str.tostring(fvg_bot, "#.#####") : "--"
    table.cell(tbl, 0, 8, "FVG Zone", text_color = color.gray,  text_size = size.tiny)
    table.cell(tbl, 1, 8, fvg_val,    text_color = color.yellow, text_size = size.tiny)

// =============================================================
// STATS TABLE  (top left — trade statistics)
// =============================================================

var table stats = table.new(position.top_left, 2, 9, bgcolor = color.new(color.black, 75), border_width = 1, border_color = color.gray)

if barstate.islast
    n_closed = strategy.closedtrades
    n_wins   = strategy.wintrades
    n_loss   = strategy.losstrades
    win_rate = n_closed > 0 ? (n_wins / n_closed) * 100.0 : 0.0
    avg_win  = n_wins > 0  ? strategy.grossprofit / n_wins : 0.0
    avg_loss = n_loss > 0  ? math.abs(strategy.grossloss) / n_loss : 0.0
    pf       = strategy.grossloss != 0.0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0.0
    expect   = n_closed > 0 ? (win_rate / 100.0) * (avg_win / math.max(avg_loss, 0.01)) - (1.0 - win_rate / 100.0) : 0.0

    table.cell(stats, 0, 0, "STATISTICS", text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.small)
    table.cell(stats, 1, 0, "",           text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.small)

    table.cell(stats, 0, 1, "Trades",  text_color = color.gray,  text_size = size.tiny)
    table.cell(stats, 1, 1, str.tostring(n_closed) + "  " + str.tostring(n_wins) + "W/" + str.tostring(n_loss) + "L", text_color = color.white, text_size = size.tiny)

    wr_col = win_rate >= 50.0 ? color.lime : color.red
    table.cell(stats, 0, 2, "Win Rate",     text_color = color.gray, text_size = size.tiny)
    table.cell(stats, 1, 2, str.tostring(win_rate, "#.#") + "%", text_color = wr_col, text_size = size.tiny)

    pf_col = pf >= 1.5 ? color.lime : pf >= 1.0 ? color.yellow : color.red
    table.cell(stats, 0, 3, "Profit Factor", text_color = color.gray, text_size = size.tiny)
    table.cell(stats, 1, 3, str.tostring(pf, "#.##"),              text_color = pf_col,    text_size = size.tiny)

    net_pnl = strategy.netprofit
    pnl_col = net_pnl >= 0.0 ? color.lime : color.red
    table.cell(stats, 0, 4, "Net P&L",   text_color = color.gray, text_size = size.tiny)
    table.cell(stats, 1, 4, str.tostring(net_pnl, "#.##"), text_color = pnl_col, text_size = size.tiny)

    table.cell(stats, 0, 5, "Max DD",    text_color = color.gray,   text_size = size.tiny)
    table.cell(stats, 1, 5, str.tostring(strategy.max_drawdown, "#.##"), text_color = color.orange, text_size = size.tiny)

    table.cell(stats, 0, 6, "Avg Win",   text_color = color.gray, text_size = size.tiny)
    table.cell(stats, 1, 6, str.tostring(avg_win,  "#.##"), text_color = color.lime, text_size = size.tiny)

    table.cell(stats, 0, 7, "Avg Loss",  text_color = color.gray, text_size = size.tiny)
    table.cell(stats, 1, 7, str.tostring(avg_loss, "#.##"), text_color = color.red,  text_size = size.tiny)

    exp_col = expect >= 0.0 ? color.lime : color.red
    table.cell(stats, 0, 8, "Expectancy", text_color = color.gray, text_size = size.tiny)
    table.cell(stats, 1, 8, str.tostring(expect, "#.###") + "R",  text_color = exp_col, text_size = size.tiny)

// =============================================================
// ALERTS
// =============================================================

alertcondition(any_hs,       title = "Sweep HIGH",         message = "Sweep HIGH - watch for bearish MSS")
alertcondition(any_ls,       title = "Sweep LOW",          message = "Sweep LOW - watch for bullish MSS")
alertcondition(bear_mss,     title = "MSS Bear Confirmed", message = "Bearish MSS confirmed - FVG active")
alertcondition(bull_mss,     title = "MSS Bull Confirmed", message = "Bullish MSS confirmed - FVG active")
alertcondition(short_signal, title = "SHORT Entry",        message = "SMC SHORT | Engulfing FVG retest | Entry: {{close}}")
alertcondition(long_signal,  title = "LONG Entry",         message = "SMC LONG  | Engulfing FVG retest | Entry: {{close}}")
alertcondition(eqh_new,      title = "EQH Formed",         message = "Equal High detected - liquidity pool above")
alertcondition(eql_new,      title = "EQL Formed",         message = "Equal Low detected - liquidity pool below")
