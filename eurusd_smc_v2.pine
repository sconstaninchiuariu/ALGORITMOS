// This Pine Script(tm) code is subject to the terms of the Mozilla Public License 2.0
// SMC EURUSD v4 | Sweep HTF POI > 1M MSS > FVG + Engulfing Entry
// HTF Bias: Monthly/Weekly/Daily/4H/1H FVG | POIs: PDH/PDL, PWH/PWL, Asia, EQH/EQL
// Kill Zones: London 03:00-05:00 UTC | NY 08:00-10:30 UTC
// Risk: Tiered non-compounded 0.7%-2.0% | SL=sweep wick | TP=SLxRR

//@version=6
strategy(
    title             = "SMC EURUSD v4",
    shorttitle        = "SMC-v4",
    overlay           = true,
    default_qty_type  = strategy.fixed,
    default_qty_value = 1,
    initial_capital   = 100000,
    currency          = currency.USD,
    commission_type   = strategy.commission.cash_per_contract,
    commission_value  = 0.00005,
    slippage          = 2,
    pyramiding        = 0,
    max_bars_back     = 500)

// =============================================================
// INPUTS
// =============================================================

var string GKZ = "Kill Zones (UTC)"
kz_lon_open   = input.int(3,  "London Open (h)",  0, 23, group = GKZ)
kz_lon_close  = input.int(5,  "London Close (h)", 0, 23, group = GKZ)
kz_ny_open    = input.int(8,  "NY Open (h)",      0, 23, group = GKZ)
kz_ny_close_h = input.int(10, "NY Close (h)",     0, 23, group = GKZ)
kz_ny_close_m = input.int(30, "NY Close (min)",   0, 59, group = GKZ)

var string GLIQ = "Liquidity Levels (HTF POIs)"
use_pdhl  = input.bool(true,    "PDH / PDL (Previous Day)",  group = GLIQ)
use_pwhl  = input.bool(true,    "PWH / PWL (Previous Week)", group = GLIQ)
use_asia  = input.bool(true,    "Asia Range H/L",            group = GLIQ)
sw_len    = input.int(10,       "Swing Lookback (MSS ref)",  2, 50, group = GLIQ)
sweep_buf = input.float(0.0002, "Sweep Buffer", 0.00005, 0.001, 0.00001, group = GLIQ)

var string GMSS = "MSS Settings"
mss_max_bars = input.int(80, "Max Bars for MSS", 5, 300, group = GMSS)

var string GFVG = "FVG / Imbalance"
fvg_min_gap   = input.float(0.0002, "Min FVG Gap",  0.00005, 0.002, 0.00001, group = GFVG)
fvg_max_bars  = input.int(60,       "FVG Max Age",  5, 300,          group = GFVG)
req_close_fvg = input.bool(true,    "Entry candle must CLOSE inside FVG", group = GFVG)
req_engulf    = input.bool(true,    "Entry candle must be ENGULFING (body covers prev body)", group = GFVG)

var string GHTF = "HTF Context Filter"
use_htf     = input.bool(true,  "Require HTF FVG alignment (at least one active TF)", group = GHTF)
use_htf_1h  = input.bool(true,  "1H FVG zones",      group = GHTF)
use_htf_4h  = input.bool(true,  "4H FVG zones",      group = GHTF)
use_htf_d   = input.bool(true,  "Daily FVG zones",   group = GHTF)
use_htf_w   = input.bool(true,  "Weekly FVG zones",  group = GHTF)
use_htf_m   = input.bool(false, "Monthly FVG zones", group = GHTF)
htf_fvg_min = input.float(0.0003, "Min HTF FVG Size", 0.00010, 0.010, 0.00010, group = GHTF)

var string GRSK = "Risk Management"
rr_ratio   = input.float(2.0,    "RR Ratio",         1.0, 10.0, 0.1,    group = GRSK)
max_sl     = input.float(0.0050, "Max SL Distance",  0.0005, 0.0200, 0.0001, group = GRSK)
min_sl     = input.float(0.0003, "Min SL Distance",  0.0001, 0.0020, 0.0001, group = GRSK)
max_day_tr = input.int(2,        "Max Trades / Day", 1, 5,              group = GRSK)
fixed_cap  = input.float(100000, "Fixed Capital (non-compounded)",       group = GRSK)

var string GTR = "Tiered Risk (% of Fixed Capital)"
r1 = input.float(0.7, "Attempt 1 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r2 = input.float(0.8, "Attempt 2 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r3 = input.float(1.2, "Attempt 3 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r4 = input.float(1.5, "Attempt 4 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r5 = input.float(1.8, "Attempt 5 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r6 = input.float(2.0, "Attempt 6 (%)", 0.1, 5.0, 0.1, group = GTR) / 100

var string GEQL = "Equal Highs / Lows (Liquidity Pools)"
use_eql      = input.bool(true,    "Detect and show EQH / EQL",        group = GEQL)
eql_tol      = input.float(0.0003, "Tolerance (price)",  0.00005, 0.002, 0.00001, group = GEQL)
eql_lookback = input.int(5,        "History depth (# pivots)", 2, 20,   group = GEQL)

var string GVIS = "Visuals"
show_levels  = input.bool(true,    "Show POI Lines (PDH/PDL, PWH/PWL, Asia, EQH/EQL)", group = GVIS)
show_kz_bg   = input.bool(true,    "Show Kill Zone Background",                         group = GVIS)
show_sweep   = input.bool(true,    "Show Sweep Markers",                                group = GVIS)
max_poi_dist = input.float(0.0100, "Max POI Distance (hide zones > N price)",  0.0010, 0.1000, 0.0010, group = GVIS)
show_fvg_vis = input.bool(true,    "Show FVG Imbalance Boxes (all unmitigated)",        group = GVIS)
merge_tol    = input.float(0.0005, "Zone Merge Tolerance",  0.00010, 0.005, 0.00010,   group = GVIS)

// =============================================================
// HTF BIAS  (no-repainting)
// =============================================================

[h1_h2, h1_l2, h1_h0, h1_l0] = request.security(syminfo.tickerid, "60",  [high[2], low[2], high[0], low[0]], lookahead = barmerge.lookahead_off)
[h2_h2, h2_l2, h2_h0, h2_l0] = request.security(syminfo.tickerid, "240", [high[2], low[2], high[0], low[0]], lookahead = barmerge.lookahead_off)
[h3_h2, h3_l2, h3_h0, h3_l0] = request.security(syminfo.tickerid, "D",   [high[2], low[2], high[0], low[0]], lookahead = barmerge.lookahead_off)
[hw_h2, hw_l2, hw_h0, hw_l0] = request.security(syminfo.tickerid, "W",   [high[2], low[2], high[0], low[0]], lookahead = barmerge.lookahead_off)
[hm_h2, hm_l2, hm_h0, hm_l0] = request.security(syminfo.tickerid, "M",   [high[2], low[2], high[0], low[0]], lookahead = barmerge.lookahead_off)

htf_bear_1h = h1_l2 > h1_h0 and (h1_l2 - h1_h0) >= htf_fvg_min
htf_bear_4h = h2_l2 > h2_h0 and (h2_l2 - h2_h0) >= htf_fvg_min
htf_bear_d  = h3_l2 > h3_h0 and (h3_l2 - h3_h0) >= htf_fvg_min
htf_bear_w  = hw_l2 > hw_h0 and (hw_l2 - hw_h0) >= htf_fvg_min
htf_bear_m  = hm_l2 > hm_h0 and (hm_l2 - hm_h0) >= htf_fvg_min
htf_bear    = (use_htf_1h and htf_bear_1h) or (use_htf_4h and htf_bear_4h) or (use_htf_d and htf_bear_d) or (use_htf_w and htf_bear_w) or (use_htf_m and htf_bear_m)

htf_bull_1h = h1_h2 < h1_l0 and (h1_l0 - h1_h2) >= htf_fvg_min
htf_bull_4h = h2_h2 < h2_l0 and (h2_l0 - h2_h2) >= htf_fvg_min
htf_bull_d  = h3_h2 < h3_l0 and (h3_l0 - h3_h2) >= htf_fvg_min
htf_bull_w  = hw_h2 < hw_l0 and (hw_l0 - hw_h2) >= htf_fvg_min
htf_bull_m  = hm_h2 < hm_l0 and (hm_l0 - hm_h2) >= htf_fvg_min
htf_bull    = (use_htf_1h and htf_bull_1h) or (use_htf_4h and htf_bull_4h) or (use_htf_d and htf_bull_d) or (use_htf_w and htf_bull_w) or (use_htf_m and htf_bull_m)

// =============================================================
// SESSION / KILL ZONE
// =============================================================

h_utc = hour(time, "UTC")
m_utc = minute(time, "UTC")

ny_closed = h_utc > kz_ny_close_h or (h_utc == kz_ny_close_h and m_utc >= kz_ny_close_m)
in_london = h_utc >= kz_lon_open and h_utc < kz_lon_close
in_ny     = h_utc >= kz_ny_open and not ny_closed
in_kz     = in_london or in_ny

eql_tf_ok = timeframe.in_seconds() >= 900

// =============================================================
// DAILY TRADE COUNTER
// =============================================================

var int trades_today = 0
var int last_day_id  = 0

day_id = year(time) * 10000 + month(time) * 100 + dayofmonth(time)
if day_id != last_day_id
    trades_today := 0
    last_day_id  := day_id

can_trade = trades_today < max_day_tr and strategy.position_size == 0

// =============================================================
// PREVIOUS DAY HIGH / LOW
// =============================================================

is_new_day = ta.change(time("D")) != 0

var float cur_dh = na
var float cur_dl = na
var float pdh    = na
var float pdl    = na

if is_new_day
    pdh    := cur_dh
    pdl    := cur_dl
    cur_dh := high
    cur_dl := low
else
    cur_dh := na(cur_dh) ? high : math.max(cur_dh, high)
    cur_dl := na(cur_dl) ? low  : math.min(cur_dl, low)

// =============================================================
// PREVIOUS WEEK HIGH / LOW
// =============================================================

is_new_week = ta.change(time("W")) != 0

var float cur_wh = na
var float cur_wl = na
var float pwh    = na
var float pwl    = na

if is_new_week
    pwh    := cur_wh
    pwl    := cur_wl
    cur_wh := high
    cur_wl := low
else
    cur_wh := na(cur_wh) ? high : math.max(cur_wh, high)
    cur_wl := na(cur_wl) ? low  : math.min(cur_wl, low)

// =============================================================
// ASIA RANGE  (22:00 - 07:00 UTC)
// =============================================================

in_asia = h_utc >= 22 or h_utc < 7

var float asia_live_h = na
var float asia_live_l = na
var float asia_h      = na
var float asia_l      = na

if in_asia
    asia_live_h := na(asia_live_h) ? high : math.max(asia_live_h, high)
    asia_live_l := na(asia_live_l) ? low  : math.min(asia_live_l, low)
else if in_asia[1]
    asia_h      := asia_live_h
    asia_l      := asia_live_l
    asia_live_h := na
    asia_live_l := na

asia_closed = not in_asia and in_asia[1]

// =============================================================
// SWING HIGHS / LOWS
// =============================================================

raw_swh = ta.pivothigh(high, sw_len, sw_len)
raw_swl = ta.pivotlow(low,  sw_len, sw_len)

var float last_swh = na
var float last_swl = na

if not na(raw_swh)
    last_swh := raw_swh
if not na(raw_swl)
    last_swl := raw_swl

// =============================================================
// EQUAL HIGHS / LOWS
// =============================================================

var float[] swh_hist = array.new_float(0)
var float[] swl_hist = array.new_float(0)
var float   last_eqh = na
var float   last_eql = na

eqh_new = false
eql_new = false

if use_eql and eql_tf_ok and not na(raw_swh)
    sz = array.size(swh_hist)
    if sz > 0
        for i = 0 to sz - 1
            if math.abs(raw_swh - array.get(swh_hist, i)) <= eql_tol
                eqh_new  := true
                last_eqh := raw_swh
                break
    if array.size(swh_hist) >= eql_lookback
        array.shift(swh_hist)
    array.push(swh_hist, raw_swh)

if use_eql and eql_tf_ok and not na(raw_swl)
    sz = array.size(swl_hist)
    if sz > 0
        for i = 0 to sz - 1
            if math.abs(raw_swl - array.get(swl_hist, i)) <= eql_tol
                eql_new  := true
                last_eql := raw_swl
                break
    if array.size(swl_hist) >= eql_lookback
        array.shift(swl_hist)
    array.push(swl_hist, raw_swl)

// =============================================================
// TIERED RISK ENGINE
// =============================================================

var int attempt = 1

f_risk(int a) =>
    a == 1 ? r1 : a == 2 ? r2 : a == 3 ? r3 : a == 4 ? r4 : a == 5 ? r5 : r6

was_in_trade = strategy.position_size[1] != 0 and strategy.position_size == 0
if was_in_trade
    n = strategy.closedtrades - 1
    if n >= 0
        last_profit = strategy.closedtrades.profit(n)
        attempt    := last_profit > 0 ? 1 : math.min(attempt + 1, 6)

f_qty(float sl_dist) =>
    sl_dist > 0.0 ? (fixed_cap * f_risk(attempt)) / sl_dist : 0.0

poi_in_rng(float px) =>
    not na(px) and math.abs(close - px) <= max_poi_dist

// =============================================================
// CANDLE BODY + ENGULFING
// =============================================================

is_bull = close > open
is_bear = close < open
body_hi = math.max(open, close)
body_lo = math.min(open, close)

prev_body_hi = math.max(open[1], close[1])
prev_body_lo = math.min(open[1], close[1])

bear_engulf = is_bear and body_hi > prev_body_hi and body_lo < prev_body_lo
bull_engulf = is_bull and body_hi > prev_body_hi and body_lo < prev_body_lo

// =============================================================
// STATE MACHINE
// 0 = IDLE | 1 = BEAR_SWEPT | 2 = BULL_SWEPT
// 3 = BEAR_FVG | 4 = BULL_FVG
// =============================================================

var int   state        = 0
var int   state_bar    = 0
var float sweep_hi     = na
var float sweep_lo     = na
var float mss_ref_bear = na
var float mss_ref_bull = na
var float fvg_top      = na
var float fvg_bot      = na
var int   fvg_bar      = 0
var bool  mss_bear_ok  = false
var bool  mss_bull_ok  = false
var float pre_swl      = na
var float pre_swh      = na

var box fvg_entry_box = na
var box htf_b1h_box   = na
var box htf_u1h_box   = na
var box htf_b4h_box   = na
var box htf_u4h_box   = na
var box htf_bd_box    = na
var box htf_ud_box    = na
var box htf_bw_box    = na
var box htf_uw_box    = na
var box htf_bm_box    = na
var box htf_um_box    = na

var bool prev_bear_1h = false
var bool prev_bull_1h = false
var bool prev_bear_4h = false
var bool prev_bull_4h = false
var bool prev_bear_d  = false
var bool prev_bull_d  = false
var bool prev_bear_w  = false
var bool prev_bull_w  = false
var bool prev_bear_m  = false
var bool prev_bull_m  = false

if state == 0
    if not na(raw_swl)
        pre_swl := raw_swl
    if not na(raw_swh)
        pre_swh := raw_swh

f_high_sweep(float lvl) =>
    not na(lvl) and high > (lvl + sweep_buf) and body_hi < lvl and is_bear

f_low_sweep(float lvl) =>
    not na(lvl) and low < (lvl - sweep_buf) and body_lo > lvl and is_bull

hs_pdh  = use_pdhl and f_high_sweep(pdh)
hs_pwh  = use_pwhl and f_high_sweep(pwh)
hs_asia = use_asia and f_high_sweep(asia_h)
hs_eqh  = use_eql  and f_high_sweep(last_eqh)

ls_pdl  = use_pdhl and f_low_sweep(pdl)
ls_pwl  = use_pwhl and f_low_sweep(pwl)
ls_asia = use_asia and f_low_sweep(asia_l)
ls_eql  = use_eql  and f_low_sweep(last_eql)

htf_ok_bear = not use_htf or htf_bear
htf_ok_bull = not use_htf or htf_bull

any_hs = (hs_pdh or hs_pwh or hs_asia or hs_eqh) and htf_ok_bear and can_trade and in_kz
any_ls = (ls_pdl or ls_pwl or ls_asia or ls_eql)  and htf_ok_bull and can_trade and in_kz

if state == 0 and any_hs
    state        := 1
    sweep_hi     := high
    mss_ref_bear := na(pre_swl) ? low : pre_swl
    state_bar    := bar_index

if state == 0 and any_ls
    state        := 2
    sweep_lo     := low
    mss_ref_bull := na(pre_swh) ? high : pre_swh
    state_bar    := bar_index

if (state == 1 or state == 2) and (bar_index - state_bar) > mss_max_bars
    state := 0

bear_mss = state == 1 and not na(mss_ref_bear) and body_lo < mss_ref_bear and is_bear
bull_mss = state == 2 and not na(mss_ref_bull) and body_hi > mss_ref_bull and is_bull

if bear_mss
    mss_bear_ok := true
    state       := 3
    state_bar   := bar_index

if bull_mss
    mss_bull_ok := true
    state       := 4
    state_bar   := bar_index

if mss_bear_ok[1]
    bear_gap = low[2] - high
    if bear_gap >= fvg_min_gap
        fvg_top := low[2]
        fvg_bot := high
        fvg_bar := bar_index
        box.delete(fvg_entry_box)
        fvg_entry_box := box.new(bar_index - 2, fvg_top, bar_index + 1, fvg_bot,
             border_color = color.new(color.red, 10),
             bgcolor      = color.new(color.red, 80),
             text         = "FVG",
             text_color   = color.new(color.red, 20),
             text_size    = size.small,
             text_halign  = text.align_left,
             text_valign  = text.align_top)
    else
        state := 0
    mss_bear_ok := false

if mss_bull_ok[1]
    bull_gap = low - high[2]
    if bull_gap >= fvg_min_gap
        fvg_top := low
        fvg_bot := high[2]
        fvg_bar := bar_index
        box.delete(fvg_entry_box)
        fvg_entry_box := box.new(bar_index - 2, fvg_top, bar_index + 1, fvg_bot,
             border_color = color.new(color.teal, 10),
             bgcolor      = color.new(color.teal, 80),
             text         = "FVG",
             text_color   = color.new(color.teal, 20),
             text_size    = size.small,
             text_halign  = text.align_left,
             text_valign  = text.align_top)
    else
        state := 0
    mss_bull_ok := false

if (state == 3 or state == 4) and not na(fvg_entry_box)
    box.set_right(fvg_entry_box, bar_index + 5)

if (state == 3 or state == 4) and (bar_index - fvg_bar) > fvg_max_bars
    box.delete(fvg_entry_box)
    state := 0

// =============================================================
// ENTRY CONDITIONS
// =============================================================

in_bear_fvg = state == 3 and not na(fvg_top) and not na(fvg_bot)
in_bull_fvg = state == 4 and not na(fvg_top) and not na(fvg_bot)

touched_bear = in_bear_fvg and high >= fvg_bot and low <= fvg_top
touched_bull = in_bull_fvg and low  <= fvg_top and high >= fvg_bot

close_ok_bear  = req_close_fvg ? (close >= fvg_bot and close <= fvg_top and is_bear) : is_bear
close_ok_bull  = req_close_fvg ? (close >= fvg_bot and close <= fvg_top and is_bull) : is_bull
engulf_ok_bear = not req_engulf or bear_engulf
engulf_ok_bull = not req_engulf or bull_engulf

short_signal = touched_bear and close_ok_bear and engulf_ok_bear and in_kz and can_trade
long_signal  = touched_bull and close_ok_bull  and engulf_ok_bull and in_kz and can_trade

// =============================================================
// ORDER EXECUTION
// =============================================================

if short_signal
    sl_price = sweep_hi + sweep_buf
    tp_price = close - (sl_price - close) * rr_ratio
    sl_dist  = sl_price - close
    if sl_dist >= min_sl and sl_dist <= max_sl
        qty = f_qty(sl_dist)
        if qty > 0
            strategy.entry("Short", strategy.short, qty = qty, comment = "SMC Short")
            strategy.exit("SX", from_entry = "Short", stop = sl_price, limit = tp_price)
            trades_today += 1
            state := 0
            if not na(fvg_entry_box)
                box.set_right(fvg_entry_box, bar_index)

if long_signal
    sl_price = sweep_lo - sweep_buf
    tp_price = close + (close - sl_price) * rr_ratio
    sl_dist  = close - sl_price
    if sl_dist >= min_sl and sl_dist <= max_sl
        qty = f_qty(sl_dist)
        if qty > 0
            strategy.entry("Long", strategy.long, qty = qty, comment = "SMC Long")
            strategy.exit("LX", from_entry = "Long", stop = sl_price, limit = tp_price)
            trades_today += 1
            state := 0
            if not na(fvg_entry_box)
                box.set_right(fvg_entry_box, bar_index)

// =============================================================
// VISUALS
// =============================================================

bgcolor(show_kz_bg and in_london ? color.new(color.blue,   95) : na, title = "London KZ")
bgcolor(show_kz_bg and in_ny     ? color.new(color.yellow, 95) : na, title = "NY KZ")

// =============================================================
// POI LINE MANAGER — rebuilt every bar with merge logic
// =============================================================

var line[]  managed_poi_lines  = array.new<line>(0)
var label[] managed_poi_labels = array.new<label>(0)

var bool pdh_swept    = false
var bool pdl_swept    = false
var bool pwh_swept    = false
var bool pwl_swept    = false
var bool asia_h_swept = false
var bool asia_l_swept = false
var bool eqh_swept    = false
var bool eql_swept    = false

if is_new_day
    pdh_swept := false
    pdl_swept := false
if is_new_week
    pwh_swept := false
    pwl_swept := false
if asia_closed
    asia_h_swept := false
    asia_l_swept := false
if eqh_new
    eqh_swept := false
if eql_new
    eql_swept := false

if not na(pdh) and not pdh_swept and high >= pdh
    pdh_swept := true
if not na(pdl) and not pdl_swept and low <= pdl
    pdl_swept := true
if not na(pwh) and not pwh_swept and high >= pwh
    pwh_swept := true
if not na(pwl) and not pwl_swept and low <= pwl
    pwl_swept := true
if not na(asia_h) and not asia_h_swept and high >= asia_h
    asia_h_swept := true
if not na(asia_l) and not asia_l_swept and low <= asia_l
    asia_l_swept := true
if not na(last_eqh) and not eqh_swept and high >= last_eqh
    eqh_swept := true
if not na(last_eql) and not eql_swept and low <= last_eql
    eql_swept := true

// Delete all managed drawings from previous bar
n_ml = array.size(managed_poi_lines)
if n_ml > 0
    for i = 0 to n_ml - 1
        line.delete(array.get(managed_poi_lines, i))
array.clear(managed_poi_lines)
n_mlb = array.size(managed_poi_labels)
if n_mlb > 0
    for i = 0 to n_mlb - 1
        label.delete(array.get(managed_poi_labels, i))
array.clear(managed_poi_labels)

if show_levels
    poi_px = array.new_float(0)
    poi_nm = array.new_string(0)
    poi_cl = array.new<color>(0)
    poi_st = array.new_string(0)
    poi_pr = array.new_int(0)

    if use_pdhl
        if poi_in_rng(pdh) and not pdh_swept
            array.push(poi_px, pdh)
            array.push(poi_nm, "PDH")
            array.push(poi_cl, color.new(color.red,    0))
            array.push(poi_st, line.style_dashed)
            array.push(poi_pr, 10)
        if poi_in_rng(pdl) and not pdl_swept
            array.push(poi_px, pdl)
            array.push(poi_nm, "PDL")
            array.push(poi_cl, color.new(color.teal,   0))
            array.push(poi_st, line.style_dashed)
            array.push(poi_pr, 11)
    if use_pwhl
        if poi_in_rng(pwh) and not pwh_swept
            array.push(poi_px, pwh)
            array.push(poi_nm, "PWH")
            array.push(poi_cl, color.new(color.maroon, 0))
            array.push(poi_st, line.style_solid)
            array.push(poi_pr, 20)
        if poi_in_rng(pwl) and not pwl_swept
            array.push(poi_px, pwl)
            array.push(poi_nm, "PWL")
            array.push(poi_cl, color.new(color.navy,   0))
            array.push(poi_st, line.style_solid)
            array.push(poi_pr, 21)
    if use_asia
        if poi_in_rng(asia_h) and not asia_h_swept
            array.push(poi_px, asia_h)
            array.push(poi_nm, "Asia H")
            array.push(poi_cl, color.new(color.purple, 0))
            array.push(poi_st, line.style_dotted)
            array.push(poi_pr, 30)
        if poi_in_rng(asia_l) and not asia_l_swept
            array.push(poi_px, asia_l)
            array.push(poi_nm, "Asia L")
            array.push(poi_cl, color.new(color.purple, 0))
            array.push(poi_st, line.style_dotted)
            array.push(poi_pr, 31)
    if use_eql and eql_tf_ok
        if poi_in_rng(last_eqh) and not eqh_swept
            array.push(poi_px, last_eqh)
            array.push(poi_nm, "EQH")
            array.push(poi_cl, color.new(color.orange, 0))
            array.push(poi_st, line.style_dashed)
            array.push(poi_pr, 40)
        if poi_in_rng(last_eql) and not eql_swept
            array.push(poi_px, last_eql)
            array.push(poi_nm, "EQL")
            array.push(poi_cl, color.new(color.orange, 0))
            array.push(poi_st, line.style_dashed)
            array.push(poi_pr, 41)

    n_poi = array.size(poi_px)
    if n_poi > 0
        sorted_idx = array.sort_indices(poi_px, order.ascending)
        used_flags = array.new_bool(n_poi, false)

        for ii = 0 to n_poi - 1
            si = array.get(sorted_idx, ii)
            if array.get(used_flags, si)
                continue
            g_px = array.get(poi_px, si)
            g_nm = array.get(poi_nm, si)
            g_cl = array.get(poi_cl, si)
            g_st = array.get(poi_st, si)
            g_pr = array.get(poi_pr, si)
            array.set(used_flags, si, true)

            if ii < n_poi - 1
              for jj = ii + 1 to n_poi - 1
                sj = array.get(sorted_idx, jj)
                if array.get(used_flags, sj)
                    continue
                pj = array.get(poi_px, sj)
                if pj - g_px > merge_tol
                    break
                prj = array.get(poi_pr, sj)
                nmj = array.get(poi_nm, sj)
                if prj < g_pr
                    g_nm := nmj + " + " + g_nm
                    g_cl := array.get(poi_cl, sj)
                    g_st := array.get(poi_st, sj)
                    g_pr := prj
                else
                    g_nm := g_nm + " + " + nmj
                array.set(used_flags, sj, true)

            new_l  = line.new(bar_index - 1, g_px, bar_index, g_px, extend = extend.right, color = g_cl, style = g_st, width = 1)
            new_lb = label.new(bar_index, g_px, g_nm, style = label.style_none, textcolor = g_cl, size = size.small)
            array.push(managed_poi_lines,  new_l)
            array.push(managed_poi_labels, new_lb)

// Sweep markers
plotshape(show_sweep and any_hs, title = "Sweep HIGH", style = shape.circle, location = location.abovebar, color = color.new(color.red,  0), size = size.tiny)
plotshape(show_sweep and any_ls, title = "Sweep LOW",  style = shape.circle, location = location.belowbar, color = color.new(color.teal, 0), size = size.tiny)

// =============================================================
// HTF FVG BOXES — create on new edge, delete on invalidation
// Distance-filtered on creation and each bar (no chart distortion)
// =============================================================

new_bear_1h  = htf_bear_1h and not prev_bear_1h
gone_bear_1h = not htf_bear_1h and prev_bear_1h
new_bull_1h  = htf_bull_1h and not prev_bull_1h
gone_bull_1h = not htf_bull_1h and prev_bull_1h
new_bear_4h  = htf_bear_4h and not prev_bear_4h
gone_bear_4h = not htf_bear_4h and prev_bear_4h
new_bull_4h  = htf_bull_4h and not prev_bull_4h
gone_bull_4h = not htf_bull_4h and prev_bull_4h
new_bear_d   = htf_bear_d  and not prev_bear_d
gone_bear_d  = not htf_bear_d  and prev_bear_d
new_bull_d   = htf_bull_d  and not prev_bull_d
gone_bull_d  = not htf_bull_d  and prev_bull_d
new_bear_w   = htf_bear_w  and not prev_bear_w
gone_bear_w  = not htf_bear_w  and prev_bear_w
new_bull_w   = htf_bull_w  and not prev_bull_w
gone_bull_w  = not htf_bull_w  and prev_bull_w
new_bear_m   = htf_bear_m  and not prev_bear_m
gone_bear_m  = not htf_bear_m  and prev_bear_m
new_bull_m   = htf_bull_m  and not prev_bull_m
gone_bull_m  = not htf_bull_m  and prev_bull_m

prev_bear_1h := htf_bear_1h
prev_bull_1h := htf_bull_1h
prev_bear_4h := htf_bear_4h
prev_bull_4h := htf_bull_4h
prev_bear_d  := htf_bear_d
prev_bull_d  := htf_bull_d
prev_bear_w  := htf_bear_w
prev_bull_w  := htf_bull_w
prev_bear_m  := htf_bear_m
prev_bull_m  := htf_bull_m

if show_levels
    // --- 1H ---
    if use_htf_1h
        if new_bear_1h
            box.delete(htf_b1h_box)
            htf_b1h_box := na
            if math.abs(close - (h1_l2 + h1_h0) / 2) <= max_poi_dist
                htf_b1h_box := box.new(bar_index, h1_l2, bar_index + 1, h1_h0, border_color = color.new(color.red, 30), bgcolor = color.new(color.red, 87), text = "1H", text_color = color.new(color.red, 20), text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)
        if gone_bear_1h
            box.delete(htf_b1h_box)
            htf_b1h_box := na
        if htf_bear_1h and not na(htf_b1h_box)
            b_bot = box.get_bottom(htf_b1h_box)
            b_mid = (box.get_top(htf_b1h_box) + b_bot) / 2
            if high >= b_bot or math.abs(close - b_mid) > max_poi_dist
                box.delete(htf_b1h_box)
                htf_b1h_box := na
            else
                box.set_right(htf_b1h_box, bar_index + 5)
        if new_bull_1h
            box.delete(htf_u1h_box)
            htf_u1h_box := na
            if math.abs(close - (h1_l0 + h1_h2) / 2) <= max_poi_dist
                htf_u1h_box := box.new(bar_index, h1_l0, bar_index + 1, h1_h2, border_color = color.new(color.teal, 30), bgcolor = color.new(color.teal, 87), text = "1H", text_color = color.new(color.teal, 20), text_size = size.small, text_halign = text.align_right, text_valign = text.align_bottom)
        if gone_bull_1h
            box.delete(htf_u1h_box)
            htf_u1h_box := na
        if htf_bull_1h and not na(htf_u1h_box)
            b_top = box.get_top(htf_u1h_box)
            b_mid = (b_top + box.get_bottom(htf_u1h_box)) / 2
            if low <= b_top or math.abs(close - b_mid) > max_poi_dist
                box.delete(htf_u1h_box)
                htf_u1h_box := na
            else
                box.set_right(htf_u1h_box, bar_index + 5)

    // --- 4H ---
    if use_htf_4h
        if new_bear_4h
            box.delete(htf_b4h_box)
            htf_b4h_box := na
            if math.abs(close - (h2_l2 + h2_h0) / 2) <= max_poi_dist
                htf_b4h_box := box.new(bar_index, h2_l2, bar_index + 1, h2_h0, border_color = color.new(color.red, 20), bgcolor = color.new(color.red, 84), text = "4H", text_color = color.new(color.red, 10), text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)
        if gone_bear_4h
            box.delete(htf_b4h_box)
            htf_b4h_box := na
        if htf_bear_4h and not na(htf_b4h_box)
            b_bot = box.get_bottom(htf_b4h_box)
            b_mid = (box.get_top(htf_b4h_box) + b_bot) / 2
            if high >= b_bot or math.abs(close - b_mid) > max_poi_dist
                box.delete(htf_b4h_box)
                htf_b4h_box := na
            else
                box.set_right(htf_b4h_box, bar_index + 5)
        if new_bull_4h
            box.delete(htf_u4h_box)
            htf_u4h_box := na
            if math.abs(close - (h2_l0 + h2_h2) / 2) <= max_poi_dist
                htf_u4h_box := box.new(bar_index, h2_l0, bar_index + 1, h2_h2, border_color = color.new(color.teal, 20), bgcolor = color.new(color.teal, 84), text = "4H", text_color = color.new(color.teal, 10), text_size = size.small, text_halign = text.align_right, text_valign = text.align_bottom)
        if gone_bull_4h
            box.delete(htf_u4h_box)
            htf_u4h_box := na
        if htf_bull_4h and not na(htf_u4h_box)
            b_top = box.get_top(htf_u4h_box)
            b_mid = (b_top + box.get_bottom(htf_u4h_box)) / 2
            if low <= b_top or math.abs(close - b_mid) > max_poi_dist
                box.delete(htf_u4h_box)
                htf_u4h_box := na
            else
                box.set_right(htf_u4h_box, bar_index + 5)

    // --- Daily ---
    if use_htf_d
        if new_bear_d
            box.delete(htf_bd_box)
            htf_bd_box := na
            if math.abs(close - (h3_l2 + h3_h0) / 2) <= max_poi_dist
                htf_bd_box := box.new(bar_index, h3_l2, bar_index + 1, h3_h0, border_color = color.new(color.red, 10), bgcolor = color.new(color.red, 80), text = "D", text_color = color.new(color.red, 0), text_size = size.normal, text_halign = text.align_right, text_valign = text.align_top)
        if gone_bear_d
            box.delete(htf_bd_box)
            htf_bd_box := na
        if htf_bear_d and not na(htf_bd_box)
            b_bot = box.get_bottom(htf_bd_box)
            b_mid = (box.get_top(htf_bd_box) + b_bot) / 2
            if high >= b_bot or math.abs(close - b_mid) > max_poi_dist
                box.delete(htf_bd_box)
                htf_bd_box := na
            else
                box.set_right(htf_bd_box, bar_index + 5)
        if new_bull_d
            box.delete(htf_ud_box)
            htf_ud_box := na
            if math.abs(close - (h3_l0 + h3_h2) / 2) <= max_poi_dist
                htf_ud_box := box.new(bar_index, h3_l0, bar_index + 1, h3_h2, border_color = color.new(color.teal, 10), bgcolor = color.new(color.teal, 80), text = "D", text_color = color.new(color.teal, 0), text_size = size.normal, text_halign = text.align_right, text_valign = text.align_bottom)
        if gone_bull_d
            box.delete(htf_ud_box)
            htf_ud_box := na
        if htf_bull_d and not na(htf_ud_box)
            b_top = box.get_top(htf_ud_box)
            b_mid = (b_top + box.get_bottom(htf_ud_box)) / 2
            if low <= b_top or math.abs(close - b_mid) > max_poi_dist
                box.delete(htf_ud_box)
                htf_ud_box := na
            else
                box.set_right(htf_ud_box, bar_index + 5)

    // --- Weekly ---
    if use_htf_w
        if new_bear_w
            box.delete(htf_bw_box)
            htf_bw_box := na
            if math.abs(close - (hw_l2 + hw_h0) / 2) <= max_poi_dist
                htf_bw_box := box.new(bar_index, hw_l2, bar_index + 1, hw_h0, border_color = color.new(color.red, 5), bgcolor = color.new(color.red, 75), text = "W", text_color = color.new(color.red, 0), text_size = size.normal, text_halign = text.align_right, text_valign = text.align_top)
        if gone_bear_w
            box.delete(htf_bw_box)
            htf_bw_box := na
        if htf_bear_w and not na(htf_bw_box)
            b_bot = box.get_bottom(htf_bw_box)
            b_mid = (box.get_top(htf_bw_box) + b_bot) / 2
            if high >= b_bot or math.abs(close - b_mid) > max_poi_dist
                box.delete(htf_bw_box)
                htf_bw_box := na
            else
                box.set_right(htf_bw_box, bar_index + 5)
        if new_bull_w
            box.delete(htf_uw_box)
            htf_uw_box := na
            if math.abs(close - (hw_l0 + hw_h2) / 2) <= max_poi_dist
                htf_uw_box := box.new(bar_index, hw_l0, bar_index + 1, hw_h2, border_color = color.new(color.teal, 5), bgcolor = color.new(color.teal, 75), text = "W", text_color = color.new(color.teal, 0), text_size = size.normal, text_halign = text.align_right, text_valign = text.align_bottom)
        if gone_bull_w
            box.delete(htf_uw_box)
            htf_uw_box := na
        if htf_bull_w and not na(htf_uw_box)
            b_top = box.get_top(htf_uw_box)
            b_mid = (b_top + box.get_bottom(htf_uw_box)) / 2
            if low <= b_top or math.abs(close - b_mid) > max_poi_dist
                box.delete(htf_uw_box)
                htf_uw_box := na
            else
                box.set_right(htf_uw_box, bar_index + 5)

    // --- Monthly ---
    if use_htf_m
        if new_bear_m
            box.delete(htf_bm_box)
            htf_bm_box := na
            if math.abs(close - (hm_l2 + hm_h0) / 2) <= max_poi_dist
                htf_bm_box := box.new(bar_index, hm_l2, bar_index + 1, hm_h0, border_color = color.new(color.red, 0), bgcolor = color.new(color.red, 70), text = "MN", text_color = color.new(color.red, 0), text_size = size.normal, text_halign = text.align_right, text_valign = text.align_top)
        if gone_bear_m
            box.delete(htf_bm_box)
            htf_bm_box := na
        if htf_bear_m and not na(htf_bm_box)
            b_bot = box.get_bottom(htf_bm_box)
            b_mid = (box.get_top(htf_bm_box) + b_bot) / 2
            if high >= b_bot or math.abs(close - b_mid) > max_poi_dist
                box.delete(htf_bm_box)
                htf_bm_box := na
            else
                box.set_right(htf_bm_box, bar_index + 5)
        if new_bull_m
            box.delete(htf_um_box)
            htf_um_box := na
            if math.abs(close - (hm_l0 + hm_h2) / 2) <= max_poi_dist
                htf_um_box := box.new(bar_index, hm_l0, bar_index + 1, hm_h2, border_color = color.new(color.teal, 0), bgcolor = color.new(color.teal, 70), text = "MN", text_color = color.new(color.teal, 0), text_size = size.normal, text_halign = text.align_right, text_valign = text.align_bottom)
        if gone_bull_m
            box.delete(htf_um_box)
            htf_um_box := na
        if htf_bull_m and not na(htf_um_box)
            b_top = box.get_top(htf_um_box)
            b_mid = (b_top + box.get_bottom(htf_um_box)) / 2
            if low <= b_top or math.abs(close - b_mid) > max_poi_dist
                box.delete(htf_um_box)
                htf_um_box := na
            else
                box.set_right(htf_um_box, bar_index + 5)

// =============================================================
// FVG IMBALANCE VISUALIZATION
// =============================================================

var box[] bear_fvg_arr = array.new<box>(0)
var box[] bull_fvg_arr = array.new<box>(0)

if show_fvg_vis
    bear_vis_gap = low[2] - high
    if bear_vis_gap >= fvg_min_gap
        nb = box.new(bar_index - 2, low[2], bar_index + 1, high,
             border_color = color.new(color.red,  65),
             bgcolor      = color.new(color.red,  90),
             text         = "IMB",
             text_color   = color.new(color.red,  40),
             text_size    = size.small,
             text_halign  = text.align_center,
             text_valign  = text.align_center)
        array.push(bear_fvg_arr, nb)
        if array.size(bear_fvg_arr) > 20
            box.delete(array.shift(bear_fvg_arr))

    bull_vis_gap = low - high[2]
    if bull_vis_gap >= fvg_min_gap
        nb = box.new(bar_index - 2, low, bar_index + 1, high[2],
             border_color = color.new(color.teal, 65),
             bgcolor      = color.new(color.teal, 90),
             text         = "IMB",
             text_color   = color.new(color.teal, 40),
             text_size    = size.small,
             text_halign  = text.align_center,
             text_valign  = text.align_center)
        array.push(bull_fvg_arr, nb)
        if array.size(bull_fvg_arr) > 20
            box.delete(array.shift(bull_fvg_arr))

    n_bear = array.size(bear_fvg_arr)
    if n_bear > 0
        for j = 0 to n_bear - 1
            i = n_bear - 1 - j
            b = array.get(bear_fvg_arr, i)
            if high >= box.get_bottom(b)
                box.delete(b)
                array.remove(bear_fvg_arr, i)
            else
                box.set_right(b, bar_index + 5)

    n_bull = array.size(bull_fvg_arr)
    if n_bull > 0
        for j = 0 to n_bull - 1
            i = n_bull - 1 - j
            b = array.get(bull_fvg_arr, i)
            if low <= box.get_top(b)
                box.delete(b)
                array.remove(bull_fvg_arr, i)
            else
                box.set_right(b, bar_index + 5)

// Entry signals
plotshape(short_signal, title = "Short Entry", style = shape.labeldown, location = location.abovebar, color = color.red,  textcolor = color.white, text = "SHORT", size = size.small)
plotshape(long_signal,  title = "Long Entry",  style = shape.labelup,   location = location.belowbar, color = color.teal, textcolor = color.white, text = "LONG",  size = size.small)

// =============================================================
// INFO TABLE  (top right)
// =============================================================

var table tbl = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 75), border_width = 1, border_color = color.gray)

if barstate.islast
    table.cell(tbl, 0, 0, "SMC v4 EURUSD", text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.normal)
    table.cell(tbl, 1, 0, "",               text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.normal)

    st_str = switch state
        0 => "IDLE"
        1 => "SWEPT DN"
        2 => "SWEPT UP"
        3 => "FVG SHORT"
        => "FVG LONG"

    st_col = switch
        state == 0               => color.gray
        state == 1 or state == 2 => color.orange
        state == 3               => color.red
        =>                          color.teal

    table.cell(tbl, 0, 1, "State",   text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 1, st_str,    text_color = st_col,     text_size = size.small)

    rsk_pct = str.tostring(f_risk(attempt) * 100, "#.##")
    rsk_str = str.tostring(attempt) + "/6 (" + rsk_pct + "%)"
    rsk_col = switch
        attempt == 1 => color.lime
        attempt <= 3 => color.yellow
        =>              color.red

    table.cell(tbl, 0, 2, "Attempt", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 2, rsk_str,   text_color = rsk_col,    text_size = size.small)

    td_str = str.tostring(trades_today) + "/" + str.tostring(max_day_tr)
    td_col = trades_today >= max_day_tr ? color.red : color.lime
    table.cell(tbl, 0, 3, "Trades Today", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 3, td_str,         text_color = td_col,     text_size = size.small)

    kz_str = switch
        in_london => "London"
        in_ny     => "New York"
        =>            "OFF"
    kz_col = in_kz ? color.lime : color.red
    table.cell(tbl, 0, 4, "Kill Zone", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 4, kz_str,      text_color = kz_col,     text_size = size.small)

    bias_str = switch
        htf_bear and not htf_bull => "BEAR"
        htf_bull and not htf_bear => "BULL"
        =>                           "NEUTRAL"
    bias_col = switch
        htf_bear and not htf_bull => color.red
        htf_bull and not htf_bear => color.teal
        =>                           color.gray
    table.cell(tbl, 0, 5, "HTF Bias", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 5, bias_str,   text_color = bias_col,   text_size = size.small)

    pdhl_val = not na(pdh) ? str.tostring(pdh, "#.#####") + "/" + str.tostring(pdl, "#.#####") : "--"
    table.cell(tbl, 0, 6, "PDH/PDL", text_color = color.gray,  text_size = size.small)
    table.cell(tbl, 1, 6, pdhl_val,  text_color = color.orange, text_size = size.small)

    pwhl_val = not na(pwh) ? str.tostring(pwh, "#.#####") + "/" + str.tostring(pwl, "#.#####") : "--"
    table.cell(tbl, 0, 7, "PWH/PWL", text_color = color.gray,  text_size = size.small)
    table.cell(tbl, 1, 7, pwhl_val,  text_color = color.maroon, text_size = size.small)

    fvg_active = (state == 3 or state == 4) and not na(fvg_top)
    fvg_val    = fvg_active ? str.tostring(fvg_top, "#.#####") + "/" + str.tostring(fvg_bot, "#.#####") : "--"
    table.cell(tbl, 0, 8, "FVG Zone", text_color = color.gray,  text_size = size.small)
    table.cell(tbl, 1, 8, fvg_val,    text_color = color.yellow, text_size = size.small)

// =============================================================
// STATS TABLE  (top left)
// =============================================================

var table stats = table.new(position.top_left, 2, 9, bgcolor = color.new(color.black, 75), border_width = 1, border_color = color.gray)

if barstate.islast
    n_closed = strategy.closedtrades
    n_wins   = strategy.wintrades
    n_loss   = strategy.losstrades
    win_rate = n_closed > 0 ? (n_wins / n_closed) * 100.0 : 0.0
    avg_win  = n_wins > 0  ? strategy.grossprofit / n_wins : 0.0
    avg_loss = n_loss > 0  ? math.abs(strategy.grossloss) / n_loss : 0.0
    pf       = strategy.grossloss != 0.0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0.0
    expect   = n_closed > 0 ? (win_rate / 100.0) * (avg_win / math.max(avg_loss, 0.01)) - (1.0 - win_rate / 100.0) : 0.0

    table.cell(stats, 0, 0, "STATISTICS", text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.normal)
    table.cell(stats, 1, 0, "",           text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.normal)

    table.cell(stats, 0, 1, "Trades",  text_color = color.gray,  text_size = size.small)
    table.cell(stats, 1, 1, str.tostring(n_closed) + "  " + str.tostring(n_wins) + "W/" + str.tostring(n_loss) + "L", text_color = color.white, text_size = size.small)

    wr_col = win_rate >= 50.0 ? color.lime : color.red
    table.cell(stats, 0, 2, "Win Rate",     text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 2, str.tostring(win_rate, "#.#") + "%", text_color = wr_col, text_size = size.small)

    pf_col = pf >= 1.5 ? color.lime : pf >= 1.0 ? color.yellow : color.red
    table.cell(stats, 0, 3, "Profit Factor", text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 3, str.tostring(pf, "#.##"),              text_color = pf_col,    text_size = size.small)

    net_pnl = strategy.netprofit
    pnl_col = net_pnl >= 0.0 ? color.lime : color.red
    table.cell(stats, 0, 4, "Net P&L",   text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 4, str.tostring(net_pnl, "#.##"), text_color = pnl_col, text_size = size.small)

    table.cell(stats, 0, 5, "Max DD",    text_color = color.gray,   text_size = size.small)
    table.cell(stats, 1, 5, str.tostring(strategy.max_drawdown, "#.##"), text_color = color.orange, text_size = size.small)

    table.cell(stats, 0, 6, "Avg Win",   text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 6, str.tostring(avg_win,  "#.##"), text_color = color.lime, text_size = size.small)

    table.cell(stats, 0, 7, "Avg Loss",  text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 7, str.tostring(avg_loss, "#.##"), text_color = color.red,  text_size = size.small)

    exp_col = expect >= 0.0 ? color.lime : color.red
    table.cell(stats, 0, 8, "Expectancy", text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 8, str.tostring(expect, "#.###") + "R",  text_color = exp_col, text_size = size.small)

// =============================================================
// ALERTS
// =============================================================

alertcondition(any_hs,       title = "Sweep HIGH",         message = "Sweep HIGH - watch for bearish MSS")
alertcondition(any_ls,       title = "Sweep LOW",          message = "Sweep LOW - watch for bullish MSS")
alertcondition(bear_mss,     title = "MSS Bear Confirmed", message = "Bearish MSS confirmed - FVG active")
alertcondition(bull_mss,     title = "MSS Bull Confirmed", message = "Bullish MSS confirmed - FVG active")
alertcondition(short_signal, title = "SHORT Entry",        message = "SMC SHORT | Engulfing FVG retest | Entry: {{close}}")
alertcondition(long_signal,  title = "LONG Entry",         message = "SMC LONG  | Engulfing FVG retest | Entry: {{close}}")
alertcondition(eqh_new,      title = "EQH Formed",         message = "Equal High detected - liquidity pool above")
alertcondition(eql_new,      title = "EQL Formed",         message = "Equal Low detected - liquidity pool below")
