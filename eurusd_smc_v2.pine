// This Pine Script(tm) code is subject to the terms of the Mozilla Public License 2.0
// SMC EURUSD v4 | Sweep HTF POI > 1M MSS > FVG + Engulfing Entry
// HTF Bias: Monthly/Weekly/Daily/4H/1H FVG | POIs: PDH/PDL, PWH/PWL, Asia, EQH/EQL
// Kill Zones: Asia 00:00-08:00 | London 09:00-11:00 | NY 14:00-16:30 (UTC+2)
// Risk: Tiered non-compounded 0.7%-2.0% | SL=sweep wick | TP=SLxRR

//@version=6
strategy(
    title             = "SMC EURUSD v4",
    shorttitle        = "SMC-v4",
    overlay           = true,
    default_qty_type  = strategy.fixed,
    default_qty_value = 1,
    initial_capital   = 100000,
    currency          = currency.USD,
    commission_type   = strategy.commission.cash_per_contract,
    commission_value  = 0.00005,
    slippage          = 2,
    pyramiding        = 0,
    max_bars_back     = 500)

// =============================================================
// INPUTS
// =============================================================

// Everything about a session — its time window, whether its box shows, its
// label, and its color — lives together here, instead of the times being
// under "Kill Zones" and the box appearance under "Visuals". All hours are
// UTC+2 (matches typical broker/exchange chart time, e.g. FXCM feeds).
var string GSESS = "Market Sessions (UTC+2)"

show_session_labels = input.bool(false, "Show Session Name Labels (Asia/London/New York text)", group = GSESS)

show_asia_box = input.bool(true,  "Asia",   group = GSESS, inline = "asia1")
asia_box_txt  = input.string("Asia", "Label", group = GSESS, inline = "asia1")
asia_box_col  = input.color(color.red, "Color", group = GSESS, inline = "asia1")
kz_asia_open  = input.int(0, "Open (h)",  0, 23, group = GSESS, inline = "asia2")
kz_asia_close = input.int(8, "Close (h)", 0, 23, group = GSESS, inline = "asia2")

show_lon_box = input.bool(true,  "London", group = GSESS, inline = "lon1")
lon_box_txt  = input.string("London", "Label", group = GSESS, inline = "lon1")
lon_box_col  = input.color(color.green, "Color", group = GSESS, inline = "lon1")
kz_lon_open  = input.int(9,  "Open (h)",  0, 23, group = GSESS, inline = "lon2")
kz_lon_close = input.int(11, "Close (h)", 0, 23, group = GSESS, inline = "lon2")

show_ny_box   = input.bool(true,  "New York", group = GSESS, inline = "ny1")
ny_box_txt    = input.string("New York", "Label", group = GSESS, inline = "ny1")
ny_box_col    = input.color(color.blue, "Color", group = GSESS, inline = "ny1")
kz_ny_open    = input.int(14, "Open (h)",    0, 23, group = GSESS, inline = "ny2")
kz_ny_close_h = input.int(16, "Close (h)",   0, 23, group = GSESS, inline = "ny2")
kz_ny_close_m = input.int(30, "Close (min)", 0, 59, group = GSESS, inline = "ny2")

sess_box_max = input.int(10, "Max Boxes per Session (oldest dropped)", 2, 30, group = GSESS)

var string GLIQ = "Liquidity Levels (HTF POIs)"
use_pdhl  = input.bool(true,    "PDH / PDL (Previous Day)",  group = GLIQ)
use_pwhl  = input.bool(true,    "PWH / PWL (Previous Week)", group = GLIQ)
use_asia  = input.bool(true,    "Asia Range H/L",            group = GLIQ)
sw_len    = input.int(10,       "Swing Lookback (MSS ref)",  2, 50, group = GLIQ)
sweep_buf = input.float(0.0002, "Sweep Buffer", 0.00005, 0.001, 0.00001, group = GLIQ)
sweep_win = input.int(12,       "Sweep Window (bars to reject back through level)", 1, 100, group = GLIQ)

var string GMSS = "MSS Settings"
mss_max_bars = input.int(80, "Max Bars for MSS", 5, 300, group = GMSS)

var string GFVG = "FVG / Imbalance"
fvg_min_gap   = input.float(0.0002, "Min FVG Gap",  0.00005, 0.002, 0.00001, group = GFVG)
fvg_max_bars  = input.int(60,       "FVG Max Age",  5, 300,          group = GFVG)
fvg_search_bars = input.int(8,      "Bars after MSS to find entry FVG", 1, 50, group = GFVG)
req_close_fvg = input.bool(true,    "Entry candle must CLOSE inside FVG", group = GFVG)
req_engulf    = input.bool(false,   "Entry candle must be ENGULFING (body covers prev body) — very restrictive", group = GFVG)
fvg_tf_min    = input.int(1,   "Show Chart Imbalances: Min Timeframe (minutes)", 1, 1440, group = GFVG)
fvg_tf_max    = input.int(5,   "Show Chart Imbalances: Max Timeframe (minutes)", 1, 1440, group = GFVG)

var string GHTF = "HTF Context Filter"
use_htf     = input.bool(false, "Require HTF FVG alignment (at least one active TF) — heavy filter", group = GHTF)
use_htf_1h  = input.bool(true,  "1H FVG zones",      group = GHTF)
use_htf_4h  = input.bool(true,  "4H FVG zones",      group = GHTF)
use_htf_d   = input.bool(true,  "Daily FVG zones",   group = GHTF)
use_htf_w   = input.bool(true,  "Weekly FVG zones",  group = GHTF)
use_htf_m   = input.bool(false, "Monthly FVG zones", group = GHTF)
htf_fvg_min = input.float(0.0003, "Min HTF FVG Size", 0.00010, 0.010, 0.00010, group = GHTF)

var string GRSK = "Risk Management"
rr_ratio   = input.float(2.0,    "RR Ratio",         1.0, 10.0, 0.1,    group = GRSK)
max_sl     = input.float(0.0050, "Max SL Distance",  0.0005, 0.0200, 0.0001, group = GRSK)
min_sl     = input.float(0.0003, "Min SL Distance",  0.0001, 0.0020, 0.0001, group = GRSK)
max_day_tr = input.int(4,        "Max Trades / Day (overall ceiling)", 1, 10,   group = GRSK)
sess_max_trades = input.int(2,   "Max Trades per Session (London/NY only)", 1, 5, group = GRSK)
cap_sl_to_max = input.bool(true, "Cap SL at Max Distance instead of skipping trade", group = GRSK)
fixed_cap  = input.float(100000, "Fixed Capital (non-compounded)",       group = GRSK)

var string GTR = "Tiered Risk (% of Fixed Capital)"
r1 = input.float(0.7, "Attempt 1 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r2 = input.float(0.8, "Attempt 2 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r3 = input.float(1.2, "Attempt 3 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r4 = input.float(1.5, "Attempt 4 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r5 = input.float(1.8, "Attempt 5 (%)", 0.1, 5.0, 0.1, group = GTR) / 100
r6 = input.float(2.0, "Attempt 6 (%)", 0.1, 5.0, 0.1, group = GTR) / 100

var string GEQL = "Equal Highs / Lows (Liquidity Pools)"
use_eql      = input.bool(true,    "Detect and show EQH / EQL",        group = GEQL)
eql_tol      = input.float(0.0003, "Tolerance (price)",  0.00005, 0.002, 0.00001, group = GEQL)
eql_lookback = input.int(5,        "History depth (# pivots)", 2, 20,   group = GEQL)

// Simplified on purpose: short labels here, full explanation in the tooltip
// (hover the ⓘ) instead of long inline text.
var string GVIS = "Visuals"

show_levels  = input.bool(true, "POI Lines",   group = GVIS, inline = "show1")
show_fvg_vis = input.bool(true, "Imbalances",  group = GVIS, inline = "show1")
show_sweep   = input.bool(true, "Sweep Marks", group = GVIS, inline = "show2")
show_checklist = input.bool(true, "Setup Checklist", group = GVIS, inline = "show2")
show_info_tbl  = input.bool(false, "Info Table",  group = GVIS, inline = "show3")
show_stats_tbl = input.bool(false, "Stats Table", group = GVIS, inline = "show3")

poi_line_col    = input.color(color.white, "POI Line Color", group = GVIS,
     tooltip = "One flat color for every POI line (PDH/PDL, PWH/PWL, Asia, EQH/EQL) — always solid, straight. The active swept level still turns green while its trade cycle is live.")
imb_line_col    = input.color(color.white, "Imbalance Color", group = GVIS, inline = "imbcol",
     tooltip = "One flat color for every imbalance line (HTF and chart-native). The line uses the transparency below; its label text is always fully solid.")
imb_line_transp = input.int(10, "Transp %", 0, 90, group = GVIS, inline = "imbcol")

max_poi_pct = input.float(0.40, "Max POI Distance (%)", 0.05, 5.0, 0.05, group = GVIS,
     tooltip = "Hide a POI line once price is farther than this % away. Auto x2 on futures.")
imb_max_pct = input.float(1.00, "Max Imbalance Distance (%)", 0.10, 5.0, 0.10, group = GVIS,
     tooltip = "Same idea for imbalances, same rule on every timeframe. Auto x2 on futures.")
merge_tol   = input.float(0.0005, "Zone Merge Tolerance", 0.00010, 0.005, 0.00010, group = GVIS,
     tooltip = "Zones within this price distance of each other collapse into one line, names joined with \"+\".")

var string GALR = "Proximity Alerts"
use_near_alert       = input.bool(true, "Alert when price nears a POI zone", group = GALR)
near_alert_pct       = input.float(0.20, "Create Alert at Distance (% of price) — forex baseline; auto x2 on futures", 0.02, 2.0, 0.01, group = GALR)
near_alert_reset_pct = input.float(1.00, "Remove Alert Beyond Distance (% of price)", 0.10, 5.0, 0.10, group = GALR)

// Scale the visible distance down on lower chart timeframes (e.g. 1m) so wide
// HTF boxes (Weekly/Monthly) don't force the visible price range to stretch and
// shrink the candles. At 1H+ the full % applies; below that it shrinks toward
// a 15% floor as the chart timeframe gets smaller.
tf_sec       = timeframe.in_seconds(timeframe.period)
tf_scale     = math.min(1.0, math.max(0.15, tf_sec / 3600.0))
poi_pct_eff  = (syminfo.type == "futures" ? max_poi_pct * 2.0 : max_poi_pct) * tf_scale
max_poi_dist = close * poi_pct_eff / 100.0

near_pct_eff       = syminfo.type == "futures" ? near_alert_pct * 2.0 : near_alert_pct
near_dist          = close * near_pct_eff / 100.0
near_reset_pct_eff = syminfo.type == "futures" ? near_alert_reset_pct * 2.0 : near_alert_reset_pct
near_reset_dist    = close * near_reset_pct_eff / 100.0

// Imbalances (FVG) use ONE flat distance rule on every timeframe and every
// chart TF — 1% of price by default. Earlier versions gave D/W/M a wider or
// unlimited leash and skipped the filter entirely on Daily/Weekly/Monthly
// charts; both caused a flood of unmitigated imbalances to stay visible when
// zooming out. Now it's simple: farther than imb_dist away → hidden, period.
imb_pct_eff = syminfo.type == "futures" ? imb_max_pct * 2.0 : imb_max_pct
imb_dist    = close * imb_pct_eff / 100.0

// Formats a timeframe.period string ("1","5","60","240","D","W","M") into a
// short human label ("1m","5m","1H","4H","D","W","MN") for imbalance labels.
f_tf_label(string tf) =>
    string lbl = tf
    if tf == "D"
        lbl := "D"
    else if tf == "W"
        lbl := "W"
    else if tf == "M"
        lbl := "MN"
    else
        mins = str.tonumber(tf)
        if not na(mins)
            lbl := mins >= 60 and mins % 60 == 0 ? str.tostring(mins / 60) + "H" : str.tostring(mins) + "m"
    lbl

chart_tf_lbl = f_tf_label(timeframe.period)

// Lets the user restrict generic chart-native imbalances to a chosen
// timeframe range (e.g. only 1m-5m, skip 15m) instead of an all-or-nothing
// toggle tied to whatever the chart happens to be showing.
chart_tf_minutes = timeframe.in_seconds(timeframe.period) / 60.0
fvg_tf_ok         = chart_tf_minutes >= fvg_tf_min and chart_tf_minutes <= fvg_tf_max

// NOTE ON VIEWPORT-BASED HIDING (removed): an earlier version hid zones
// outside the visible price range using chart.left_visible_bar_time /
// chart.right_visible_bar_time. That's the ONLY way Pine can know anything
// about the visible range at all, but referencing those variables forces a
// full script recalculation on every pan/zoom/timeframe change — there is
// no incremental update. That's what caused everything to disappear and
// take a few seconds to redraw when scrolling or resizing the chart. Since
// that trade-off wasn't worth it, visibility now goes back to depending
// only on price distance (max_poi_dist / imb_dist below), which updates
// smoothly every bar with no extra recalculation cost.

// =============================================================
// HTF BIAS  (no-repainting)
// =============================================================

// Use completed bars [3] and [1] so FVGs never flicker on the incomplete current bar
[h1_h2, h1_l2, h1_h0, h1_l0] = request.security(syminfo.tickerid, "60",  [high[3], low[3], high[1], low[1]], lookahead = barmerge.lookahead_off)
[h2_h2, h2_l2, h2_h0, h2_l0] = request.security(syminfo.tickerid, "240", [high[3], low[3], high[1], low[1]], lookahead = barmerge.lookahead_off)
[h3_h2, h3_l2, h3_h0, h3_l0] = request.security(syminfo.tickerid, "D",   [high[3], low[3], high[1], low[1]], lookahead = barmerge.lookahead_off)
[hw_h2, hw_l2, hw_h0, hw_l0] = request.security(syminfo.tickerid, "W",   [high[3], low[3], high[1], low[1]], lookahead = barmerge.lookahead_off)
[hm_h2, hm_l2, hm_h0, hm_l0] = request.security(syminfo.tickerid, "M",   [high[3], low[3], high[1], low[1]], lookahead = barmerge.lookahead_off)

htf_bear_1h = h1_l2 > h1_h0 and (h1_l2 - h1_h0) >= htf_fvg_min
htf_bear_4h = h2_l2 > h2_h0 and (h2_l2 - h2_h0) >= htf_fvg_min
htf_bear_d  = h3_l2 > h3_h0 and (h3_l2 - h3_h0) >= htf_fvg_min
htf_bear_w  = hw_l2 > hw_h0 and (hw_l2 - hw_h0) >= htf_fvg_min
htf_bear_m  = hm_l2 > hm_h0 and (hm_l2 - hm_h0) >= htf_fvg_min

htf_bull_1h = h1_h2 < h1_l0 and (h1_l0 - h1_h2) >= htf_fvg_min
htf_bull_4h = h2_h2 < h2_l0 and (h2_l0 - h2_h2) >= htf_fvg_min
htf_bull_d  = h3_h2 < h3_l0 and (h3_l0 - h3_h2) >= htf_fvg_min
htf_bull_w  = hw_h2 < hw_l0 and (hw_l0 - hw_h2) >= htf_fvg_min
htf_bull_m  = hm_h2 < hm_l0 and (hm_l0 - hm_h2) >= htf_fvg_min

// ROOT CAUSE #2. The previous sticky version compared price against h1_h0
// (and friends) to decide "has this gap been mitigated?". But h1_h0 is
// high[1] ON THE HIGHER TIMEFRAME — i.e. "the previous 1H candle's high",
// which SLIDES FORWARD every single hour. So the mitigation test was
// measuring current price against a constantly-moving reference that tracks
// price itself, rather than against the fixed edge of the gap that actually
// formed. Result: the flag was knocked back to false almost immediately and
// htf_bear/htf_bull were false nearly always — and since htf_ok_bear/bull
// gate any_hs/any_ls, that alone suppressed the vast majority of sweeps.
// The same sliding value also drove the on-chart HTF zone lines, which is
// why those lines appeared to sit at different prices on different
// timeframes.
//
// Fix: FREEZE the gap's edges into var floats the moment the gap forms, and
// test mitigation against that frozen edge. A zone re-arms only when a
// genuinely different gap forms (near edge changes while the pattern holds).
f_htf_edge(bool gap_now, float near_now, float far_now, bool is_supply, float edge_in, float far_in, bool ok_in) =>
    float e = edge_in
    float f = far_in
    bool  k = ok_in
    if gap_now and (na(e) or near_now != e)
        e := near_now
        f := far_now
        k := true
    if k and not na(e)
        if is_supply ? high >= e : low <= e
            k := false
    [e, f, k]

var float htf_b1h_edge = na
var float htf_b1h_far  = na
var bool  htf_bear_1h_ok = false
var float htf_b4h_edge = na
var float htf_b4h_far  = na
var bool  htf_bear_4h_ok = false
var float htf_bd_edge  = na
var float htf_bd_far   = na
var bool  htf_bear_d_ok  = false
var float htf_bw_edge  = na
var float htf_bw_far   = na
var bool  htf_bear_w_ok  = false
var float htf_bm_edge  = na
var float htf_bm_far   = na
var bool  htf_bear_m_ok  = false

var float htf_u1h_edge = na
var float htf_u1h_far  = na
var bool  htf_bull_1h_ok = false
var float htf_u4h_edge = na
var float htf_u4h_far  = na
var bool  htf_bull_4h_ok = false
var float htf_ud_edge  = na
var float htf_ud_far   = na
var bool  htf_bull_d_ok  = false
var float htf_uw_edge  = na
var float htf_uw_far   = na
var bool  htf_bull_w_ok  = false
var float htf_um_edge  = na
var float htf_um_far   = na
var bool  htf_bull_m_ok  = false

[e_b1h, f_b1h, k_b1h] = f_htf_edge(htf_bear_1h, h1_h0, h1_l2, true, htf_b1h_edge, htf_b1h_far, htf_bear_1h_ok)
htf_b1h_edge := e_b1h
htf_b1h_far  := f_b1h
htf_bear_1h_ok := k_b1h
[e_b4h, f_b4h, k_b4h] = f_htf_edge(htf_bear_4h, h2_h0, h2_l2, true, htf_b4h_edge, htf_b4h_far, htf_bear_4h_ok)
htf_b4h_edge := e_b4h
htf_b4h_far  := f_b4h
htf_bear_4h_ok := k_b4h
[e_bd, f_bd, k_bd] = f_htf_edge(htf_bear_d, h3_h0, h3_l2, true, htf_bd_edge, htf_bd_far, htf_bear_d_ok)
htf_bd_edge := e_bd
htf_bd_far  := f_bd
htf_bear_d_ok := k_bd
[e_bw, f_bw, k_bw] = f_htf_edge(htf_bear_w, hw_h0, hw_l2, true, htf_bw_edge, htf_bw_far, htf_bear_w_ok)
htf_bw_edge := e_bw
htf_bw_far  := f_bw
htf_bear_w_ok := k_bw
[e_bm, f_bm, k_bm] = f_htf_edge(htf_bear_m, hm_h0, hm_l2, true, htf_bm_edge, htf_bm_far, htf_bear_m_ok)
htf_bm_edge := e_bm
htf_bm_far  := f_bm
htf_bear_m_ok := k_bm

[e_u1h, f_u1h, k_u1h] = f_htf_edge(htf_bull_1h, h1_l0, h1_h2, false, htf_u1h_edge, htf_u1h_far, htf_bull_1h_ok)
htf_u1h_edge := e_u1h
htf_u1h_far  := f_u1h
htf_bull_1h_ok := k_u1h
[e_u4h, f_u4h, k_u4h] = f_htf_edge(htf_bull_4h, h2_l0, h2_h2, false, htf_u4h_edge, htf_u4h_far, htf_bull_4h_ok)
htf_u4h_edge := e_u4h
htf_u4h_far  := f_u4h
htf_bull_4h_ok := k_u4h
[e_ud, f_ud, k_ud] = f_htf_edge(htf_bull_d, h3_l0, h3_h2, false, htf_ud_edge, htf_ud_far, htf_bull_d_ok)
htf_ud_edge := e_ud
htf_ud_far  := f_ud
htf_bull_d_ok := k_ud
[e_uw, f_uw, k_uw] = f_htf_edge(htf_bull_w, hw_l0, hw_h2, false, htf_uw_edge, htf_uw_far, htf_bull_w_ok)
htf_uw_edge := e_uw
htf_uw_far  := f_uw
htf_bull_w_ok := k_uw
[e_um, f_um, k_um] = f_htf_edge(htf_bull_m, hm_l0, hm_h2, false, htf_um_edge, htf_um_far, htf_bull_m_ok)
htf_um_edge := e_um
htf_um_far  := f_um
htf_bull_m_ok := k_um

htf_bear = (use_htf_1h and htf_bear_1h_ok) or (use_htf_4h and htf_bear_4h_ok) or (use_htf_d and htf_bear_d_ok) or (use_htf_w and htf_bear_w_ok) or (use_htf_m and htf_bear_m_ok)
htf_bull = (use_htf_1h and htf_bull_1h_ok) or (use_htf_4h and htf_bull_4h_ok) or (use_htf_d and htf_bull_d_ok) or (use_htf_w and htf_bull_w_ok) or (use_htf_m and htf_bull_m_ok)

// =============================================================
// SESSION / KILL ZONE
// =============================================================

// Kept the h_utc/m_utc names to avoid touching every call site, but these
// are now UTC+2 hours/minutes (matches the Market Sessions inputs above).
h_utc = hour(time, "UTC+2")
m_utc = minute(time, "UTC+2")

ny_closed = h_utc > kz_ny_close_h or (h_utc == kz_ny_close_h and m_utc >= kz_ny_close_m)
in_london = h_utc >= kz_lon_open and h_utc < kz_lon_close
in_ny     = h_utc >= kz_ny_open and not ny_closed
in_kz     = in_london or in_ny

// Increments once at the start of every London/NY session — used to tell
// "swept this session" (still show, frozen at the liquidation point) from
// "swept in an earlier session" (fully remove) for the 8 structural POI
// lines below.
var int session_id = 0
if (in_london and not in_london[1]) or (in_ny and not in_ny[1])
    session_id += 1

eql_tf_ok = timeframe.in_seconds() >= 900

// Running high/low while each kill zone session is in progress, so the
// session can be drawn as a box (its actual traded range) instead of a
// flat background strip.
var float lon_live_h = na
var float lon_live_l = na
var float ny_live_h  = na
var float ny_live_l  = na

if in_london
    lon_live_h := na(lon_live_h) ? high : math.max(lon_live_h, high)
    lon_live_l := na(lon_live_l) ? low  : math.min(lon_live_l, low)
else
    lon_live_h := na
    lon_live_l := na

if in_ny
    ny_live_h := na(ny_live_h) ? high : math.max(ny_live_h, high)
    ny_live_l := na(ny_live_l) ? low  : math.min(ny_live_l, low)
else
    ny_live_h := na
    ny_live_l := na

// =============================================================
// DAILY + PER-SESSION TRADE COUNTERS
// =============================================================

var int trades_today = 0
var int last_day_id  = 0

day_id = year(time) * 10000 + month(time) * 100 + dayofmonth(time)
if day_id != last_day_id
    trades_today := 0
    last_day_id  := day_id

// can_trade: used for SWEEP DETECTION only (state-machine engaging, lines
// turning green, checklist appearing) — deliberately session-agnostic so a
// sweep outside London/NY still gets tracked instead of silently vanishing.
can_trade = trades_today < max_day_tr and strategy.position_size == 0

// Trading only actually happens in London/NY, capped independently per
// session (sess_max_trades each, default 2) — this is the hard rule the
// user asked for. Counters reset the moment each session starts.
var int lon_session_trades = 0
var int ny_session_trades  = 0

if in_london and not in_london[1]
    lon_session_trades := 0
if in_ny and not in_ny[1]
    ny_session_trades := 0

can_trade_entry = can_trade and ((in_london and lon_session_trades < sess_max_trades) or (in_ny and ny_session_trades < sess_max_trades))

// =============================================================
// PREVIOUS DAY HIGH / LOW
// =============================================================

is_new_day = ta.change(time("D")) != 0

var float cur_dh     = na
var float cur_dl     = na
var int   cur_dh_bar = na
var int   cur_dl_bar = na
var float pdh        = na
var float pdl        = na
var int   pdh_bar     = na
var int   pdl_bar     = na

if is_new_day
    pdh        := cur_dh
    pdl        := cur_dl
    pdh_bar    := cur_dh_bar
    pdl_bar    := cur_dl_bar
    cur_dh     := high
    cur_dl     := low
    cur_dh_bar := time
    cur_dl_bar := time
else
    if na(cur_dh) or high > cur_dh
        cur_dh     := high
        cur_dh_bar := time
    if na(cur_dl) or low < cur_dl
        cur_dl     := low
        cur_dl_bar := time

// =============================================================
// PREVIOUS WEEK HIGH / LOW
// =============================================================

is_new_week = ta.change(time("W")) != 0

var float cur_wh     = na
var float cur_wl     = na
var int   cur_wh_bar = na
var int   cur_wl_bar = na
var float pwh        = na
var float pwl        = na
var int   pwh_bar     = na
var int   pwl_bar     = na

if is_new_week
    pwh        := cur_wh
    pwl        := cur_wl
    pwh_bar    := cur_wh_bar
    pwl_bar    := cur_wl_bar
    cur_wh     := high
    cur_wl     := low
    cur_wh_bar := time
    cur_wl_bar := time
else
    if na(cur_wh) or high > cur_wh
        cur_wh     := high
        cur_wh_bar := time
    if na(cur_wl) or low < cur_wl
        cur_wl     := low
        cur_wl_bar := time

// =============================================================
// ASIA RANGE  (default 00:00 - 08:00 UTC+2, see kz_asia_open/close above)
// =============================================================

// Handles both an overnight session (e.g. 22h-7h, wraps past midnight) and
// a same-day session (e.g. 1h-6h) depending on which input is larger.
in_asia = kz_asia_open <= kz_asia_close ? (h_utc >= kz_asia_open and h_utc < kz_asia_close) : (h_utc >= kz_asia_open or h_utc < kz_asia_close)

var float asia_live_h     = na
var float asia_live_l     = na
var int   asia_live_h_bar = na
var int   asia_live_l_bar = na
var float asia_h          = na
var float asia_l          = na
var int   asia_h_bar      = na
var int   asia_l_bar      = na

if in_asia
    if na(asia_live_h) or high > asia_live_h
        asia_live_h     := high
        asia_live_h_bar := time
    if na(asia_live_l) or low < asia_live_l
        asia_live_l     := low
        asia_live_l_bar := time
else if in_asia[1]
    asia_h          := asia_live_h
    asia_l          := asia_live_l
    asia_h_bar      := asia_live_h_bar
    asia_l_bar      := asia_live_l_bar
    asia_live_h     := na
    asia_live_l     := na
    asia_live_h_bar := na
    asia_live_l_bar := na

asia_closed = not in_asia and in_asia[1]

// =============================================================
// SWING HIGHS / LOWS
// =============================================================

raw_swh = ta.pivothigh(high, sw_len, sw_len)
raw_swl = ta.pivotlow(low,  sw_len, sw_len)

var float last_swh = na
var float last_swl = na

if not na(raw_swh)
    last_swh := raw_swh
if not na(raw_swl)
    last_swl := raw_swl

// =============================================================
// EQUAL HIGHS / LOWS
// =============================================================

var float[] swh_hist = array.new_float(0)
var float[] swl_hist = array.new_float(0)
var float   last_eqh = na
var float   last_eql = na
var int     last_eqh_bar = na
var int     last_eql_bar = na

eqh_new = false
eql_new = false

// ta.pivothigh/pivotlow(src, sw_len, sw_len) confirms the pivot sw_len bars
// after it printed, so the actual pivot bar is bar_index - sw_len.
if use_eql and eql_tf_ok and not na(raw_swh)
    sz = array.size(swh_hist)
    if sz > 0
        for i = 0 to sz - 1
            if math.abs(raw_swh - array.get(swh_hist, i)) <= eql_tol
                eqh_new      := true
                last_eqh     := raw_swh
                last_eqh_bar := time[sw_len]
                break
    if array.size(swh_hist) >= eql_lookback
        array.shift(swh_hist)
    array.push(swh_hist, raw_swh)

if use_eql and eql_tf_ok and not na(raw_swl)
    sz = array.size(swl_hist)
    if sz > 0
        for i = 0 to sz - 1
            if math.abs(raw_swl - array.get(swl_hist, i)) <= eql_tol
                eql_new      := true
                last_eql     := raw_swl
                last_eql_bar := time[sw_len]
                break
    if array.size(swl_hist) >= eql_lookback
        array.shift(swl_hist)
    array.push(swl_hist, raw_swl)

// =============================================================
// TIERED RISK ENGINE
// =============================================================

var int attempt = 1

f_risk(int a) =>
    a == 1 ? r1 : a == 2 ? r2 : a == 3 ? r3 : a == 4 ? r4 : a == 5 ? r5 : r6

was_in_trade = strategy.position_size[1] != 0 and strategy.position_size == 0
if was_in_trade
    n = strategy.closedtrades - 1
    if n >= 0
        last_profit = strategy.closedtrades.profit(n)
        attempt    := last_profit > 0 ? 1 : math.min(attempt + 1, 6)

f_qty(float sl_dist) =>
    sl_dist > 0.0 ? (fixed_cap * f_risk(attempt)) / sl_dist : 0.0

poi_in_rng(float px) =>
    not na(px) and math.abs(close - px) <= max_poi_dist

// =============================================================
// CANDLE BODY + ENGULFING
// =============================================================

is_bull = close > open
is_bear = close < open
body_hi = math.max(open, close)
body_lo = math.min(open, close)

prev_body_hi = math.max(open[1], close[1])
prev_body_lo = math.min(open[1], close[1])

bear_engulf = is_bear and body_hi > prev_body_hi and body_lo < prev_body_lo
bull_engulf = is_bull and body_hi > prev_body_hi and body_lo < prev_body_lo

// =============================================================
// STATE MACHINE
// 0 = IDLE | 1 = BEAR_SWEPT | 2 = BULL_SWEPT
// 3 = BEAR_FVG | 4 = BULL_FVG
// =============================================================

var int   state        = 0
var int   state_bar    = 0
var float sweep_hi     = na
var float sweep_lo     = na
var float mss_ref_bear = na
var float mss_ref_bull = na
var float fvg_top      = na
var float fvg_bot      = na
var int   fvg_bar      = 0
var int   mss_bar      = 0

// Which POI level triggered the current active sweep cycle (if any), so its
// own line can turn green with a check instead of just disappearing once
// swept — it stays green through the whole sweep -> MSS -> entry cycle.
var float active_sweep_px = na

var box fvg_entry_box = na

// Funnel diagnostics — where in sweep -> MSS -> FVG -> retest -> entry the
// setups are actually getting cut off. Shown in the info table so a zero-
// trade backtest is diagnosable at a glance instead of a black box.
var int cnt_sweep  = 0
var int cnt_mss    = 0
var int cnt_fvg    = 0
var int cnt_entry  = 0

// Live setup checklist — tracked per active cycle so the on-chart panel can
// show exactly which conditions still need to happen before an entry fires,
// checking each one off as soon as it's met. Reset at the start of every
// new cycle (a fresh sweep), not when it ends, so the final state stays
// visible for the checklist to render before the panel disappears.
var bool cyc_touched   = false
var bool cyc_close_ok  = false
var bool cyc_engulf_ok = false

// Phase visuals: sweep confirmed (the swept POI line itself turns green with
// a check, see f_poi_entry below) -> waiting for structure break (orange MSS
// level line) -> structure broken, entry FVG marked (below).
var line  mss_ref_line    = na
var label mss_ref_lbl     = na

// Structure-break ("CE") marker: only the CURRENT cycle's, only while the
// bot is actually hunting for an entry (state 3/4) — not a permanent
// plotshape history of every past break, per request.
var label ce_lbl = na

var bool prev_bear_1h = false
var bool prev_bull_1h = false
var bool prev_bear_4h = false
var bool prev_bull_4h = false
var bool prev_bear_d  = false
var bool prev_bull_d  = false
var bool prev_bear_w  = false
var bool prev_bull_w  = false
var bool prev_bear_m  = false
var bool prev_bull_m  = false

// ROOT CAUSE #1 of "Sweeps = 7 over years of 1m data".
// The old test demanded, ALL ON ONE CANDLE: the wick pierces the level by
// sweep_buf, the ENTIRE body closes back below the level, and the candle is
// bearish. That is one specific rejection-pin pattern. A real liquidity
// sweep almost never completes inside a single 1m candle — price pokes
// through, often hovers above for several bars, then gets pushed back. So
// virtually every genuine sweep (including the Asian high the user watched
// get taken) failed this test and the bot never even entered "hunting" mode.
//
// New definition: price traded beyond the level at some point within the
// last sweep_win bars, AND the current bar closes back on the original side.
// Edge-triggered (the "and not (prev...)" clause) so it fires once on the
// rejection instead of every bar for as long as the condition holds.
// ta.highest/ta.lowest are called unconditionally — Pine requires ta.*
// to evaluate on every bar or their internal state desyncs.
f_high_sweep(float lvl) =>
    hh = ta.highest(high, sweep_win)
    pierced_now   = not na(lvl) and hh    > lvl + sweep_buf
    rejected_now  = not na(lvl) and close < lvl
    pierced_prev  = not na(lvl) and hh[1] > lvl + sweep_buf
    rejected_prev = not na(lvl) and close[1] < lvl
    (pierced_now and rejected_now) and not (pierced_prev and rejected_prev)

f_low_sweep(float lvl) =>
    ll = ta.lowest(low, sweep_win)
    pierced_now   = not na(lvl) and ll    < lvl - sweep_buf
    rejected_now  = not na(lvl) and close > lvl
    pierced_prev  = not na(lvl) and ll[1] < lvl - sweep_buf
    rejected_prev = not na(lvl) and close[1] > lvl
    (pierced_now and rejected_now) and not (pierced_prev and rejected_prev)

hs_pdh  = use_pdhl and f_high_sweep(pdh)
hs_pwh  = use_pwhl and f_high_sweep(pwh)
hs_asia = use_asia and f_high_sweep(asia_h)
hs_eqh  = use_eql  and f_high_sweep(last_eqh)

ls_pdl  = use_pdhl and f_low_sweep(pdl)
ls_pwl  = use_pwhl and f_low_sweep(pwl)
ls_asia = use_asia and f_low_sweep(asia_l)
ls_eql  = use_eql  and f_low_sweep(last_eql)

htf_ok_bear = not use_htf or htf_bear
htf_ok_bull = not use_htf or htf_bull

// BUG FIX: in_kz used to gate sweep detection here, but the swept-state
// flags below (pdh_swept etc.) mark a level swept 24/7 regardless of kill
// zone — so a sweep outside London/NY hours (most of the day, especially
// visible on low timeframes where sweeps happen constantly) marked the
// level swept but never engaged the state machine, leaving no MSS wait, no
// green check, nothing — the line just vanished. Also silently discarded a
// large fraction of otherwise-valid setups. Kill zone timing is still
// tracked/shown (info table), just no longer a hard gate on the state
// machine engaging.
//
// Execution timeframe gate: the whole trading state machine — sweep
// recognition, MSS/CE, the FVG hunt, the checklist, entries — only ever
// engages on the 1-minute chart. Viewing this script on 1H/4H/D/M is for
// CONTEXT only (POI zones + imbalances still draw normally there); nothing
// operational should appear or fire outside the actual execution timeframe.
// Because state can then never leave 0 on a non-1m chart, this alone also
// suppresses the sweep-circle markers, CE label and checklist panel there —
// nothing extra needed at each of those call sites.
is_exec_tf = timeframe.period == "1"

any_hs = (hs_pdh or hs_pwh or hs_asia or hs_eqh) and htf_ok_bear and can_trade and is_exec_tf
any_ls = (ls_pdl or ls_pwl or ls_asia or ls_eql)  and htf_ok_bull and can_trade and is_exec_tf

if state == 0 and any_hs
    state        := 1
    sweep_hi     := high
    // Structure reference = a trailing low, seeded at the sweep candle's own
    // low and pulled down each bar that DOESN'T break it (see the trailing
    // update below the MSS check). This is "the low of the pullback since
    // the sweep" — the last bearish structure point before the reaction —
    // not a distant swing pivot from sw_len bars back, which could sit far
    // away or on the wrong side of price and made MSS unreachable.
    mss_ref_bear := low
    state_bar    := bar_index
    cnt_sweep    += 1
    cyc_touched   := false
    cyc_close_ok  := false
    cyc_engulf_ok := false
    // BUG FIX: fvg_top/fvg_bot were never cleared between cycles, so a brand
    // new cycle could inherit the PREVIOUS cycle's gap coordinates (a
    // completely different price level) until it happened to find its own
    // new gap. That stale zone could keep the FVG search running on the
    // wrong timeout (fvg_max_bars instead of fvg_search_bars, since the
    // na(fvg_top) check that picks between them was fooled by the leftover
    // value) with a box still anchored 2-3 bars wide at the old price — a
    // thin, absurdly tall box that renders as a vertical line. Clearing
    // both here, at the start of every fresh cycle, closes that off.
    fvg_top := na
    fvg_bot := na
    box.delete(fvg_entry_box)
    fvg_entry_box := na
    active_sweep_px := hs_pdh ? pdh : hs_pwh ? pwh : hs_asia ? asia_h : last_eqh
    // Phase 1: zone liquidated (its own line turns green with a check via
    // f_poi_entry), then show the level price must break through to confirm
    // a bearish structure shift.
    line.delete(mss_ref_line)
    label.delete(mss_ref_lbl)
    mss_ref_line := line.new(bar_index, mss_ref_bear, bar_index + 1, mss_ref_bear, extend = extend.right, color = color.orange, style = line.style_dashed, width = 2)
    mss_ref_lbl  := label.new(bar_index, mss_ref_bear, "Ruptura p/ CE Bajista", style = label.style_none, textcolor = color.orange, size = size.normal)

if state == 0 and any_ls
    state        := 2
    sweep_lo     := low
    mss_ref_bull := high
    state_bar    := bar_index
    cnt_sweep    += 1
    cyc_touched   := false
    cyc_close_ok  := false
    cyc_engulf_ok := false
    fvg_top := na
    fvg_bot := na
    box.delete(fvg_entry_box)
    fvg_entry_box := na
    active_sweep_px := ls_pdl ? pdl : ls_pwl ? pwl : ls_asia ? asia_l : last_eql
    line.delete(mss_ref_line)
    label.delete(mss_ref_lbl)
    mss_ref_line := line.new(bar_index, mss_ref_bull, bar_index + 1, mss_ref_bull, extend = extend.right, color = color.orange, style = line.style_dashed, width = 2)
    mss_ref_lbl  := label.new(bar_index, mss_ref_bull, "Ruptura p/ CE Alcista", style = label.style_none, textcolor = color.orange, size = size.normal)

if (state == 1 or state == 2) and (bar_index - state_bar) > mss_max_bars
    state := 0
    active_sweep_px := na
    label.delete(ce_lbl)
    ce_lbl := na
    line.delete(mss_ref_line)
    label.delete(mss_ref_lbl)
    mss_ref_line    := na
    mss_ref_lbl     := na

// Checked BEFORE the trailing reference is extended with this bar's own
// low/high, so "close breaks the structure formed so far" and "today's low
// becomes the new structure point" can never both be true on the same bar.
bear_mss = state == 1 and not na(mss_ref_bear) and close < mss_ref_bear
bull_mss = state == 2 and not na(mss_ref_bull) and close > mss_ref_bull

if state == 1 and not bear_mss
    mss_ref_bear := math.min(mss_ref_bear, low)
    if not na(mss_ref_line)
        line.set_y1(mss_ref_line, mss_ref_bear)
        line.set_y2(mss_ref_line, mss_ref_bear)
        label.set_y(mss_ref_lbl, mss_ref_bear)
if state == 2 and not bull_mss
    mss_ref_bull := math.max(mss_ref_bull, high)
    if not na(mss_ref_line)
        line.set_y1(mss_ref_line, mss_ref_bull)
        line.set_y2(mss_ref_line, mss_ref_bull)
        label.set_y(mss_ref_lbl, mss_ref_bull)

if bear_mss
    mss_bar      := bar_index
    state        := 3
    state_bar    := bar_index
    cnt_mss      += 1
    // Structure confirmed broken: the MSS-level line is done, the operative
    // phase now shows the entry FVG instead (below). The swept POI line
    // stays green (active_sweep_px is only cleared once state returns to 0).
    line.delete(mss_ref_line)
    label.delete(mss_ref_lbl)
    mss_ref_line    := na
    mss_ref_lbl     := na
    label.delete(ce_lbl)
    ce_lbl := label.new(bar_index, high, "CE", style = label.style_label_down, color = color.orange, textcolor = color.black, size = size.small)

if bull_mss
    mss_bar      := bar_index
    state        := 4
    state_bar    := bar_index
    cnt_mss      += 1
    line.delete(mss_ref_line)
    label.delete(mss_ref_lbl)
    mss_ref_line    := na
    mss_ref_lbl     := na
    label.delete(ce_lbl)
    ce_lbl := label.new(bar_index, low, "CE", style = label.style_label_up, color = color.orange, textcolor = color.black, size = size.small)

// ROOT CAUSE #3 + "closest imbalance" rule. The old code checked
// mss_bear_ok[1] — exactly one bar after the structure break — and gave up
// entirely if that single bar left no 3-candle gap (impulses usually run
// several bars; the gap can appear on the 2nd-4th bar, not just the 1st).
// That was the MSS=4 -> FVG=2 attrition.
//
// It also locked onto the FIRST gap found. But as the impulse continues,
// each new gap forms progressively CLOSER to where price currently is — so
// "the imbalance closest to current price" (the user's rule when several
// form) is whichever one is MOST RECENT, not the first. So this now keeps
// overwriting fvg_top/fvg_bot with the latest qualifying gap on every bar,
// for as long as price hasn't already retraced back into the current one —
// once it has, that's the retest, and the zone freezes for the entry logic
// below to evaluate.
if state == 3 and bar_index > mss_bar
    already_in_current = not na(fvg_top) and high >= fvg_bot and low <= fvg_top
    if not already_in_current
        bear_gap = low[2] - high
        // Sanity ceiling: a genuine data anomaly (weekend gap, bad tick) can
        // otherwise produce a "gap" many times wider than any real trade
        // setup, creating a box that renders as a near-vertical spike.
        if bear_gap >= fvg_min_gap and bear_gap <= max_sl * 5
            if na(fvg_top)
                cnt_fvg += 1
            fvg_top := low[2]
            fvg_bot := high
            fvg_bar := bar_index
            box.delete(fvg_entry_box)
            fvg_entry_box := box.new(bar_index - 2, fvg_top, bar_index + 1, fvg_bot,
                 border_color = color.new(color.red, 10),
                 bgcolor      = color.new(color.red, 80),
                 text         = "ENTRY FVG (Bear)",
                 text_color   = color.new(color.red, 20),
                 text_size    = size.small,
                 text_halign  = text.align_left,
                 text_valign  = text.align_top)
    if na(fvg_top) and (bar_index - mss_bar) >= fvg_search_bars
        state := 0
        active_sweep_px := na
        label.delete(ce_lbl)
        ce_lbl := na
    else if not na(fvg_top) and (bar_index - mss_bar) > fvg_max_bars
        box.delete(fvg_entry_box)
        state := 0
        active_sweep_px := na
        label.delete(ce_lbl)
        ce_lbl := na

if state == 4 and bar_index > mss_bar
    already_in_current = not na(fvg_top) and low <= fvg_top and high >= fvg_bot
    if not already_in_current
        bull_gap = low - high[2]
        if bull_gap >= fvg_min_gap and bull_gap <= max_sl * 5
            if na(fvg_top)
                cnt_fvg += 1
            fvg_top := low
            fvg_bot := high[2]
            fvg_bar := bar_index
            box.delete(fvg_entry_box)
            fvg_entry_box := box.new(bar_index - 2, fvg_top, bar_index + 1, fvg_bot,
                 border_color = color.new(color.teal, 10),
                 bgcolor      = color.new(color.teal, 80),
                 text         = "ENTRY FVG (Bull)",
                 text_color   = color.new(color.teal, 20),
                 text_size    = size.small,
                 text_halign  = text.align_left,
                 text_valign  = text.align_top)
    if na(fvg_top) and (bar_index - mss_bar) >= fvg_search_bars
        state := 0
        active_sweep_px := na
        label.delete(ce_lbl)
        ce_lbl := na
    else if not na(fvg_top) and (bar_index - mss_bar) > fvg_max_bars
        box.delete(fvg_entry_box)
        state := 0
        active_sweep_px := na
        label.delete(ce_lbl)
        ce_lbl := na

if (state == 3 or state == 4) and not na(fvg_entry_box)
    box.set_right(fvg_entry_box, bar_index + 5)

// =============================================================
// ENTRY CONDITIONS
// =============================================================

in_bear_fvg = state == 3 and not na(fvg_top) and not na(fvg_bot)
in_bull_fvg = state == 4 and not na(fvg_top) and not na(fvg_bot)

touched_bear = in_bear_fvg and high >= fvg_bot and low <= fvg_top
touched_bull = in_bull_fvg and low  <= fvg_top and high >= fvg_bot

close_ok_bear  = req_close_fvg ? (close >= fvg_bot and close <= fvg_top and is_bear) : is_bear
close_ok_bull  = req_close_fvg ? (close >= fvg_bot and close <= fvg_top and is_bull) : is_bull
engulf_ok_bear = not req_engulf or bear_engulf
engulf_ok_bull = not req_engulf or bull_engulf

// can_trade_entry (not the bare can_trade) — actual order placement is
// restricted to London/NY sessions, session-capped, on top of the daily cap
// and being flat. Sweep tracking above stays session-agnostic on purpose.
short_signal = touched_bear and close_ok_bear and engulf_ok_bear and can_trade_entry
long_signal  = touched_bull and close_ok_bull  and engulf_ok_bull and can_trade_entry

// Checklist progress for the current cycle — "ever true so far this cycle",
// not "true on this exact bar" (entry still needs all three aligned on the
// same bar; this is a progress readout, not a substitute for short/long_signal).
if touched_bear or touched_bull
    cyc_touched := true
if (touched_bear and close_ok_bear) or (touched_bull and close_ok_bull)
    cyc_close_ok := true
if (touched_bear and engulf_ok_bear) or (touched_bull and engulf_ok_bull)
    cyc_engulf_ok := true

// =============================================================
// ORDER EXECUTION
// =============================================================

// ROOT CAUSE #4 (FVG=2 -> Entries=0). SL is placed at the sweep wick. By the
// time a setup completes — sweep, then an impulse leg breaking structure,
// then a retrace back into the gap — the distance from entry back up to that
// wick is frequently well beyond max_sl (50 pips). The old code treated that
// as "reject the trade entirely", silently discarding otherwise-valid
// signals and never reaching strategy.entry at all. It also plotted the
// SHORT/LONG marker from short_signal/long_signal alone, so the chart could
// show an entry arrow even on a bar where the trade was actually rejected —
// exactly the "marker but nothing in the Strategy Tester" the user saw.
//
// Now sl/tp/qty are computed unconditionally (na-safe) so a single validated
// boolean (short_valid/long_valid) gates BOTH the plotted marker below and
// the actual order here — they can never disagree. When the structural stop
// is too wide it's CAPPED at max_sl instead of dropping the trade
// (cap_sl_to_max, on by default); risk per trade stays bounded either way
// since size is derived from the real stop distance.
sl_struct_s = sweep_hi + sweep_buf
sl_price_s  = cap_sl_to_max ? math.min(sl_struct_s, close + max_sl) : sl_struct_s
sl_dist_s   = sl_price_s - close
tp_price_s  = close - (sl_price_s - close) * rr_ratio
qty_s       = f_qty(sl_dist_s)
short_valid = short_signal and sl_dist_s >= min_sl and sl_dist_s <= max_sl and qty_s > 0

sl_struct_l = sweep_lo - sweep_buf
sl_price_l  = cap_sl_to_max ? math.max(sl_struct_l, close - max_sl) : sl_struct_l
sl_dist_l   = close - sl_price_l
tp_price_l  = close + (close - sl_price_l) * rr_ratio
qty_l       = f_qty(sl_dist_l)
long_valid  = long_signal and sl_dist_l >= min_sl and sl_dist_l <= max_sl and qty_l > 0

if short_valid
    strategy.entry("Short", strategy.short, qty = qty_s, comment = "SMC Short")
    strategy.exit("SX", from_entry = "Short", stop = sl_price_s, limit = tp_price_s)
    trades_today += 1
    cnt_entry    += 1
    if in_london
        lon_session_trades += 1
    if in_ny
        ny_session_trades += 1
    state := 0
    active_sweep_px := na
    label.delete(ce_lbl)
    ce_lbl := na
    if not na(fvg_entry_box)
        box.set_right(fvg_entry_box, bar_index)

if long_valid
    strategy.entry("Long", strategy.long, qty = qty_l, comment = "SMC Long")
    strategy.exit("LX", from_entry = "Long", stop = sl_price_l, limit = tp_price_l)
    trades_today += 1
    cnt_entry    += 1
    if in_london
        lon_session_trades += 1
    if in_ny
        ny_session_trades += 1
    state := 0
    active_sweep_px := na
    label.delete(ce_lbl)
    ce_lbl := na
    if not na(fvg_entry_box)
        box.set_right(fvg_entry_box, bar_index)

// =============================================================
// VISUALS — session range boxes (Asia/London/NY), instead of a flat
// full-height background strip: a box bounding the session's actual
// traded high/low, growing live while the session is in progress and
// freezing once it ends. Oldest boxes drop off past sess_box_max so
// history doesn't accumulate forever.
// =============================================================

f_session_box(bool in_session, bool prev_in_session, float sess_h, float sess_l, color line_col, color fill_col, string txt, box[] arr) =>
    if in_session and not prev_in_session
        nb = box.new(bar_index, sess_h, bar_index, sess_l, border_color = line_col, bgcolor = fill_col, border_style = line.style_dotted, text = txt, text_color = line_col, text_size = size.small, text_halign = text.align_center, text_valign = text.align_top)
        array.push(arr, nb)
        if array.size(arr) > sess_box_max
            box.delete(array.shift(arr))
    if in_session and array.size(arr) > 0
        last_box = array.get(arr, array.size(arr) - 1)
        box.set_top(last_box, sess_h)
        box.set_bottom(last_box, sess_l)
        box.set_right(last_box, bar_index)

var box[] asia_boxes = array.new<box>(0)
var box[] lon_boxes  = array.new<box>(0)
var box[] ny_boxes   = array.new<box>(0)

// Boxes only by default — the name text is opt-in (show_session_labels).
asia_lbl_txt = show_session_labels ? asia_box_txt : ""
lon_lbl_txt  = show_session_labels ? lon_box_txt  : ""
ny_lbl_txt   = show_session_labels ? ny_box_txt   : ""

if show_asia_box
    f_session_box(in_asia,   in_asia[1],   asia_live_h, asia_live_l, color.new(asia_box_col, 40), color.new(asia_box_col, 90), asia_lbl_txt, asia_boxes)
if show_lon_box
    f_session_box(in_london, in_london[1], lon_live_h,  lon_live_l,  color.new(lon_box_col,  40), color.new(lon_box_col,  90), lon_lbl_txt,  lon_boxes)
if show_ny_box
    f_session_box(in_ny,     in_ny[1],     ny_live_h,   ny_live_l,   color.new(ny_box_col,   30), color.new(ny_box_col,   90), ny_lbl_txt,   ny_boxes)

// =============================================================
// POI LINE MANAGER — rebuilt every bar with merge logic
// =============================================================

var line[]  managed_poi_lines  = array.new<line>(0)
var label[] managed_poi_labels = array.new<label>(0)

var bool pdh_swept    = false
var bool pdl_swept    = false
var bool pwh_swept    = false
var bool pwl_swept    = false
var bool asia_h_swept = false
var bool asia_l_swept = false
var bool eqh_swept    = false
var bool eql_swept    = false

// Liquidation time + the session it happened in. A level swept THIS session
// stays visible, frozen at the point it was hit (not extending to "now");
// once the session changes, it's gone — see f_poi_entry below.
var int pdh_swept_t = na
var int pdh_swept_s = na
var int pdl_swept_t = na
var int pdl_swept_s = na
var int pwh_swept_t = na
var int pwh_swept_s = na
var int pwl_swept_t = na
var int pwl_swept_s = na
var int asia_h_swept_t = na
var int asia_h_swept_s = na
var int asia_l_swept_t = na
var int asia_l_swept_s = na
var int eqh_swept_t = na
var int eqh_swept_s = na
var int eql_swept_t = na
var int eql_swept_s = na

if is_new_day
    pdh_swept := false
    pdl_swept := false
if is_new_week
    pwh_swept := false
    pwl_swept := false
if asia_closed
    asia_h_swept := false
    asia_l_swept := false
if eqh_new
    eqh_swept := false
if eql_new
    eql_swept := false

if not na(pdh) and not pdh_swept and high >= pdh
    pdh_swept := true
    pdh_swept_t := time
    pdh_swept_s := session_id
if not na(pdl) and not pdl_swept and low <= pdl
    pdl_swept := true
    pdl_swept_t := time
    pdl_swept_s := session_id
if not na(pwh) and not pwh_swept and high >= pwh
    pwh_swept := true
    pwh_swept_t := time
    pwh_swept_s := session_id
if not na(pwl) and not pwl_swept and low <= pwl
    pwl_swept := true
    pwl_swept_t := time
    pwl_swept_s := session_id
if not na(asia_h) and not asia_h_swept and high >= asia_h
    asia_h_swept := true
    asia_h_swept_t := time
    asia_h_swept_s := session_id
if not na(asia_l) and not asia_l_swept and low <= asia_l
    asia_l_swept := true
    asia_l_swept_t := time
    asia_l_swept_s := session_id
if not na(last_eqh) and not eqh_swept and high >= last_eqh
    eqh_swept := true
    eqh_swept_t := time
    eqh_swept_s := session_id
if not na(last_eql) and not eql_swept and low <= last_eql
    eql_swept := true
    eql_swept_t := time
    eql_swept_s := session_id

// =============================================================
// PROXIMITY ALERTS — hysteresis armed/disarmed per zone:
//   - "armed" zone whose distance drops to <= near_dist (0.2%) fires
//     once and disarms, so it doesn't re-fire every bar while price
//     lingers close.
//   - it only re-arms once price moves away beyond near_reset_dist
//     (1%), so a small wiggle around the 0.2% line can't spam alerts.
//   - also re-arms whenever the underlying level itself refreshes
//     (new day/week/Asia session/EQH-EQL) since that's effectively a
//     brand new zone.
// =============================================================

f_near(float px) =>
    not na(px) and math.abs(close - px) <= near_dist

f_far(float px) =>
    na(px) or math.abs(close - px) > near_reset_dist

var bool pdh_armed   = true
var bool pdl_armed   = true
var bool pwh_armed   = true
var bool pwl_armed   = true
var bool asiah_armed = true
var bool asial_armed = true
var bool eqh_armed   = true
var bool eql_armed   = true

if is_new_day
    pdh_armed   := true
    pdl_armed   := true
if is_new_week
    pwh_armed   := true
    pwl_armed   := true
if asia_closed
    asiah_armed := true
    asial_armed := true
if eqh_new
    eqh_armed   := true
if eql_new
    eql_armed   := true

pdh_cond   = use_near_alert and use_pdhl and not pdh_swept    and f_near(pdh)
pdl_cond   = use_near_alert and use_pdhl and not pdl_swept    and f_near(pdl)
pwh_cond   = use_near_alert and use_pwhl and not pwh_swept    and f_near(pwh)
pwl_cond   = use_near_alert and use_pwhl and not pwl_swept    and f_near(pwl)
asiah_cond = use_near_alert and use_asia and not asia_h_swept and f_near(asia_h)
asial_cond = use_near_alert and use_asia and not asia_l_swept and f_near(asia_l)
eqh_cond   = use_near_alert and use_eql  and eql_tf_ok and not eqh_swept and f_near(last_eqh)
eql_cond   = use_near_alert and use_eql  and eql_tf_ok and not eql_swept and f_near(last_eql)

pdh_near_alert   = pdh_armed   and pdh_cond
pdl_near_alert   = pdl_armed   and pdl_cond
pwh_near_alert   = pwh_armed   and pwh_cond
pwl_near_alert   = pwl_armed   and pwl_cond
asiah_near_alert = asiah_armed and asiah_cond
asial_near_alert = asial_armed and asial_cond
eqh_near_alert   = eqh_armed   and eqh_cond
eql_near_alert   = eql_armed   and eql_cond

if pdh_near_alert
    pdh_armed   := false
if pdl_near_alert
    pdl_armed   := false
if pwh_near_alert
    pwh_armed   := false
if pwl_near_alert
    pwl_armed   := false
if asiah_near_alert
    asiah_armed := false
if asial_near_alert
    asial_armed := false
if eqh_near_alert
    eqh_armed   := false
if eql_near_alert
    eql_armed   := false

if f_far(pdh)
    pdh_armed   := true
if f_far(pdl)
    pdl_armed   := true
if f_far(pwh)
    pwh_armed   := true
if f_far(pwl)
    pwl_armed   := true
if f_far(asia_h)
    asiah_armed := true
if f_far(asia_l)
    asial_armed := true
if f_far(last_eqh)
    eqh_armed   := true
if f_far(last_eql)
    eql_armed   := true

if pdh_near_alert
    alert("Price approaching PDH (Previous Day High) - " + str.tostring(pdh, "#.#####"), alert.freq_once_per_bar)
if pdl_near_alert
    alert("Price approaching PDL (Previous Day Low) - " + str.tostring(pdl, "#.#####"), alert.freq_once_per_bar)
if pwh_near_alert
    alert("Price approaching PWH (Previous Week High) - " + str.tostring(pwh, "#.#####"), alert.freq_once_per_bar)
if pwl_near_alert
    alert("Price approaching PWL (Previous Week Low) - " + str.tostring(pwl, "#.#####"), alert.freq_once_per_bar)
if asiah_near_alert
    alert("Price approaching Asia Range High - " + str.tostring(asia_h, "#.#####"), alert.freq_once_per_bar)
if asial_near_alert
    alert("Price approaching Asia Range Low - " + str.tostring(asia_l, "#.#####"), alert.freq_once_per_bar)
if eqh_near_alert
    alert("Price approaching Equal Highs liquidity pool - " + str.tostring(last_eqh, "#.#####"), alert.freq_once_per_bar)
if eql_near_alert
    alert("Price approaching Equal Lows liquidity pool - " + str.tostring(last_eql, "#.#####"), alert.freq_once_per_bar)

// =============================================================
// FVG / IMBALANCE STATE — tracked here (before the POI arrays are
// built below) so every imbalance can be pushed into the SAME merge
// system as PDH/PDL/Asia/EQH-EQL: if a zone lands within merge_tol of
// another, they collapse into one line whose label lists every name.
// =============================================================

f_imb_in_rng(float px) =>
    not na(px) and math.abs(close - px) <= imb_dist

new_bear_1h  = htf_bear_1h and not prev_bear_1h
gone_bear_1h = not htf_bear_1h and prev_bear_1h
new_bull_1h  = htf_bull_1h and not prev_bull_1h
gone_bull_1h = not htf_bull_1h and prev_bull_1h
new_bear_4h  = htf_bear_4h and not prev_bear_4h
gone_bear_4h = not htf_bear_4h and prev_bear_4h
new_bull_4h  = htf_bull_4h and not prev_bull_4h
gone_bull_4h = not htf_bull_4h and prev_bull_4h
new_bear_d   = htf_bear_d  and not prev_bear_d
gone_bear_d  = not htf_bear_d  and prev_bear_d
new_bull_d   = htf_bull_d  and not prev_bull_d
gone_bull_d  = not htf_bull_d  and prev_bull_d
new_bear_w   = htf_bear_w  and not prev_bear_w
gone_bear_w  = not htf_bear_w  and prev_bear_w
new_bull_w   = htf_bull_w  and not prev_bull_w
gone_bull_w  = not htf_bull_w  and prev_bull_w
new_bear_m   = htf_bear_m  and not prev_bear_m
gone_bear_m  = not htf_bear_m  and prev_bear_m
new_bull_m   = htf_bull_m  and not prev_bull_m
gone_bull_m  = not htf_bull_m  and prev_bull_m

prev_bear_1h := htf_bear_1h
prev_bull_1h := htf_bull_1h
prev_bear_4h := htf_bear_4h
prev_bull_4h := htf_bull_4h
prev_bear_d  := htf_bear_d
prev_bull_d  := htf_bull_d
prev_bear_w  := htf_bear_w
prev_bull_w  := htf_bull_w
prev_bear_m  := htf_bear_m
prev_bull_m  := htf_bull_m

// Near-edge price of each HTF zone, taken from the FROZEN edge captured when
// the gap formed (see f_htf_edge above) rather than the sliding raw HTF
// value. Using the raw value here is what made the same zone render at
// different prices depending on the chart timeframe.
htf_b1h_px = htf_b1h_edge
htf_u1h_px = htf_u1h_edge
htf_b4h_px = htf_b4h_edge
htf_u4h_px = htf_u4h_edge
htf_bd_px  = htf_bd_edge
htf_ud_px  = htf_ud_edge
htf_bw_px  = htf_bw_edge
htf_uw_px  = htf_uw_edge
htf_bm_px  = htf_bm_edge
htf_um_px  = htf_um_edge

// Mitigation is now tracked by the *_ok flags in the HTF BIAS section, which
// test against the FROZEN gap edge (the old *_mit booleans here tested
// against the sliding raw HTF value and have been removed as dead code).
// Only the origin bar is still tracked here, so a merged line anchors at the
// bar the zone first appeared rather than at "now".
var int htf_b1h_org = na
var int htf_u1h_org = na
var int htf_b4h_org = na
var int htf_u4h_org = na
var int htf_bd_org  = na
var int htf_ud_org  = na
var int htf_bw_org  = na
var int htf_uw_org  = na
var int htf_bm_org  = na
var int htf_um_org  = na

if new_bear_1h
    htf_b1h_org := time
if new_bull_1h
    htf_u1h_org := time
if new_bear_4h
    htf_b4h_org := time
if new_bull_4h
    htf_u4h_org := time
if new_bear_d
    htf_bd_org := time
if new_bull_d
    htf_ud_org := time
if new_bear_w
    htf_bw_org := time
if new_bull_w
    htf_uw_org := time
if new_bear_m
    htf_bm_org := time
if new_bull_m
    htf_um_org := time

// --- Proximity alerts for the 10 dedicated HTF FVG zones ---
// Same hysteresis armed/disarmed idea as the 8 structural POI alerts above:
// fires once on approach, re-arms once price moves back beyond
// near_reset_dist, and also re-arms on a fresh new-edge (a new imbalance
// instance even if it reuses the same zone slot).
f_zone_alert(bool cond_near, bool cond_far, bool new_edge, bool armed_in) =>
    bool armed = armed_in
    if new_edge
        armed := true
    fire = false
    if cond_near and armed
        fire  := true
        armed := false
    if cond_far
        armed := true
    [armed, fire]

var bool htf_b1h_armed = true
var bool htf_u1h_armed = true
var bool htf_b4h_armed = true
var bool htf_u4h_armed = true
var bool htf_bd_armed  = true
var bool htf_ud_armed  = true
var bool htf_bw_armed  = true
var bool htf_uw_armed  = true
var bool htf_bm_armed  = true
var bool htf_um_armed  = true

[tmp_b1h_armed, fire_b1h] = f_zone_alert(use_near_alert and htf_bear_1h_ok and f_near(htf_b1h_px), f_far(htf_b1h_px), new_bear_1h, htf_b1h_armed)
htf_b1h_armed := tmp_b1h_armed
[tmp_u1h_armed, fire_u1h] = f_zone_alert(use_near_alert and htf_bull_1h_ok and f_near(htf_u1h_px), f_far(htf_u1h_px), new_bull_1h, htf_u1h_armed)
htf_u1h_armed := tmp_u1h_armed
[tmp_b4h_armed, fire_b4h] = f_zone_alert(use_near_alert and htf_bear_4h_ok and f_near(htf_b4h_px), f_far(htf_b4h_px), new_bear_4h, htf_b4h_armed)
htf_b4h_armed := tmp_b4h_armed
[tmp_u4h_armed, fire_u4h] = f_zone_alert(use_near_alert and htf_bull_4h_ok and f_near(htf_u4h_px), f_far(htf_u4h_px), new_bull_4h, htf_u4h_armed)
htf_u4h_armed := tmp_u4h_armed
[tmp_bd_armed, fire_bd] = f_zone_alert(use_near_alert and htf_bear_d_ok and f_near(htf_bd_px), f_far(htf_bd_px), new_bear_d, htf_bd_armed)
htf_bd_armed := tmp_bd_armed
[tmp_ud_armed, fire_ud] = f_zone_alert(use_near_alert and htf_bull_d_ok and f_near(htf_ud_px), f_far(htf_ud_px), new_bull_d, htf_ud_armed)
htf_ud_armed := tmp_ud_armed
[tmp_bw_armed, fire_bw] = f_zone_alert(use_near_alert and htf_bear_w_ok and f_near(htf_bw_px), f_far(htf_bw_px), new_bear_w, htf_bw_armed)
htf_bw_armed := tmp_bw_armed
[tmp_uw_armed, fire_uw] = f_zone_alert(use_near_alert and htf_bull_w_ok and f_near(htf_uw_px), f_far(htf_uw_px), new_bull_w, htf_uw_armed)
htf_uw_armed := tmp_uw_armed
[tmp_bm_armed, fire_bm] = f_zone_alert(use_near_alert and htf_bear_m_ok and f_near(htf_bm_px), f_far(htf_bm_px), new_bear_m, htf_bm_armed)
htf_bm_armed := tmp_bm_armed
[tmp_um_armed, fire_um] = f_zone_alert(use_near_alert and htf_bull_m_ok and f_near(htf_um_px), f_far(htf_um_px), new_bull_m, htf_um_armed)
htf_um_armed := tmp_um_armed

if fire_b1h
    alert("Price approaching 1H FVG Bear - " + str.tostring(htf_b1h_px, "#.#####"), alert.freq_once_per_bar)
if fire_u1h
    alert("Price approaching 1H FVG Bull - " + str.tostring(htf_u1h_px, "#.#####"), alert.freq_once_per_bar)
if fire_b4h
    alert("Price approaching 4H FVG Bear - " + str.tostring(htf_b4h_px, "#.#####"), alert.freq_once_per_bar)
if fire_u4h
    alert("Price approaching 4H FVG Bull - " + str.tostring(htf_u4h_px, "#.#####"), alert.freq_once_per_bar)
if fire_bd
    alert("Price approaching D FVG Bear - " + str.tostring(htf_bd_px, "#.#####"), alert.freq_once_per_bar)
if fire_ud
    alert("Price approaching D FVG Bull - " + str.tostring(htf_ud_px, "#.#####"), alert.freq_once_per_bar)
if fire_bw
    alert("Price approaching W FVG Bear - " + str.tostring(htf_bw_px, "#.#####"), alert.freq_once_per_bar)
if fire_uw
    alert("Price approaching W FVG Bull - " + str.tostring(htf_uw_px, "#.#####"), alert.freq_once_per_bar)
if fire_bm
    alert("Price approaching MN FVG Bear - " + str.tostring(htf_bm_px, "#.#####"), alert.freq_once_per_bar)
if fire_um
    alert("Price approaching MN FVG Bull - " + str.tostring(htf_um_px, "#.#####"), alert.freq_once_per_bar)

// Generic chart-native imbalances: many can be concurrently active (unlike
// the dedicated HTF zones, which track one bear + one bull gap per TF), so
// they're kept as a running list of [price, origin bar] pairs. Mitigation
// (not distance) is the only removal criterion — a gap that's temporarily
// out of range still exists and reappears in the merge render once price
// comes back within imb_dist, instead of being forgotten.
var float[] bear_fvg_px    = array.new_float(0)
var int[]   bear_fvg_org   = array.new_int(0)
var bool[]  bear_fvg_armed = array.new_bool(0)
var float[] bull_fvg_px    = array.new_float(0)
var int[]   bull_fvg_org   = array.new_int(0)
var bool[]  bull_fvg_armed = array.new_bool(0)

if show_fvg_vis and fvg_tf_ok
    // Use fully completed bars [3] and [1] (never the still-forming bar [0])
    // so the gap size is final and doesn't flicker as the live candle forms.
    bear_vis_gap = low[3] - high[1]
    if bear_vis_gap >= fvg_min_gap
        array.push(bear_fvg_px,    high[1])
        array.push(bear_fvg_org,   time[1])
        array.push(bear_fvg_armed, true)
        if array.size(bear_fvg_px) > 20
            array.shift(bear_fvg_px)
            array.shift(bear_fvg_org)
            array.shift(bear_fvg_armed)

    bull_vis_gap = low[1] - high[3]
    if bull_vis_gap >= fvg_min_gap
        array.push(bull_fvg_px,    low[1])
        array.push(bull_fvg_org,   time[1])
        array.push(bull_fvg_armed, true)
        if array.size(bull_fvg_px) > 20
            array.shift(bull_fvg_px)
            array.shift(bull_fvg_org)
            array.shift(bull_fvg_armed)

    n_bear_fvg = array.size(bear_fvg_px)
    if n_bear_fvg > 0
        for j = 0 to n_bear_fvg - 1
            i = n_bear_fvg - 1 - j
            if high >= array.get(bear_fvg_px, i)
                array.remove(bear_fvg_px,    i)
                array.remove(bear_fvg_org,   i)
                array.remove(bear_fvg_armed, i)

    n_bull_fvg = array.size(bull_fvg_px)
    if n_bull_fvg > 0
        for j = 0 to n_bull_fvg - 1
            i = n_bull_fvg - 1 - j
            if low <= array.get(bull_fvg_px, i)
                array.remove(bull_fvg_px,    i)
                array.remove(bull_fvg_org,   i)
                array.remove(bull_fvg_armed, i)

    // Proximity alerts for each still-active generic imbalance
    if use_near_alert
        n_bear_al = array.size(bear_fvg_px)
        if n_bear_al > 0
            for k = 0 to n_bear_al - 1
                bpx = array.get(bear_fvg_px, k)
                if f_near(bpx) and array.get(bear_fvg_armed, k)
                    alert("Price approaching " + chart_tf_lbl + " FVG Bear - " + str.tostring(bpx, "#.#####"), alert.freq_once_per_bar)
                    array.set(bear_fvg_armed, k, false)
                if f_far(bpx)
                    array.set(bear_fvg_armed, k, true)
        n_bull_al = array.size(bull_fvg_px)
        if n_bull_al > 0
            for k = 0 to n_bull_al - 1
                bpx = array.get(bull_fvg_px, k)
                if f_near(bpx) and array.get(bull_fvg_armed, k)
                    alert("Price approaching " + chart_tf_lbl + " FVG Bull - " + str.tostring(bpx, "#.#####"), alert.freq_once_per_bar)
                    array.set(bull_fvg_armed, k, false)
                if f_far(bpx)
                    array.set(bull_fvg_armed, k, true)


// Delete all managed drawings from previous bar
n_ml = array.size(managed_poi_lines)
if n_ml > 0
    for i = 0 to n_ml - 1
        line.delete(array.get(managed_poi_lines, i))
array.clear(managed_poi_lines)
n_mlb = array.size(managed_poi_labels)
if n_mlb > 0
    for i = 0 to n_mlb - 1
        label.delete(array.get(managed_poi_labels, i))
array.clear(managed_poi_labels)

// A swept level that triggered the CURRENT active sweep->MSS->entry cycle
// turns green with a "✓" instead of just disappearing, and stays visible
// regardless of distance (it's part of the active setup, not just a
// passive structural level) until the cycle resets to state 0.
//
// Any OTHER swept level: if it was hit THIS session (same session_id),
// still show it, but FROZEN — the line stops at the moment it was
// liquidated instead of continuing to extend toward "now" (extend=none,
// x2 = the liquidation time). If it was hit in an earlier session, it's
// fully removed.
f_poi_entry(float lvl, bool swept, int sw_t, int sw_s, string nm) =>
    is_active = swept and lvl == active_sweep_px and state != 0
    same_sess = swept and not na(sw_s) and sw_s == session_id
    frozen    = swept and same_sess and not is_active
    show      = (poi_in_rng(lvl) and not swept) or is_active or frozen
    nm2       = is_active ? nm + " ✓" : nm
    end_t     = frozen and not na(sw_t) ? sw_t : time
    [show, nm2, is_active, frozen, end_t]

// One flat color for every POI line and one for every imbalance line — no
// more per-level palette. poi_line_col: the line itself, always solid,
// opaque. imb_line_col: the imbalance line at 10% transparency; its label
// text is always the fully-opaque version of the same color regardless of
// the line's transparency, per the "10% transparent line, 100% solid text"
// spec. Green (active sweep) still overrides both, since that's a
// functional signal, not a decorative choice.
poi_line_solid = color.new(poi_line_col, 0)
imb_line_faded = color.new(imb_line_col, imb_line_transp)
imb_text_solid = color.new(imb_line_col, 0)
active_col      = color.new(color.lime, 10)

if show_levels or show_fvg_vis
    poi_px  = array.new_float(0)
    poi_nm  = array.new_string(0)
    poi_cl  = array.new<color>(0)   // line color
    poi_tx  = array.new<color>(0)   // text color (always opaque)
    poi_pr  = array.new_int(0)
    poi_bar = array.new_int(0)
    poi_ext = array.new_bool(0)     // true = extend.right ("live"), false = frozen at poi_end
    poi_end = array.new_int(0)      // x2 (time) — "now" when live, liquidation time when frozen

    if show_levels and use_pdhl
        [show_pdh, nm_pdh, act_pdh, frz_pdh, end_pdh] = f_poi_entry(pdh, pdh_swept, pdh_swept_t, pdh_swept_s, "PDH")
        if show_pdh
            array.push(poi_px, pdh)
            array.push(poi_nm, nm_pdh)
            array.push(poi_cl, act_pdh ? active_col : poi_line_solid)
            array.push(poi_tx, act_pdh ? active_col : poi_line_solid)
            array.push(poi_pr, 10)
            array.push(poi_bar, nz(pdh_bar, time))
            array.push(poi_ext, not frz_pdh)
            array.push(poi_end, end_pdh)
        [show_pdl, nm_pdl, act_pdl, frz_pdl, end_pdl] = f_poi_entry(pdl, pdl_swept, pdl_swept_t, pdl_swept_s, "PDL")
        if show_pdl
            array.push(poi_px, pdl)
            array.push(poi_nm, nm_pdl)
            array.push(poi_cl, act_pdl ? active_col : poi_line_solid)
            array.push(poi_tx, act_pdl ? active_col : poi_line_solid)
            array.push(poi_pr, 11)
            array.push(poi_bar, nz(pdl_bar, time))
            array.push(poi_ext, not frz_pdl)
            array.push(poi_end, end_pdl)
    if show_levels and use_pwhl
        [show_pwh, nm_pwh, act_pwh, frz_pwh, end_pwh] = f_poi_entry(pwh, pwh_swept, pwh_swept_t, pwh_swept_s, "PWH")
        if show_pwh
            array.push(poi_px, pwh)
            array.push(poi_nm, nm_pwh)
            array.push(poi_cl, act_pwh ? active_col : poi_line_solid)
            array.push(poi_tx, act_pwh ? active_col : poi_line_solid)
            array.push(poi_pr, 20)
            array.push(poi_bar, nz(pwh_bar, time))
            array.push(poi_ext, not frz_pwh)
            array.push(poi_end, end_pwh)
        [show_pwl, nm_pwl, act_pwl, frz_pwl, end_pwl] = f_poi_entry(pwl, pwl_swept, pwl_swept_t, pwl_swept_s, "PWL")
        if show_pwl
            array.push(poi_px, pwl)
            array.push(poi_nm, nm_pwl)
            array.push(poi_cl, act_pwl ? active_col : poi_line_solid)
            array.push(poi_tx, act_pwl ? active_col : poi_line_solid)
            array.push(poi_pr, 21)
            array.push(poi_bar, nz(pwl_bar, time))
            array.push(poi_ext, not frz_pwl)
            array.push(poi_end, end_pwl)
    if show_levels and use_asia
        [show_ah, nm_ah, act_ah, frz_ah, end_ah] = f_poi_entry(asia_h, asia_h_swept, asia_h_swept_t, asia_h_swept_s, "Asia H")
        if show_ah
            array.push(poi_px, asia_h)
            array.push(poi_nm, nm_ah)
            array.push(poi_cl, act_ah ? active_col : poi_line_solid)
            array.push(poi_tx, act_ah ? active_col : poi_line_solid)
            array.push(poi_pr, 30)
            array.push(poi_bar, nz(asia_h_bar, time))
            array.push(poi_ext, not frz_ah)
            array.push(poi_end, end_ah)
        [show_al, nm_al, act_al, frz_al, end_al] = f_poi_entry(asia_l, asia_l_swept, asia_l_swept_t, asia_l_swept_s, "Asia L")
        if show_al
            array.push(poi_px, asia_l)
            array.push(poi_nm, nm_al)
            array.push(poi_cl, act_al ? active_col : poi_line_solid)
            array.push(poi_tx, act_al ? active_col : poi_line_solid)
            array.push(poi_pr, 31)
            array.push(poi_bar, nz(asia_l_bar, time))
            array.push(poi_ext, not frz_al)
            array.push(poi_end, end_al)
    if show_levels and use_eql and eql_tf_ok
        [show_eqh, nm_eqh, act_eqh, frz_eqh, end_eqh] = f_poi_entry(last_eqh, eqh_swept, eqh_swept_t, eqh_swept_s, "EQH")
        if show_eqh
            array.push(poi_px, last_eqh)
            array.push(poi_nm, nm_eqh)
            array.push(poi_cl, act_eqh ? active_col : poi_line_solid)
            array.push(poi_tx, act_eqh ? active_col : poi_line_solid)
            array.push(poi_pr, 40)
            array.push(poi_bar, nz(last_eqh_bar, time))
            array.push(poi_ext, not frz_eqh)
            array.push(poi_end, end_eqh)
        [show_eql, nm_eql, act_eql, frz_eql, end_eql] = f_poi_entry(last_eql, eql_swept, eql_swept_t, eql_swept_s, "EQL")
        if show_eql
            array.push(poi_px, last_eql)
            array.push(poi_nm, nm_eql)
            array.push(poi_cl, act_eql ? active_col : poi_line_solid)
            array.push(poi_tx, act_eql ? active_col : poi_line_solid)
            array.push(poi_pr, 41)
            array.push(poi_bar, nz(last_eql_bar, time))
            array.push(poi_ext, not frz_eql)
            array.push(poi_end, end_eql)

    // --- HTF FVG imbalance zones (1H..MN), same merge system as POI levels ---
    if show_levels and use_htf_1h
        if htf_bear_1h_ok and f_imb_in_rng(htf_b1h_px)
            array.push(poi_px, htf_b1h_px)
            array.push(poi_nm, "1H FVG Bear")
            array.push(poi_cl, imb_line_faded)
            array.push(poi_tx, imb_text_solid)
            array.push(poi_pr, 58)
            array.push(poi_bar, nz(htf_b1h_org, time))
            array.push(poi_ext, true)
            array.push(poi_end, time)
        if htf_bull_1h_ok and f_imb_in_rng(htf_u1h_px)
            array.push(poi_px, htf_u1h_px)
            array.push(poi_nm, "1H FVG Bull")
            array.push(poi_cl, imb_line_faded)
            array.push(poi_tx, imb_text_solid)
            array.push(poi_pr, 59)
            array.push(poi_bar, nz(htf_u1h_org, time))
            array.push(poi_ext, true)
            array.push(poi_end, time)
    if show_levels and use_htf_4h
        if htf_bear_4h_ok and f_imb_in_rng(htf_b4h_px)
            array.push(poi_px, htf_b4h_px)
            array.push(poi_nm, "4H FVG Bear")
            array.push(poi_cl, imb_line_faded)
            array.push(poi_tx, imb_text_solid)
            array.push(poi_pr, 56)
            array.push(poi_bar, nz(htf_b4h_org, time))
            array.push(poi_ext, true)
            array.push(poi_end, time)
        if htf_bull_4h_ok and f_imb_in_rng(htf_u4h_px)
            array.push(poi_px, htf_u4h_px)
            array.push(poi_nm, "4H FVG Bull")
            array.push(poi_cl, imb_line_faded)
            array.push(poi_tx, imb_text_solid)
            array.push(poi_pr, 57)
            array.push(poi_bar, nz(htf_u4h_org, time))
            array.push(poi_ext, true)
            array.push(poi_end, time)
    if show_levels and use_htf_d
        if htf_bear_d_ok and f_imb_in_rng(htf_bd_px)
            array.push(poi_px, htf_bd_px)
            array.push(poi_nm, "D FVG Bear")
            array.push(poi_cl, imb_line_faded)
            array.push(poi_tx, imb_text_solid)
            array.push(poi_pr, 54)
            array.push(poi_bar, nz(htf_bd_org, time))
            array.push(poi_ext, true)
            array.push(poi_end, time)
        if htf_bull_d_ok and f_imb_in_rng(htf_ud_px)
            array.push(poi_px, htf_ud_px)
            array.push(poi_nm, "D FVG Bull")
            array.push(poi_cl, imb_line_faded)
            array.push(poi_tx, imb_text_solid)
            array.push(poi_pr, 55)
            array.push(poi_bar, nz(htf_ud_org, time))
            array.push(poi_ext, true)
            array.push(poi_end, time)
    if show_levels and use_htf_w
        if htf_bear_w_ok and f_imb_in_rng(htf_bw_px)
            array.push(poi_px, htf_bw_px)
            array.push(poi_nm, "W FVG Bear")
            array.push(poi_cl, imb_line_faded)
            array.push(poi_tx, imb_text_solid)
            array.push(poi_pr, 52)
            array.push(poi_bar, nz(htf_bw_org, time))
            array.push(poi_ext, true)
            array.push(poi_end, time)
        if htf_bull_w_ok and f_imb_in_rng(htf_uw_px)
            array.push(poi_px, htf_uw_px)
            array.push(poi_nm, "W FVG Bull")
            array.push(poi_cl, imb_line_faded)
            array.push(poi_tx, imb_text_solid)
            array.push(poi_pr, 53)
            array.push(poi_bar, nz(htf_uw_org, time))
            array.push(poi_ext, true)
            array.push(poi_end, time)
    if show_levels and use_htf_m
        if htf_bear_m_ok and f_imb_in_rng(htf_bm_px)
            array.push(poi_px, htf_bm_px)
            array.push(poi_nm, "MN FVG Bear")
            array.push(poi_cl, imb_line_faded)
            array.push(poi_tx, imb_text_solid)
            array.push(poi_pr, 50)
            array.push(poi_bar, nz(htf_bm_org, time))
            array.push(poi_ext, true)
            array.push(poi_end, time)
        if htf_bull_m_ok and f_imb_in_rng(htf_um_px)
            array.push(poi_px, htf_um_px)
            array.push(poi_nm, "MN FVG Bull")
            array.push(poi_cl, imb_line_faded)
            array.push(poi_tx, imb_text_solid)
            array.push(poi_pr, 51)
            array.push(poi_bar, nz(htf_um_org, time))
            array.push(poi_ext, true)
            array.push(poi_end, time)

    // --- Generic chart-native imbalances (whatever timeframe the chart is on) ---
    if show_fvg_vis
        n_bear_push = array.size(bear_fvg_px)
        if n_bear_push > 0
            for k = 0 to n_bear_push - 1
                bpx = array.get(bear_fvg_px, k)
                if f_imb_in_rng(bpx)
                    array.push(poi_px, bpx)
                    array.push(poi_nm, chart_tf_lbl + " FVG Bear")
                    array.push(poi_cl, imb_line_faded)
                    array.push(poi_tx, imb_text_solid)
                    array.push(poi_pr, 60)
                    array.push(poi_bar, array.get(bear_fvg_org, k))
                    array.push(poi_ext, true)
                    array.push(poi_end, time)
        n_bull_push = array.size(bull_fvg_px)
        if n_bull_push > 0
            for k = 0 to n_bull_push - 1
                bpx = array.get(bull_fvg_px, k)
                if f_imb_in_rng(bpx)
                    array.push(poi_px, bpx)
                    array.push(poi_nm, chart_tf_lbl + " FVG Bull")
                    array.push(poi_cl, imb_line_faded)
                    array.push(poi_tx, imb_text_solid)
                    array.push(poi_pr, 61)
                    array.push(poi_bar, array.get(bull_fvg_org, k))
                    array.push(poi_ext, true)
                    array.push(poi_end, time)

    n_poi = array.size(poi_px)
    if n_poi > 0
        sorted_idx = array.sort_indices(poi_px, order.ascending)
        used_flags = array.new_bool(n_poi, false)

        for ii = 0 to n_poi - 1
            si = array.get(sorted_idx, ii)
            if array.get(used_flags, si)
                continue
            g_px  = array.get(poi_px, si)
            g_nm  = array.get(poi_nm, si)
            g_cl  = array.get(poi_cl, si)
            g_tx  = array.get(poi_tx, si)
            g_pr  = array.get(poi_pr, si)
            g_bar = array.get(poi_bar, si)
            g_ext = array.get(poi_ext, si)
            g_end = array.get(poi_end, si)
            array.set(used_flags, si, true)

            jj = ii + 1
            while jj <= n_poi - 1
                sj  = array.get(sorted_idx, jj)
                pj  = array.get(poi_px, sj)
                if pj - g_px > merge_tol
                    break
                if not array.get(used_flags, sj)
                    prj = array.get(poi_pr, sj)
                    nmj = array.get(poi_nm, sj)
                    if prj < g_pr
                        g_nm  := nmj + " + " + g_nm
                        g_cl  := array.get(poi_cl, sj)
                        g_tx  := array.get(poi_tx, sj)
                        g_pr  := prj
                        g_bar := array.get(poi_bar, sj)
                        g_ext := array.get(poi_ext, sj)
                        g_end := array.get(poi_end, sj)
                    else
                        g_nm := g_nm + " + " + nmj
                    array.set(used_flags, sj, true)
                jj := jj + 1

            // xloc=xloc.bar_time (not bar_index): an unmitigated imbalance
            // can sit unresolved for tens of thousands of bars, and Pine's
            // bar-index x1 has a hard "too far from current bar" limit that
            // crashes the script once history gets long enough. Time-based
            // coordinates have no such limit.
            // g_ext=false (a POI swept this session) freezes the line at
            // g_end (the liquidation time) instead of extending to "now".
            // label.style_label_down places the text ABOVE the anchor point.
            new_l  = line.new(g_bar, g_px, g_end, g_px, xloc = xloc.bar_time, extend = g_ext ? extend.right : extend.none, color = g_cl, style = line.style_solid, width = 1)
            new_lb = label.new(g_end, g_px, g_nm, xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.black, 100), textcolor = g_tx, size = size.small)
            array.push(managed_poi_lines,  new_l)
            array.push(managed_poi_labels, new_lb)

// Sweep markers
plotshape(show_sweep and any_hs, title = "Sweep HIGH", style = shape.circle, location = location.abovebar, color = color.new(color.red,  0), size = size.tiny)
plotshape(show_sweep and any_ls, title = "Sweep LOW",  style = shape.circle, location = location.belowbar, color = color.new(color.teal, 0), size = size.tiny)

// Structure break ("CE") is now a managed label (ce_lbl, created above at
// the bear_mss/bull_mss transition, cleared at every cycle reset) instead
// of a plotshape — only the current cycle's break stays visible, and only
// while the bot is actively hunting for an entry, not a permanent history.

// Entry signals
// Gated by short_valid/long_valid (not the raw signal) so the marker can
// never appear on a bar where the order was actually rejected by the SL/qty
// checks — what you see on the chart is exactly what's in the Strategy Tester.
plotshape(short_valid, title = "Short Entry", style = shape.labeldown, location = location.abovebar, color = color.red,  textcolor = color.white, text = "SHORT", size = size.small)
plotshape(long_valid,  title = "Long Entry",  style = shape.labelup,   location = location.belowbar, color = color.teal, textcolor = color.white, text = "LONG",  size = size.small)

// =============================================================
// INFO TABLE  (top right)
// =============================================================

var table tbl = table.new(position.top_right, 2, 15, bgcolor = color.new(color.black, 75), border_width = 1, border_color = color.gray)

if barstate.islast and show_info_tbl
    table.cell(tbl, 0, 0, "SMC v4 EURUSD", text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.normal)
    table.cell(tbl, 1, 0, "",               text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.normal)

    st_str = switch state
        0 => "IDLE"
        1 => "SWEPT DN"
        2 => "SWEPT UP"
        3 => "FVG SHORT"
        => "FVG LONG"

    st_col = switch
        state == 0               => color.gray
        state == 1 or state == 2 => color.orange
        state == 3               => color.red
        =>                          color.teal

    table.cell(tbl, 0, 1, "State",   text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 1, st_str,    text_color = st_col,     text_size = size.small)

    rsk_pct = str.tostring(f_risk(attempt) * 100, "#.##")
    rsk_str = str.tostring(attempt) + "/6 (" + rsk_pct + "%)"
    rsk_col = switch
        attempt == 1 => color.lime
        attempt <= 3 => color.yellow
        =>              color.red

    table.cell(tbl, 0, 2, "Attempt", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 2, rsk_str,   text_color = rsk_col,    text_size = size.small)

    td_str = str.tostring(trades_today) + "/" + str.tostring(max_day_tr)
    td_col = trades_today >= max_day_tr ? color.red : color.lime
    table.cell(tbl, 0, 3, "Trades Today", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 3, td_str,         text_color = td_col,     text_size = size.small)

    kz_str = switch
        in_london => "London"
        in_ny     => "New York"
        =>            "OFF"
    kz_col = in_kz ? color.lime : color.red
    table.cell(tbl, 0, 4, "Kill Zone", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 4, kz_str,      text_color = kz_col,     text_size = size.small)

    bias_str = switch
        htf_bear and not htf_bull => "BEAR"
        htf_bull and not htf_bear => "BULL"
        =>                           "NEUTRAL"
    bias_col = switch
        htf_bear and not htf_bull => color.red
        htf_bull and not htf_bear => color.teal
        =>                           color.gray
    table.cell(tbl, 0, 5, "HTF Bias", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 5, bias_str,   text_color = bias_col,   text_size = size.small)

    pdhl_val = not na(pdh) ? str.tostring(pdh, "#.#####") + "/" + str.tostring(pdl, "#.#####") : "--"
    table.cell(tbl, 0, 6, "PDH/PDL", text_color = color.gray,  text_size = size.small)
    table.cell(tbl, 1, 6, pdhl_val,  text_color = color.orange, text_size = size.small)

    pwhl_val = not na(pwh) ? str.tostring(pwh, "#.#####") + "/" + str.tostring(pwl, "#.#####") : "--"
    table.cell(tbl, 0, 7, "PWH/PWL", text_color = color.gray,  text_size = size.small)
    table.cell(tbl, 1, 7, pwhl_val,  text_color = color.maroon, text_size = size.small)

    fvg_active = (state == 3 or state == 4) and not na(fvg_top)
    fvg_val    = fvg_active ? str.tostring(fvg_top, "#.#####") + "/" + str.tostring(fvg_bot, "#.#####") : "--"
    table.cell(tbl, 0, 8, "FVG Zone", text_color = color.gray,  text_size = size.small)
    table.cell(tbl, 1, 8, fvg_val,    text_color = color.yellow, text_size = size.small)

    // Funnel diagnostics — if a count is stuck at 0, that's exactly where
    // setups are being cut off (no sweeps = HTF bias/kill zone too strict,
    // sweeps but no MSS = mss_max_bars too short, MSS but no FVG = gap too
    // small at the break, FVG but no entry = retest never happened / too
    // strict close+engulfing requirement).
    table.cell(tbl, 0, 9,  "Sweeps",   text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 9,  str.tostring(cnt_sweep), text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 10, "MSS Confirmed", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 10, str.tostring(cnt_mss),   text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 11, "FVGs Formed", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 11, str.tostring(cnt_fvg),   text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 12, "Entries", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 12, str.tostring(cnt_entry), text_color = color.lime,  text_size = size.small)

    lon_str = str.tostring(lon_session_trades) + "/" + str.tostring(sess_max_trades)
    lon_col = lon_session_trades >= sess_max_trades ? color.red : color.lime
    table.cell(tbl, 0, 13, "London Trades", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 13, lon_str, text_color = lon_col, text_size = size.small)

    ny_str = str.tostring(ny_session_trades) + "/" + str.tostring(sess_max_trades)
    ny_col = ny_session_trades >= sess_max_trades ? color.red : color.lime
    table.cell(tbl, 0, 14, "NY Trades", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 14, ny_str, text_color = ny_col, text_size = size.small)

// =============================================================
// STATS TABLE  (top left)
// =============================================================

var table stats = table.new(position.top_left, 2, 9, bgcolor = color.new(color.black, 75), border_width = 1, border_color = color.gray)

if barstate.islast and show_stats_tbl
    n_closed = strategy.closedtrades
    n_wins   = strategy.wintrades
    n_loss   = strategy.losstrades
    win_rate = n_closed > 0 ? (n_wins / n_closed) * 100.0 : 0.0
    avg_win  = n_wins > 0  ? strategy.grossprofit / n_wins : 0.0
    avg_loss = n_loss > 0  ? math.abs(strategy.grossloss) / n_loss : 0.0
    pf       = strategy.grossloss != 0.0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0.0
    expect   = n_closed > 0 ? (win_rate / 100.0) * (avg_win / math.max(avg_loss, 0.01)) - (1.0 - win_rate / 100.0) : 0.0

    table.cell(stats, 0, 0, "STATISTICS", text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.normal)
    table.cell(stats, 1, 0, "",           text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.normal)

    table.cell(stats, 0, 1, "Trades",  text_color = color.gray,  text_size = size.small)
    table.cell(stats, 1, 1, str.tostring(n_closed) + "  " + str.tostring(n_wins) + "W/" + str.tostring(n_loss) + "L", text_color = color.white, text_size = size.small)

    wr_col = win_rate >= 50.0 ? color.lime : color.red
    table.cell(stats, 0, 2, "Win Rate",     text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 2, str.tostring(win_rate, "#.#") + "%", text_color = wr_col, text_size = size.small)

    pf_col = pf >= 1.5 ? color.lime : pf >= 1.0 ? color.yellow : color.red
    table.cell(stats, 0, 3, "Profit Factor", text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 3, str.tostring(pf, "#.##"),              text_color = pf_col,    text_size = size.small)

    net_pnl = strategy.netprofit
    pnl_col = net_pnl >= 0.0 ? color.lime : color.red
    table.cell(stats, 0, 4, "Net P&L",   text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 4, str.tostring(net_pnl, "#.##"), text_color = pnl_col, text_size = size.small)

    table.cell(stats, 0, 5, "Max DD",    text_color = color.gray,   text_size = size.small)
    table.cell(stats, 1, 5, str.tostring(strategy.max_drawdown, "#.##"), text_color = color.orange, text_size = size.small)

    table.cell(stats, 0, 6, "Avg Win",   text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 6, str.tostring(avg_win,  "#.##"), text_color = color.lime, text_size = size.small)

    table.cell(stats, 0, 7, "Avg Loss",  text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 7, str.tostring(avg_loss, "#.##"), text_color = color.red,  text_size = size.small)

    exp_col = expect >= 0.0 ? color.lime : color.red
    table.cell(stats, 0, 8, "Expectancy", text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 8, str.tostring(expect, "#.###") + "R",  text_color = exp_col, text_size = size.small)

// =============================================================
// SETUP CHECKLIST — appears the moment a zone is liquidated (state != 0)
// and disappears once the cycle resolves (entry fires or setup expires).
// Each condition checks off live as it's met, so "why hasn't it entered
// yet" is visible on the chart instead of a guessing game.
// =============================================================

var table checklist = table.new(position.bottom_right, 2, 7, bgcolor = color.new(color.black, 75), border_width = 1, border_color = color.gray)

f_chk_cell(bool done, bool applicable) =>
    txt = not applicable ? "N/D" : done ? "✓" : "⏳"
    col = not applicable ? color.gray : done ? color.lime : color.orange
    [txt, col]

if barstate.islast and show_checklist and state != 0
    dir_str = (state == 1 or state == 3) ? "BAJISTA" : "ALCISTA"
    dir_col = (state == 1 or state == 3) ? color.red : color.teal
    table.cell(checklist, 0, 0, "SETUP " + dir_str, text_color = color.white, bgcolor = color.new(dir_col, 30), text_size = size.normal)
    table.cell(checklist, 1, 0, "",                 text_color = color.white, bgcolor = color.new(dir_col, 30), text_size = size.normal)

    mss_done = state == 3 or state == 4
    fvg_done = mss_done and not na(fvg_top)

    [c1txt, c1col] = f_chk_cell(true, true)
    table.cell(checklist, 0, 1, "Zona Liquidada",      text_color = color.gray, text_size = size.small)
    table.cell(checklist, 1, 1, c1txt, text_color = c1col, text_size = size.small)

    [c2txt, c2col] = f_chk_cell(mss_done, true)
    table.cell(checklist, 0, 2, "Cambio Estructura",   text_color = color.gray, text_size = size.small)
    table.cell(checklist, 1, 2, c2txt, text_color = c2col, text_size = size.small)

    [c3txt, c3col] = f_chk_cell(fvg_done, true)
    table.cell(checklist, 0, 3, "Imbalance Formado",   text_color = color.gray, text_size = size.small)
    table.cell(checklist, 1, 3, c3txt, text_color = c3col, text_size = size.small)

    [c4txt, c4col] = f_chk_cell(cyc_touched, mss_done)
    table.cell(checklist, 0, 4, "Retest de Zona",      text_color = color.gray, text_size = size.small)
    table.cell(checklist, 1, 4, c4txt, text_color = c4col, text_size = size.small)

    [c5txt, c5col] = f_chk_cell(cyc_close_ok, mss_done and req_close_fvg)
    table.cell(checklist, 0, 5, "Cierre Confirmación", text_color = color.gray, text_size = size.small)
    table.cell(checklist, 1, 5, c5txt, text_color = c5col, text_size = size.small)

    [c6txt, c6col] = f_chk_cell(cyc_engulf_ok, mss_done and req_engulf)
    table.cell(checklist, 0, 6, "Vela Envolvente",     text_color = color.gray, text_size = size.small)
    table.cell(checklist, 1, 6, c6txt, text_color = c6col, text_size = size.small)

// =============================================================
// ALERTS
// =============================================================

alertcondition(any_hs,       title = "Sweep HIGH",         message = "Sweep HIGH - watch for bearish MSS")
alertcondition(any_ls,       title = "Sweep LOW",          message = "Sweep LOW - watch for bullish MSS")
alertcondition(bear_mss,     title = "MSS Bear Confirmed", message = "Bearish MSS confirmed - FVG active")
alertcondition(bull_mss,     title = "MSS Bull Confirmed", message = "Bullish MSS confirmed - FVG active")
alertcondition(short_valid, title = "SHORT Entry",        message = "SMC SHORT | Engulfing FVG retest | Entry: {{close}}")
alertcondition(long_valid,  title = "LONG Entry",         message = "SMC LONG  | Engulfing FVG retest | Entry: {{close}}")
alertcondition(eqh_new,      title = "EQH Formed",         message = "Equal High detected - liquidity pool above")
alertcondition(eql_new,      title = "EQL Formed",         message = "Equal Low detected - liquidity pool below")

// Proximity alerts - price approaching a POI zone (fires once on entry)
alertcondition(pdh_near_alert,   title = "Price near PDH",     message = "Price approaching PDH (Previous Day High)")
alertcondition(pdl_near_alert,   title = "Price near PDL",     message = "Price approaching PDL (Previous Day Low)")
alertcondition(pwh_near_alert,   title = "Price near PWH",     message = "Price approaching PWH (Previous Week High)")
alertcondition(pwl_near_alert,   title = "Price near PWL",     message = "Price approaching PWL (Previous Week Low)")
alertcondition(asiah_near_alert, title = "Price near Asia H",  message = "Price approaching Asia Range High")
alertcondition(asial_near_alert, title = "Price near Asia L",  message = "Price approaching Asia Range Low")
alertcondition(eqh_near_alert,   title = "Price near EQH",     message = "Price approaching Equal Highs liquidity pool")
alertcondition(eql_near_alert,   title = "Price near EQL",     message = "Price approaching Equal Lows liquidity pool")
